		</Item></Item><Item class="ServerScriptService" referent="RBX00000011"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: loads and saves each player's progress.
-- Saving in Studio needs Game Settings > Security > "Enable Studio Access to API Services".

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local store
local ok, err = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not ok then
	warn("[D2D] Saving is off: " .. tostring(err))
end

local profiles = {}

local function default()
	return {
		Cash = Config.StartingCash or 100,
		Tokens = 0,
		ShowroomLevel = 1,
		TruckLevel = 1,
		ToolLevel = 1,
		EngineLuck = 0,
		Display = {}, -- { {Id=, Engine=, Spot=} }
		Discovered = {}, -- [carId] = true
		Claimed = {}, -- [carId] = true
		Completed = {}, -- [containerIndex as string] = true
		Yard = {}, -- { {Kind="Container", Level=} or {Kind="Car", Id=} }
		DeliveriesDone = 0,
		LastOnline = 0,
		IncomeRate = 0,
	}
end

local function num(v, lo, hi, fallback)
	if type(v) ~= "number" or v ~= v then
		return fallback
	end
	return math.clamp(math.floor(v), lo, hi)
end

local function sanitize(data)
	local p = default()
	if type(data) ~= "table" then
		return p
	end
	if type(data.Cash) == "number" and data.Cash == data.Cash then
		p.Cash = math.max(0, data.Cash)
	end
	p.Tokens = num(data.Tokens, 0, 1e6, 0)
	p.ShowroomLevel = num(data.ShowroomLevel, 1, Config.MaxShowroomLevel, 1)
	p.TruckLevel = num(data.TruckLevel, 1, Config.GetMaxTruck(p.ShowroomLevel), 1)
	p.ToolLevel = num(data.ToolLevel, 1, Config.GetMaxTool(p.ShowroomLevel), 1)
	p.EngineLuck = num(data.EngineLuck, 0, Config.MaxEngineLuck, 0)
	p.DeliveriesDone = num(data.DeliveriesDone, 0, 1e9, 0)
	p.LastOnline = type(data.LastOnline) == "number" and data.LastOnline or 0
	p.IncomeRate = type(data.IncomeRate) == "number" and math.max(0, data.IncomeRate) or 0
	local maxSpots = Config.GetSpots(p.ShowroomLevel)
	if type(data.Display) == "table" then
		local used = {}
		for _, d in ipairs(data.Display) do
			if type(d) == "table" and Config.CarsById[d.Id] and type(d.Spot) == "number" then
				local spot = math.floor(d.Spot)
				if spot >= 1 and spot <= maxSpots and not used[spot] then
					used[spot] = true
					table.insert(p.Display, { Id = d.Id, Engine = num(d.Engine, 1, #Config.Engines, 1), Spot = spot })
				end
			end
		end
	end
	for _, key in ipairs({ "Discovered", "Claimed" }) do
		if type(data[key]) == "table" then
			for id, v in pairs(data[key]) do
				if v and Config.CarsById[id] then
					p[key][id] = true
				end
			end
		end
	end
	if type(data.Completed) == "table" then
		for k, v in pairs(data.Completed) do
			if v and tonumber(k) then
				p.Completed[tostring(k)] = true
			end
		end
	end
	if type(data.Yard) == "table" then
		for _, y in ipairs(data.Yard) do
			if #p.Yard >= Config.YardCapacity then
				break
			end
			if type(y) == "table" then
				if y.Kind == "Container" and type(y.Level) == "number" and Config.Containers[y.Level] then
					table.insert(p.Yard, { Kind = "Container", Level = y.Level })
				elseif y.Kind == "Car" and Config.CarsById[y.Id] then
					table.insert(p.Yard, { Kind = "Car", Id = y.Id })
				end
			end
		end
	end
	return p
end

function DataService.Load(player)
	local data
	if store then
		local success, result = pcall(function()
			return store:GetAsync("player_" .. player.UserId)
		end)
		if success then
			data = result
		else
			warn("[D2D] Load failed for " .. player.Name .. ": " .. tostring(result))
		end
	end
	local profile = sanitize(data)
	profiles[player] = profile
	return profile
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	local success, result = pcall(function()
		store:SetAsync("player_" .. player.UserId, profile)
	end)
	if not success then
		warn("[D2D] Save failed for " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.Release(player)
	profiles[player] = nil
end

return DataService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000E"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- D2D (Dust to Dealership) - main server script.
-- Truck delivers containers -> open -> wash to 100% -> roll tires -> display -> NPC customers pay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))

local rng = Random.new()

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className, name)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyEvent = remote("RemoteEvent", "Notify")
local ScrubEvent = remote("RemoteEvent", "Scrub")
local RevealEvent = remote("RemoteEvent", "Reveal")
local OpenEngineEvent = remote("RemoteEvent", "OpenEngine")
local GoHomeEvent = remote("RemoteEvent", "GoHome")
local EngineAction = remote("RemoteFunction", "EngineAction")
local ClaimToken = remote("RemoteFunction", "ClaimToken")
local YardAction = remote("RemoteEvent", "YardAction")
local OfflineEvent = remote("RemoteEvent", "Offline")

local GOLD = Color3.fromRGB(255, 220, 80)
local RED = Color3.fromRGB(255, 110, 110)
local GREEN = Color3.fromRGB(120, 255, 150)

local function notify(player, text, color)
	NotifyEvent:FireClient(player, text, color or Color3.new(1, 1, 1))
end
local function notifyAll(text, color)
	NotifyEvent:FireAllClients(text, color or Color3.new(1, 1, 1))
end
local function now()
	return workspace:GetServerTimeNow()
end

---------------------------------------------------------------------
-- Map and state
---------------------------------------------------------------------
local map = MapBuilder.Build()
local carsFolder = Instance.new("Folder")
carsFolder.Name = "Cars"
carsFolder.Parent = map.Folder
local dirtFolder = Instance.new("Folder")
dirtFolder.Name = "Dirt"
dirtFolder.Parent = map.Folder
local npcFolder = Instance.new("Folder")
npcFolder.Name = "NPCs"
npcFolder.Parent = map.Folder

local plotOwner = {} -- [plotIndex] = player
local playerPlot = {} -- [player] = plot
local state = {} -- [plotIndex] = { Spots, Yard, Wash, Lift, NPCs }
local lastScrub = {}

for i = 1, #map.Plots do
	state[i] = { Spots = {}, Yard = {}, Wash = nil, Lift = nil, NPCs = 0 }
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function getRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function rarityOf(carId)
	return Config.Rarities[Config.CarsById[carId].Rarity]
end

local function setCash(player, amount)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	profile.Cash = math.max(0, amount)
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Cash") then
		ls.Cash.Value = profile.Cash
	end
end
local function addCash(player, amount)
	local profile = DataService.Get(player)
	if profile then
		setCash(player, profile.Cash + amount)
	end
end

local function completedCount(profile)
	local n = 0
	for _ in pairs(profile.Completed) do
		n = n + 1
	end
	return n
end

local function syncAttributes(player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	player:SetAttribute("Tokens", profile.Tokens)
	player:SetAttribute("ShowroomLevel", profile.ShowroomLevel)
	player:SetAttribute("TruckLevel", profile.TruckLevel)
	player:SetAttribute("ToolLevel", profile.ToolLevel)
	player:SetAttribute("EngineLuck", profile.EngineLuck)
	player:SetAttribute("Completed", completedCount(profile))
	local d, c = {}, {}
	for id in pairs(profile.Discovered) do
		table.insert(d, id)
	end
	for id in pairs(profile.Claimed) do
		table.insert(c, id)
	end
	player:SetAttribute("Discovered", table.concat(d, ","))
	player:SetAttribute("Claimed", table.concat(c, ","))
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Cars") then
		ls.Cars.Value = #d
	end
end

-- Small world tag: a dark rounded pill with a title and an optional second line.
-- Sized in studs (shrinks with distance) and only visible up close, so the world stays clean.
local function addLabel(adornee, title, subtitle, color, offsetY, maxDist)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	local twoLines = subtitle and subtitle ~= ""
	gui.Size = UDim2.new(7, 0, twoLines and 1.9 or 1.15, 0)
	gui.StudsOffset = Vector3.new(0, offsetY or 6, 0)
	gui.MaxDistance = maxDist or 24
	gui.LightInfluence = 0
	local bg = Instance.new("Frame")
	bg.AnchorPoint = Vector2.new(0.5, 0.5)
	bg.Position = UDim2.new(0.5, 0, 0.5, 0)
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(24, 26, 34)
	bg.BackgroundTransparency = 0.25
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.3, 0)
	c.Parent = bg
	bg.Parent = gui
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.new(0.06, 0, 0.08, 0)
	t.Size = UDim2.new(0.88, 0, twoLines and 0.5 or 0.84, 0)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.Text = title
	t.Parent = bg
	local sl = Instance.new("TextLabel")
	sl.BackgroundTransparency = 1
	sl.Position = UDim2.new(0.06, 0, 0.56, 0)
	sl.Size = UDim2.new(0.88, 0, 0.36, 0)
	sl.Font = Enum.Font.GothamBold
	sl.TextScaled = true
	sl.TextColor3 = Color3.fromRGB(230, 232, 240)
	sl.Text = subtitle or ""
	sl.Visible = twoLines
	sl.Parent = bg
	gui.Parent = adornee
	return gui, t, sl
end

local function addPrompt(parentPart, action, object, hold, owner, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	if owner then
		prompt:SetAttribute("OwnerUserId", owner.UserId)
		CollectionService:AddTag(prompt, "OwnerPrompt")
	end
	prompt.Triggered:Connect(callback)
	prompt.Parent = parentPart
	return prompt
end

local function carTitle(carId)
	return Config.CarsById[carId].Name
end

local function carSubtitle(carId, engineIndex)
	local r = rarityOf(carId)
	local s = string.upper(r.Name) .. " · " .. Config.GetOddsText(carId)
	if engineIndex then
		s = s .. " · $" .. Config.FormatNumber(Config.GetCarIncome(carId, engineIndex)) .. "/s"
	end
	return s
end

---------------------------------------------------------------------
-- Showroom spots
---------------------------------------------------------------------
local function maxSpots(profile)
	return Config.GetSpots(profile.ShowroomLevel)
end

local function refreshSpotPads(plot, profile)
	local open = profile and maxSpots(profile) or 0
	for i, spot in ipairs(plot.Spots) do
		local unlocked = i <= open
		if spot.Pad then
			spot.Pad.Transparency = unlocked and 0 or 1
		end
		for _, trim in ipairs(spot.Trims or {}) do
			trim.Transparency = unlocked and 0 or 0.75
		end
	end
end

local sellSpot -- forward declaration
local applyShowroom -- forward declaration

local function showSpot(plot, spotIndex, entry)
	local owner = plotOwner[plot.Index]
	if entry.Model then
		entry.Model:Destroy()
	end
	local model = CarBuilder.BuildCar(entry.Id, { Tires = entry.Engine })
	model:PivotTo(plot.Spots[spotIndex].CFrame)
	addLabel(model.PrimaryPart, carTitle(entry.Id), "$" .. Config.FormatNumber(Config.GetCarIncome(entry.Id, entry.Engine)) .. "/s", rarityOf(entry.Id).Color, 6.5, 22)
	local value = Config.GetCarIncome(entry.Id, entry.Engine) * Config.SellSeconds
	addPrompt(model:FindFirstChild("Body"), "Sell $" .. Config.FormatNumber(value), carTitle(entry.Id), 1, owner, function(player)
		sellSpot(player, plot, spotIndex, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
end

-- (re)builds the showroom for the owner's level and puts the displayed cars back on their spots
applyShowroom = function(plot, player, profile)
	plot.BuildShowroom(profile.ShowroomLevel)
	plot.SetSign(string.upper(player.DisplayName) .. "'S " .. string.upper(Config.ShowroomNames[profile.ShowroomLevel]))
	for i, entry in pairs(state[plot.Index].Spots) do
		if plot.Spots[i] then
			showSpot(plot, i, entry)
		end
	end
	refreshSpotPads(plot, profile)
end

local function freeSpot(plot, profile)
	for i = 1, maxSpots(profile) do
		if not state[plot.Index].Spots[i] then
			return i
		end
	end
	return nil
end

sellSpot = function(player, plot, spotIndex, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Spots[spotIndex] ~= entry then
		return
	end
	state[plot.Index].Spots[spotIndex] = nil
	if entry.Model then
		entry.Model:Destroy()
	end
	local value = Config.GetCarIncome(entry.Id, entry.Engine) * Config.SellSeconds
	addCash(player, value)
	notify(player, "Sold " .. carTitle(entry.Id) .. " for $" .. Config.FormatNumber(value), GOLD)
end

---------------------------------------------------------------------
-- Discovery and the Index
---------------------------------------------------------------------
local function discover(player, carId)
	local profile = DataService.Get(player)
	local isNew = not profile.Discovered[carId]
	profile.Discovered[carId] = true
	if isNew then
		local car = Config.CarsById[carId]
		local key = tostring(car.Container)
		if not profile.Completed[key] then
			local all = true
			for _, id in ipairs(Config.Containers[car.Container].CarIds) do
				if not profile.Discovered[id] then
					all = false
					break
				end
			end
			if all then
				profile.Completed[key] = true
				profile.Tokens = profile.Tokens + Config.TokensPerCompletion
				notify(player, "Container " .. car.Container .. " COMPLETE! +5% income and +" .. Config.TokensPerCompletion .. " tokens", GOLD)
			end
		end
	end
	syncAttributes(player)
	return isNew
end

ClaimToken.OnServerInvoke = function(player, carId)
	local profile = DataService.Get(player)
	if not profile or type(carId) ~= "string" or not profile.Discovered[carId] or profile.Claimed[carId] then
		return false
	end
	profile.Claimed[carId] = true
	profile.Tokens = profile.Tokens + 1
	syncAttributes(player)
	return true
end

---------------------------------------------------------------------
-- Yard: containers and opened cars
---------------------------------------------------------------------
local spawnYardCar -- forward declaration
local sendToWash -- forward declaration

local function freeYardSlot(plot)
	for i = 1, #plot.YardSlots do
		if not state[plot.Index].Yard[i] then
			return i
		end
	end
	return nil
end

local function yardCount(plot)
	local n = 0
	for i = 1, #plot.YardSlots do
		if state[plot.Index].Yard[i] then
			n = n + 1
		end
	end
	return n
end

-- the crate shakes, glowing cracks spread, it bursts apart with a flash
local function crackOpen(model, color)
	local cf, size = model:GetBoundingBox()
	local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt:Destroy()
	end
	local label = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Label")
	if label then
		label:Destroy()
	end
	local glow = color:Lerp(Color3.new(1, 1, 1), 0.55)
	local cracks = {}
	local base = model:GetPivot()
	for step = 1, 14 do
		-- shake
		local k = step / 14
		local offset = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * (0.12 + 0.25 * k)
		model:PivotTo(base * CFrame.new(offset) * CFrame.Angles(0, rng:NextNumber(-0.04, 0.04) * (1 + k * 2), 0))
		-- a new crack on a random side every other step
		if step % 2 == 0 then
			local face = rng:NextInteger(1, 4)
			local normal = ({ Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis })[face]
			local half = size / 2
			local surface = cf.Position + cf:VectorToWorldSpace(normal * ((face <= 2) and half.X or half.Z) * 1.02)
			local c = Instance.new("Part")
			c.Name = "Crack"
			c.Anchored = true
			c.CanCollide = false
			c.CanQuery = false
			c.Material = Enum.Material.Neon
			c.Color = glow
			c.Size = Vector3.new(0.18, rng:NextNumber(1.2, 3.2), 0.18)
			c.CFrame = CFrame.lookAt(surface, surface + cf:VectorToWorldSpace(normal)) * CFrame.new(rng:NextNumber(-half.X * 0.6, half.X * 0.6), rng:NextNumber(-half.Y * 0.5, half.Y * 0.5), 0) * CFrame.Angles(0, 0, rng:NextNumber(-0.9, 0.9))
			c.Parent = model
			table.insert(cracks, c)
		end
		task.wait(0.07)
	end
	-- flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.new(1, 1, 1)
	flash.Size = Vector3.new(2, 2, 2)
	flash.CFrame = CFrame.new(cf.Position)
	flash.Parent = carsFolder
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = 4
	light.Parent = flash
	TweenService:Create(flash, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(14, 14, 14), Transparency = 1 }):Play()
	task.delay(0.5, function()
		flash:Destroy()
	end)
	-- burst into pieces that fly out and fade
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			d.Anchored = false
			d.CanCollide = true
			d.CanQuery = false
			local out = (d.Position - cf.Position)
			out = Vector3.new(out.X, 0, out.Z)
			out = out.Magnitude > 0.01 and out.Unit or Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
			d.AssemblyLinearVelocity = out * rng:NextNumber(14, 26) + Vector3.new(0, rng:NextNumber(16, 28), 0)
			d.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
			TweenService:Create(d, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		end
	end
	model.Parent = workspace
	task.delay(1.5, function()
		model:Destroy()
	end)
end

local function openContainer(player, plot, slot, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Yard[slot] ~= entry or entry.Opening then
		return
	end
	local price = Config.GetContainerPrice(entry.Level)
	local profile = DataService.Get(player)
	if price > 0 then
		if not profile or profile.Cash < price then
			notify(player, "You need $" .. Config.FormatNumber(price) .. " to open this container.", RED)
			return
		end
		setCash(player, profile.Cash - price)
	end
	entry.Opening = true
	local model = entry.Model
	crackOpen(model, Config.Containers[entry.Level].Color)
	if state[plot.Index].Yard[slot] ~= entry then
		return
	end
	state[plot.Index].Yard[slot] = nil
	local carId = Config.RollCar(entry.Level, rng)
	local isNew = discover(player, carId)
	spawnYardCar(plot, slot, carId)
	RevealEvent:FireClient(player, carId, isNew)
	local car = Config.CarsById[carId]
	if car.Rarity >= 6 then
		notifyAll(player.DisplayName .. " found a " .. string.upper(rarityOf(carId).Name) .. " car: " .. car.Name .. "!", rarityOf(carId).Color)
	end
end

-- a quick dust/sparkle burst at a point
local function puff(pos, color, count)
	local a = Instance.new("Part")
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch, a.Transparency = true, false, false, false, 1
	a.Size = Vector3.new(1, 1, 1)
	a.Position = pos
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4.5) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(6, 12)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 4
	e.LightInfluence = 0.3
	e.Enabled = false
	e.Parent = a
	a.Parent = workspace
	e:Emit(count or 12)
	Debris:AddItem(a, 1.5)
end

-- an unopened container that expired: it squashes, fades and vanishes in a puff
local function vanish(model)
	if not model or not model.Parent then
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") or d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
	local base = model:GetPivot()
	local v = Instance.new("NumberValue")
	v.Value = 0
	v.Changed:Connect(function(t)
		if model.Parent then
			-- a little hop, then shrink to nothing
			local hop = math.sin(math.min(t, 0.4) / 0.4 * math.pi) * 1.6
			model:ScaleTo(math.max(0.05, 1 - math.max(0, t - 0.3) / 0.7))
			model:PivotTo(base * CFrame.new(0, hop, 0) * CFrame.Angles(0, t * 2.5, 0))
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = 1 })
	tw:Play()
	tw.Completed:Connect(function()
		puff(base.Position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 255, 255), 16)
		v:Destroy()
		model:Destroy()
	end)
end

local function expireContainers(plot)
	local yard = state[plot.Index].Yard
	local n = 0
	for slot, entry in pairs(yard) do
		if entry.Kind == "Container" and not entry.Opening then
			yard[slot] = nil
			vanish(entry.Model)
			n = n + 1
		end
	end
	return n
end

local function spawnContainer(plot, slot, level, drop)
	local owner = plotOwner[plot.Index]
	local entry = { Kind = "Container", Level = level }
	local model = CarBuilder.BuildContainer(level)
	local target = plot.YardSlots[slot] * CFrame.Angles(0, math.rad(rng:NextNumber(-28, 28)), 0)
	model:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
	model:SetAttribute("YardSlot", slot)
	model:SetAttribute("Kind", "Container")
	model:SetAttribute("Level", level)
	model:PivotTo(drop and (target + Vector3.new(0, 40, 0)) or target)
	local price = Config.GetContainerPrice(level)
	local priceText = price > 0 and ("$" .. Config.FormatNumber(price)) or "FREE"
	model:SetAttribute("Price", price)
	local _, tl = addLabel(model.PrimaryPart, priceText, nil, Color3.fromRGB(110, 240, 120), 8.4, 30)
	tl.Parent.Parent.Size = UDim2.new(3.6, 0, 1.15, 0)
	addPrompt(model:FindFirstChild("Box"), "Open · " .. priceText, "Container " .. level, 0.6, owner, function(player)
		openContainer(player, plot, slot, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
	state[plot.Index].Yard[slot] = entry
	if drop then
		-- pops out of the truck and flies in an arc into its yard slot
		local from = plot.TruckDrop or (target + Vector3.new(0, 40, 0))
		local p0, p2 = from.Position, target.Position
		local p1 = (p0 + p2) / 2 + Vector3.new(0, 26 + (p0 - p2).Magnitude * 0.18, 0)
		local spin = rng:NextNumber(-1, 1) * math.pi * 2
		model:PivotTo(from)
		model:ScaleTo(0.4)
		local alpha = Instance.new("NumberValue")
		alpha.Changed:Connect(function(t)
			if not model.Parent then
				return
			end
			local a = (1 - t) * (1 - t) * p0 + 2 * (1 - t) * t * p1 + t * t * p2
			model:ScaleTo(0.4 + 0.6 * math.min(1, t * 1.6))
			model:PivotTo(CFrame.new(a) * (target - target.Position) * CFrame.Angles(0, spin * (1 - t), 0))
		end)
		local tween = TweenService:Create(alpha, TweenInfo.new(1.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = 1 })
		tween:Play()
		tween.Completed:Connect(function()
			alpha:Destroy()
			if model.Parent then
				model:ScaleTo(1)
				model:PivotTo(target)
				puff(target.Position, Color3.fromRGB(235, 225, 205), 14)
			end
		end)
	end
end

spawnYardCar = function(plot, slot, carId)
	local owner = plotOwner[plot.Index]
	local entry = { Kind = "Car", Id = carId }
	local model = CarBuilder.BuildCar(carId)
	model:PivotTo(plot.YardSlots[slot])
	model:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
	model:SetAttribute("YardSlot", slot)
	model:SetAttribute("Kind", "Car")
	-- a dusty look until it's washed
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			local dust = Color3.fromRGB(196, 178, 150):Lerp(Config.Containers[Config.CarsById[carId].Container].Dirt, 0.25)
			p.Color = p.Color:Lerp(dust, 0.5)
		end
	end
	addLabel(model.PrimaryPart, carTitle(carId), "dirty · wash me", rarityOf(carId).Color, 6, 18)
	addPrompt(model:FindFirstChild("Body"), "Send to Wash Bay", carTitle(carId), 0.3, owner, function(player)
		sendToWash(player, plot, slot, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
	state[plot.Index].Yard[slot] = entry
end

---------------------------------------------------------------------
-- Wash bay
---------------------------------------------------------------------
local moveToLift -- forward declaration

local function dirtHealth(containerLevel)
	return math.min(4, math.ceil(containerLevel / 3))
end

local function setWashProgress(plot, value)
	local owner = plotOwner[plot.Index]
	if owner then
		owner:SetAttribute("WashProgress", value)
	end
	-- the paint shines back through as the dust comes off
	local wash = state[plot.Index] and state[plot.Index].Wash
	if value and wash and wash.Paint then
		local k = 0.45 * math.max(0, 1 - value * 1.15)
		for part, color in pairs(wash.Paint) do
			if part.Parent then
				part.Color = color:Lerp(wash.DustColor, k)
			end
		end
		for _, f in ipairs(wash.Film or {}) do
			f.Transparency = math.min(1, 0.3 + 0.8 * value)
		end
	end
	if value then
		plot.WashLabel.Text = "WASHING  " .. math.floor(value * 100) .. "%"
	else
		plot.WashLabel.Text = "WASH SPOT"
	end
end

local function finishWash(plot)
	local wash = state[plot.Index].Wash
	if not wash or wash.Done then
		return
	end
	wash.Done = true
	for _, b in ipairs(wash.Blobs) do
		b.Part:Destroy()
	end
	wash.Blobs = {}
	for part, color in pairs(wash.Paint or {}) do
		if part.Parent then
			part.Color = color
		end
	end
	for _, f in ipairs(wash.Film or {}) do
		f:Destroy()
	end
	setWashProgress(plot, nil)
	plot.WashLabel.Text = "SPARKLING CLEAN!"
	local owner = plotOwner[plot.Index]
	if owner then
		notify(owner, "Sparkling clean! " .. carTitle(wash.Id) .. " is ready for new tires.", GREEN)
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.Parent = wash.Model:FindFirstChild("Body")
	if not state[plot.Index].Lift then
		task.delay(1.2, function()
			moveToLift(plot)
		end)
	else
		addPrompt(wash.Model:FindFirstChild("Body"), "Move to Tire Shop", carTitle(wash.Id), 0, owner, function(player)
			if plotOwner[plot.Index] == player then
				if state[plot.Index].Lift then
					notify(player, "The tire shop is busy. Finish that car first!", RED)
				else
					moveToLift(plot)
				end
			end
		end)
	end
end

local function startWash(plot, carId)
	local car = Config.CarsById[carId]
	local model = CarBuilder.BuildCar(carId)
	model:PivotTo(plot.WashCFrame)
	model.Parent = carsFolder
	local health = dirtHealth(car.Container)
	local dirtColor = Config.Containers[car.Container].Dirt
	-- dust is a pale, sandy grey (not dark mud) tinted a little by the container
	local dustColor = Color3.fromRGB(196, 178, 150):Lerp(dirtColor, 0.25)
	-- the paint itself starts dull and dusty and comes back as you scrub
	local paint = {}
	local film = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Transparency < 0.9 then
			paint[d] = d.Color
			d.Color = d.Color:Lerp(dustColor, 0.45)
		end
	end
	-- a soft, even film of dust hugging the whole car (a slightly larger see-through copy of each part)
	for part in pairs(paint) do
		if part.Transparency < 0.3 and part.Size.Magnitude > 0.8 then
			local f = part:Clone()
			f:ClearAllChildren()
			f.Name = "DustFilm"
			if f:IsA("MeshPart") then
				f.TextureID = ""
			end
			f.Size = part.Size * 1.025 + Vector3.new(0.04, 0.04, 0.04)
			f.CFrame = part.CFrame
			f.Color = dustColor
			f.Material = Enum.Material.SmoothPlastic
			f.Reflectance = 0
			f.Transparency = 0.3
			f.Anchored = true
			f.CanCollide = false
			f.CanQuery = false
			f.CanTouch = false
			f.CastShadow = false
			f.Parent = model
			table.insert(film, f)
		end
	end
	local boxCF, size = model:GetBoundingBox()
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local blobs = {}
	-- only the visible parts of the car catch dirt
	local visible = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.9 then
			table.insert(visible, d)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = visible
	local taken = {}
	local function blob(fromLocal, dirLocal)
		local origin = boxCF:PointToWorldSpace(fromLocal)
		local dir = boxCF:VectorToWorldSpace(dirLocal)
		local hit = workspace:Raycast(origin, dir, params)
		if not hit then
			return
		end
		local pos = hit.Position
		local key = math.floor(pos.X / 1.2) .. "," .. math.floor(pos.Y / 1.2) .. "," .. math.floor(pos.Z / 1.2)
		if taken[key] then
			return
		end
		taken[key] = true
		-- scrub target lying flat on the paint
		local sz = rng:NextNumber(1.7, 2.2)
		local p = Instance.new("Part")
		p.Name = "Dirt"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.04, sz, sz)
		p.CFrame = CFrame.lookAt(pos + hit.Normal * 0.03, pos + hit.Normal * 2) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(rng:NextNumber(0, 6.28), 0, 0)
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = dustColor
		p.Transparency = 1 -- invisible scrub target; the visible dust is the film over the paint
		p.Parent = dirtFolder
		table.insert(blobs, { Part = p, Health = health, StartSize = sz })
	end
	-- shoot rays at the car from above and from all four sides; dirt sticks where they land
	local spacing = 1.05
	local reach = 2 * math.max(hx, hy, hz) + 4
	for x = -hx + 0.6, hx - 0.6, spacing do
		for z = -hz + 0.6, hz - 0.6, spacing do
			blob(Vector3.new(x + rng:NextNumber(-0.4, 0.4), hy + 2, z + rng:NextNumber(-0.4, 0.4)), Vector3.new(0, -reach, 0))
		end
	end
	for y = -hy + 0.8, hy - 0.4, spacing do
		for z = -hz + 0.6, hz - 0.6, spacing do
			blob(Vector3.new(hx + 2, y, z), Vector3.new(-reach, 0, 0))
			blob(Vector3.new(-hx - 2, y, z), Vector3.new(reach, 0, 0))
		end
		for x = -hx + 0.6, hx - 0.6, spacing do
			blob(Vector3.new(x, y, hz + 2), Vector3.new(0, 0, -reach))
			blob(Vector3.new(x, y, -hz - 2), Vector3.new(0, 0, reach))
		end
	end
	local wash = {
		Id = carId,
		Model = model,
		Blobs = blobs,
		Total = #blobs * health,
		Remaining = #blobs * health,
		Health = health,
		Paint = paint,
		Film = film,
		DustColor = dustColor,
		Done = false,
	}
	state[plot.Index].Wash = wash
	setWashProgress(plot, 0)

	-- the Automatic Car Wash cleans by itself
	local owner = plotOwner[plot.Index]
	local profile = owner and DataService.Get(owner)
	if profile and Config.WashTools[profile.ToolLevel].Auto then
		task.spawn(function()
			local steps = 40
			for i = 1, steps do
				task.wait(8 / steps)
				if state[plot.Index].Wash ~= wash or wash.Done then
					return
				end
				local removeCount = math.ceil(#wash.Blobs / (steps - i + 1))
				for _ = 1, removeCount do
					local b = table.remove(wash.Blobs)
					if b then
						b.Part:Destroy()
					end
				end
				setWashProgress(plot, i / steps)
			end
			finishWash(plot)
		end)
	end
end

sendToWash = function(player, plot, slot, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Yard[slot] ~= entry then
		return
	end
	if state[plot.Index].Wash then
		notify(player, "The wash bay is busy. Finish washing the current car first!", RED)
		return
	end
	state[plot.Index].Yard[slot] = nil
	entry.Model:Destroy()
	startWash(plot, entry.Id)
	-- bring the player to the wash bay so they can start scrubbing right away
	local char = player.Character
	if char then
		local stand = plot.WashCFrame:PointToWorldSpace(Vector3.new(10.5, 3, -4))
		char:PivotTo(CFrame.lookAt(stand, Vector3.new(plot.WashCFrame.X, stand.Y, plot.WashCFrame.Z)))
	end
end

ScrubEvent.OnServerEvent:Connect(function(player, hitPosition)
	if typeof(hitPosition) ~= "Vector3" then
		return
	end
	local t = os.clock()
	if lastScrub[player] and t - lastScrub[player] < Config.ScrubInterval * 0.6 then
		return
	end
	lastScrub[player] = t
	local plot = playerPlot[player]
	local wash = plot and state[plot.Index].Wash
	local profile = DataService.Get(player)
	if not wash or wash.Done or not profile then
		return
	end
	local root = getRoot(player)
	local center = plot.WashCFrame.Position
	if not root or (root.Position - center).Magnitude > 40 or (hitPosition - center).Magnitude > 22 then
		return
	end
	local tool = Config.WashTools[profile.ToolLevel]
	for i = #wash.Blobs, 1, -1 do
		local b = wash.Blobs[i]
		if (b.Part.Position - hitPosition).Magnitude <= tool.Radius + b.Part.Size.Y / 2 then
			local dmg = math.min(tool.Power, b.Health)
			b.Health = b.Health - dmg
			wash.Remaining = wash.Remaining - dmg
			if b.Health <= 0 then
				b.Part:Destroy()
				table.remove(wash.Blobs, i)
			end
		end
	end
	local progress = 1 - wash.Remaining / math.max(1, wash.Total)
	setWashProgress(plot, progress)
	if #wash.Blobs == 0 or progress >= 0.85 then
		finishWash(plot)
	end
end)

---------------------------------------------------------------------
-- Engine lift
---------------------------------------------------------------------
local function rebuildLift(plot)
	local lift = state[plot.Index].Lift
	if not lift then
		return
	end
	if lift.Model then
		lift.Model:Destroy()
	end
	local owner = plotOwner[plot.Index]
	local model = CarBuilder.BuildCar(lift.Id, { Tires = lift.Engine })
	model:PivotTo(plot.LiftCFrame)
	model:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
	model:SetAttribute("Kind", "Lift")
	addPrompt(model:FindFirstChild("Body"), "Change Tires", carTitle(lift.Id), 0, owner, function(player)
		if plotOwner[plot.Index] == player and state[plot.Index].Lift == lift then
			OpenEngineEvent:FireClient(player, lift.Id, lift.Engine)
		end
	end)
	model.Parent = carsFolder
	lift.Model = model
end

moveToLift = function(plot)
	local wash = state[plot.Index].Wash
	if not wash or not wash.Done or state[plot.Index].Lift then
		return
	end
	wash.Model:Destroy()
	state[plot.Index].Wash = nil
	plot.WashLabel.Text = "WASH SPOT"
	state[plot.Index].Lift = { Id = wash.Id, Engine = nil }
	rebuildLift(plot)
	plot.LiftLabel.Text = "TIRE SHOP"
	local owner = plotOwner[plot.Index]
	if owner then
		OpenEngineEvent:FireClient(owner, wash.Id, nil)
	end
end

local function rollEngine(profile, lucky)
	local weights = Config.GetEngineWeights(profile.EngineLuck, lucky)
	return Config.WeightedIndex(weights, rng)
end

EngineAction.OnServerInvoke = function(player, action)
	local plot = playerPlot[player]
	local profile = DataService.Get(player)
	local lift = plot and state[plot.Index].Lift
	if not profile or not lift then
		return { Ok = false, Message = "There's no car in the tire shop." }
	end
	if action == "Roll" or action == "Lucky" then
		if action == "Lucky" then
			if profile.Tokens < 1 then
				return { Ok = false, Message = "You need 1 token. Collect tokens in the Index!" }
			end
			profile.Tokens = profile.Tokens - 1
			syncAttributes(player)
		end
		lift.Engine = rollEngine(profile, action == "Lucky")
		rebuildLift(plot)
		local engine = Config.Engines[lift.Engine]
		if lift.Engine >= 6 then
			notifyAll(player.DisplayName .. " rolled a " .. engine.Name .. "!", engine.Color)
		end
		return { Ok = true, Engine = lift.Engine, Income = Config.GetCarIncome(lift.Id, lift.Engine) }
	elseif action == "Done" then
		if not lift.Engine then
			return { Ok = false, Message = "Roll a set of tires first!" }
		end
		local spot = freeSpot(plot, profile)
		if not spot then
			return { Ok = false, Message = "Your showroom is full! Sell a car or upgrade the showroom." }
		end
		lift.Model:Destroy()
		state[plot.Index].Lift = nil
		local entry = { Id = lift.Id, Engine = lift.Engine }
		state[plot.Index].Spots[spot] = entry
		showSpot(plot, spot, entry)
		notify(player, carTitle(lift.Id) .. " is on display! Customers are on the way.", GREEN)
		if state[plot.Index].Wash and state[plot.Index].Wash.Done then
			task.delay(0.5, function()
				moveToLift(plot)
			end)
		end
		return { Ok = true, Done = true }
	elseif action == "Sell" then
		local value = Config.GetCarIncome(lift.Id, lift.Engine or 1) * Config.SellSeconds
		lift.Model:Destroy()
		state[plot.Index].Lift = nil
		addCash(player, value)
		notify(player, "Sold " .. carTitle(lift.Id) .. " for $" .. Config.FormatNumber(value), GOLD)
		if state[plot.Index].Wash and state[plot.Index].Wash.Done then
			task.delay(0.5, function()
				moveToLift(plot)
			end)
		end
		return { Ok = true, Done = true }
	end
	return { Ok = false }
end

---------------------------------------------------------------------
-- Upgrade pads
---------------------------------------------------------------------
local function setPad(pad, levelText, price, stateName)
	pad.Label.Text = levelText
	if stateName == "max" then
		pad.Price.Text = "MAX"
		pad.Plate.Color = Color3.fromRGB(150, 160, 190)
	elseif stateName == "locked" then
		pad.Price.Text = price
		pad.Plate.Color = Color3.fromRGB(225, 70, 70)
	else
		pad.Price.Text = "$" .. Config.FormatNumber(price)
		pad.Plate.Color = Color3.fromRGB(60, 200, 80)
	end
end

local function refreshPads(plot)
	local owner = plotOwner[plot.Index]
	local profile = owner and DataService.Get(owner)
	local pads = plot.Pads
	if not profile then
		for _, pad in pairs(pads) do
			setPad(pad, "", "FOR SALE", "locked")
		end
		return
	end
	local L = profile.ShowroomLevel
	if L >= Config.MaxShowroomLevel then
		setPad(pads.Showroom, Config.ShowroomNames[L], 0, "max")
	else
		setPad(pads.Showroom, Config.ShowroomNames[L] .. " -> " .. Config.ShowroomNames[L + 1], Config.GetShowroomCost(L + 1))
	end
	local per = Config.GetContainersPerDelivery(profile.TruckLevel)
	if profile.TruckLevel >= Config.MaxTruckLevel then
		setPad(pads.Truck, "Level " .. profile.TruckLevel .. " · " .. per .. " per delivery", 0, "max")
	elseif profile.TruckLevel + 1 > Config.GetMaxTruck(L) then
		setPad(pads.Truck, "Level " .. profile.TruckLevel .. " · " .. per .. " per delivery", "UPGRADE SHOWROOM", "locked")
	else
		setPad(pads.Truck, "Level " .. profile.TruckLevel .. " · " .. per .. " per delivery", Config.GetTruckCost(profile.TruckLevel + 1))
	end
	local tool = Config.WashTools[profile.ToolLevel]
	if profile.ToolLevel >= #Config.WashTools then
		setPad(pads.Wash, tool.Name, 0, "max")
	elseif profile.ToolLevel + 1 > Config.GetMaxTool(L) then
		setPad(pads.Wash, tool.Name, "UPGRADE SHOWROOM", "locked")
	else
		setPad(pads.Wash, tool.Name .. " -> " .. Config.WashTools[profile.ToolLevel + 1].Name, Config.WashTools[profile.ToolLevel + 1].Cost)
	end
	if profile.EngineLuck >= Config.MaxEngineLuck then
		setPad(pads.Engine, "Level " .. profile.EngineLuck, 0, "max")
	else
		setPad(pads.Engine, "Level " .. profile.EngineLuck, Config.GetEngineLuckCost(profile.EngineLuck))
	end
end

local function tryBuy(player, cost, apply)
	local profile = DataService.Get(player)
	if profile.Cash < cost then
		notify(player, "You need $" .. Config.FormatNumber(cost) .. ".", RED)
		return
	end
	setCash(player, profile.Cash - cost)
	apply(profile)
	syncAttributes(player)
	local plot = playerPlot[player]
	if plot then
		refreshPads(plot)
		refreshSpotPads(plot, profile)
	end
end

for _, plot in ipairs(map.Plots) do
	local function padPrompt(padKey, handler)
		addPrompt(plot.Pads[padKey].Part, "Upgrade", "", 0.4, nil, function(player)
			if playerPlot[player] ~= plot then
				notify(player, "That's someone else's upgrade pad.", RED)
				return
			end
			handler(player, DataService.Get(player))
		end)
	end
	padPrompt("Showroom", function(player, profile)
		if profile.ShowroomLevel >= Config.MaxShowroomLevel then
			return notify(player, "Your showroom is maxed!", GOLD)
		end
		tryBuy(player, Config.GetShowroomCost(profile.ShowroomLevel + 1), function(p)
			p.ShowroomLevel = p.ShowroomLevel + 1
			applyShowroom(plot, player, p)
			notify(player, "Your " .. Config.ShowroomNames[p.ShowroomLevel] .. " is open! " .. maxSpots(p) .. " display spots, containers up to " .. Config.GetMaxContainer(p.ShowroomLevel) .. ".", GREEN)
		end)
	end)
	padPrompt("Truck", function(player, profile)
		local nextLevel = profile.TruckLevel + 1
		if nextLevel > Config.MaxTruckLevel then
			return notify(player, "Your truck is maxed!", GOLD)
		end
		if nextLevel > Config.GetMaxTruck(profile.ShowroomLevel) then
			return notify(player, "Upgrade your showroom first to unlock a bigger truck.", RED)
		end
		tryBuy(player, Config.GetTruckCost(nextLevel), function(p)
			p.TruckLevel = nextLevel
			notify(player, "Truck level " .. nextLevel .. "! " .. Config.GetContainersPerDelivery(nextLevel) .. " containers per delivery.", GREEN)
		end)
	end)
	padPrompt("Wash", function(player, profile)
		if profile.ToolLevel >= #Config.WashTools then
			return notify(player, "Your car wash is maxed!", GOLD)
		end
		if profile.ToolLevel + 1 > Config.GetMaxTool(profile.ShowroomLevel) then
			return notify(player, "Upgrade your showroom first to unlock a better car wash.", RED)
		end
		local t = Config.WashTools[profile.ToolLevel + 1]
		tryBuy(player, t.Cost, function(p)
			p.ToolLevel = p.ToolLevel + 1
			plot.SetWashTier(p.ToolLevel)
			notify(player, "New tool: " .. t.Name .. "!", GREEN)
		end)
	end)
	padPrompt("Engine", function(player, profile)
		if profile.EngineLuck >= Config.MaxEngineLuck then
			return notify(player, "Tire Luck is maxed!", GOLD)
		end
		tryBuy(player, Config.GetEngineLuckCost(profile.EngineLuck), function(p)
			p.EngineLuck = p.EngineLuck + 1
			notify(player, "Tire Luck level " .. p.EngineLuck .. "! Better tires are more likely.", GREEN)
		end)
	end)
	refreshPads(plot)
	refreshSpotPads(plot, nil)
end

---------------------------------------------------------------------
-- Hotbar: click a card to open that container or wash that car
---------------------------------------------------------------------
YardAction.OnServerEvent:Connect(function(player, slot)
	local plot = playerPlot[player]
	if not plot or typeof(slot) ~= "number" then
		return
	end
	local entry = state[plot.Index].Yard[slot]
	if not entry or not entry.Model then
		return
	end
	if entry.Kind == "Container" then
		-- walk up to the crate first, then open it
		local char = player.Character
		if char then
			local p = entry.Model:GetPivot().Position
			local dir = (plot.SpawnCFrame.Position - p) * Vector3.new(1, 0, 1)
			dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.zAxis
			local stand = p + dir * 7
			char:PivotTo(CFrame.lookAt(Vector3.new(stand.X, p.Y + 3, stand.Z), Vector3.new(p.X, p.Y + 3, p.Z)))
		end
		task.spawn(openContainer, player, plot, slot, entry)
	elseif entry.Kind == "Car" then
		sendToWash(player, plot, slot, entry)
	end
end)

---------------------------------------------------------------------
-- Truck deliveries
---------------------------------------------------------------------
local function scheduleNext(player)
	local profile = DataService.Get(player)
	local delay = Config.FirstDeliveries[profile.DeliveriesDone + 1] or Config.DeliveryInterval
	player:SetAttribute("NextDelivery", now() + delay)
end

local function rollContainerLevel(profile)
	return rng:NextInteger(1, Config.GetMaxContainer(profile.ShowroomLevel))
end

local delivering = {}
local function deliver(player)
	local plot = playerPlot[player]
	local profile = DataService.Get(player)
	if not plot or not profile or delivering[player] then
		return
	end
	delivering[player] = true
	-- never let a broke player with no cars get stuck: top them up to open one container 1
	if profile.Cash < Config.GetContainerPrice(1) and next(state[plot.Index].Spots) == nil then
		setCash(player, Config.GetContainerPrice(1))
	end
	-- last delivery's unopened containers expire before the new ones arrive
	local expired = expireContainers(plot)
	if expired > 0 then
		notify(player, expired .. " unopened container" .. (expired > 1 and "s" or "") .. " expired.", Color3.fromRGB(255, 190, 120))
		task.wait(1)
	end
	local delivered = 0
	for k = 1, Config.GetContainersPerDelivery(profile.TruckLevel) do
		if playerPlot[player] ~= plot then
			break
		end
		local slot = freeYardSlot(plot)
		if not slot then
			break
		end
		-- every delivery brings at least one free Container 1, so nobody can get stuck with $0
		spawnContainer(plot, slot, k == 1 and 1 or rollContainerLevel(profile), true)
		delivered = delivered + 1
		task.wait(0.14)
	end
	if delivered > 0 then
		profile.DeliveriesDone = profile.DeliveriesDone + 1
		notify(player, "New containers delivered!", GOLD)
		player:SetAttribute("YardFull", false)
	else
		player:SetAttribute("YardFull", true)
	end
	if player.Parent and DataService.Get(player) then
		scheduleNext(player)
	end
	delivering[player] = nil
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local t = now()
		for player in pairs(playerPlot) do
			local nextAt = player:GetAttribute("NextDelivery")
			if nextAt and t >= nextAt then
				task.spawn(deliver, player)
			end
		end
	end
end)

---------------------------------------------------------------------
-- Income (every second) and NPC customers
---------------------------------------------------------------------
local function plotIncome(plot, profile)
	local total = 0
	for _, entry in pairs(state[plot.Index].Spots) do
		total = total + Config.GetCarIncome(entry.Id, entry.Engine)
	end
	return total * (1 + Config.CompletionBonus * completedCount(profile))
end

task.spawn(function()
	while true do
		task.wait(1)
		for player, plot in pairs(playerPlot) do
			local profile = DataService.Get(player)
			if profile then
				local income = plotIncome(plot, profile)
				profile.IncomeRate = income
				player:SetAttribute("IncomeRate", income)
				if income > 0 then
					addCash(player, income)
				end
			end
		end
	end
end)

local function buildNPC()
	local model = Instance.new("Model")
	model.Name = "Customer"
	local shirt = Color3.fromHSV(rng:NextNumber(), 0.6, 0.9)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(2, 2, 1)
	body.Color = shirt
	body.Anchored = true
	body.CanCollide = false
	body.Parent = model
	local function attach(name, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Size = size
		p.Color = color
		p.CFrame = body.CFrame * CFrame.new(offset)
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		p.Parent = model
		return p
	end
	local skins = { Color3.fromRGB(255, 214, 170), Color3.fromRGB(235, 180, 130), Color3.fromRGB(190, 130, 90), Color3.fromRGB(120, 80, 55) }
	local skin = skins[rng:NextInteger(1, #skins)]
	local pants = Color3.fromHSV(rng:NextNumber(), 0.4, rng:NextNumber(0.25, 0.5))
	local hair = Color3.fromHSV(rng:NextNumber(0.02, 0.12), 0.6, rng:NextNumber(0.15, 0.6))
	body.Material = Enum.Material.SmoothPlastic
	attach("Head", Vector3.new(1.5, 1.5, 1.5), Vector3.new(0, 1.8, 0), skin, Enum.PartType.Ball)
	attach("Hair", Vector3.new(1.6, 0.6, 1.6), Vector3.new(0, 2.35, 0.1), hair)
	for _, x in ipairs({ -0.3, 0.3 }) do
		attach("Eye", Vector3.new(0.18, 0.28, 0.1), Vector3.new(x, 1.9, -0.72), Color3.fromRGB(20, 20, 25))
		attach("Arm", Vector3.new(0.6, 1.9, 0.6), Vector3.new(x > 0 and 1.3 or -1.3, -0.05, 0), shirt:Lerp(skin, 0.15))
		attach("Hand", Vector3.new(0.55, 0.45, 0.55), Vector3.new(x > 0 and 1.3 or -1.3, -1.15, 0), skin)
		attach("Leg", Vector3.new(0.9, 1.8, 0.95), Vector3.new(x > 0 and 0.5 or -0.5, -1.9, 0), pants)
		attach("Shoe", Vector3.new(0.95, 0.35, 1.2), Vector3.new(x > 0 and 0.5 or -0.5, -2.85, -0.1), Color3.fromRGB(240, 240, 240))
	end
	model.PrimaryPart = body
	return model, body
end

-- Real Roblox characters as customers (R15 rig with random skin and clothes colors).
-- Falls back to the simple block customer if the rig can't be made.
local WALK_ANIM = "rbxassetid://507777826" -- Roblox's default R15 walk
local IDLE_ANIM = "rbxassetid://507766388" -- Roblox's default R15 idle
local function buildRigNPC()
	local desc = Instance.new("HumanoidDescription")
	local skins = { Color3.fromRGB(255, 214, 170), Color3.fromRGB(234, 184, 146), Color3.fromRGB(196, 140, 100), Color3.fromRGB(124, 84, 60) }
	local skin = skins[rng:NextInteger(1, #skins)]
	local shirt = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.35, 0.7), rng:NextNumber(0.6, 0.95))
	local pants = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.2, 0.5), rng:NextNumber(0.2, 0.45))
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = "Customer"
	local root = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	root.Anchored = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	model.PrimaryPart = root
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local tracks = {}
	for name, id in pairs({ Walk = WALK_ANIM, Idle = IDLE_ANIM }) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok then
			track.Looped = true
			tracks[name] = track
		end
	end
	model:SetAttribute("Rig", true)
	local height = hum.HipHeight + root.Size.Y / 2
	return model, root, tracks, height
end

local function walk(body, target, speed)
	local from = body.Position
	local dist = (target - from).Magnitude
	if dist < 0.1 then
		return
	end
	local look = Vector3.new(target.X, from.Y, target.Z)
	if (look - from).Magnitude > 0.1 then
		body.CFrame = CFrame.lookAt(from, look)
	end
	local tween = TweenService:Create(body, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(target, target + (target - from).Unit) })
	tween:Play()
	tween.Completed:Wait()
end

local function runCustomer(plot)
	local spots = {}
	for i, entry in pairs(state[plot.Index].Spots) do
		table.insert(spots, { Index = i, Entry = entry })
	end
	if #spots == 0 then
		return
	end
	local pick = spots[rng:NextInteger(1, #spots)]
	local model, body, tracks, height
	local ok0 = pcall(function()
		model, body, tracks, height = buildRigNPC()
	end)
	if not ok0 or not model then
		model, body = buildNPC()
		tracks, height = {}, 2.95
	end
	local y = 1 + height
	local function play(name)
		for n, t in pairs(tracks) do
			if n == name then
				if not t.IsPlaying then
					t:Play(0.2)
				end
			else
				t:Stop(0.2)
			end
		end
	end
	body.CFrame = CFrame.new(plot.DoorOutside.X + rng:NextNumber(-4, 4), y, plot.DoorOutside.Z)
	model.Parent = npcFolder
	state[plot.Index].NPCs = state[plot.Index].NPCs + 1
	local ok = pcall(function()
		local inside = Vector3.new(plot.DoorInside.X, y, plot.DoorInside.Z)
		local front = plot.Spots[pick.Index].Front.Position
		play("Walk")
		walk(body, inside, 9)
		walk(body, Vector3.new(front.X + rng:NextNumber(-2, 2), y, front.Z), 9)
		play("Idle")
		-- admire the car and pay
		local entry = state[plot.Index].Spots[pick.Index]
		if entry then
			local amount = Config.GetCarIncome(entry.Id, entry.Engine) * 3
			local gui, t = addLabel(body, "+$" .. Config.FormatNumber(amount), nil, GREEN, 3, 40)
			t.TextColor3 = GREEN
			task.wait(2.5)
			gui:Destroy()
		else
			task.wait(1)
		end
		play("Walk")
		walk(body, inside, 9)
		walk(body, Vector3.new(plot.DoorOutside.X + rng:NextNumber(-6, 6), y, plot.DoorOutside.Z), 9)
	end)
	if not ok then
		warn("[D2D] customer walk failed")
	end
	model:Destroy()
	state[plot.Index].NPCs = state[plot.Index].NPCs - 1
end

task.spawn(function()
	while true do
		task.wait(3)
		for player, plot in pairs(playerPlot) do
			local profile = DataService.Get(player)
			if profile then
				local limit = math.min(1 + math.floor(profile.ShowroomLevel / 2), 6)
				if state[plot.Index].NPCs < limit and next(state[plot.Index].Spots) then
					task.spawn(runCustomer, plot)
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Players joining and leaving
---------------------------------------------------------------------
local function setupCharacter(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	-- the plots are big: walk a bit faster so getting around feels snappy
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 24
		hum.JumpPower = 50
	end
	task.wait()
	local plot = playerPlot[player]
	if plot then
		character:PivotTo(plot.SpawnCFrame)
	end
end

local function onPlayerAdded(player)
	local profile = DataService.Load(player)
	if player.Parent ~= Players then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Value = profile.Cash
	cash.Parent = ls
	local cars = Instance.new("IntValue")
	cars.Name = "Cars"
	cars.Parent = ls
	ls.Parent = player

	local plot
	for i, p in ipairs(map.Plots) do
		if not plotOwner[i] then
			plot = p
			break
		end
	end
	if plot then
		plotOwner[plot.Index] = player
		playerPlot[player] = plot
		player:SetAttribute("PlotIndex", plot.Index)
		player:SetAttribute("WashFocus", plot.WashCFrame)
		player:SetAttribute("LiftFocus", plot.LiftCFrame)
		for _, d in ipairs(profile.Display) do
			state[plot.Index].Spots[d.Spot] = { Id = d.Id, Engine = d.Engine }
		end
		applyShowroom(plot, player, profile)
		plot.SetWashTier(profile.ToolLevel)
		for i, y in ipairs(profile.Yard) do
			if y.Kind == "Container" then
				spawnContainer(plot, i, y.Level, false)
			else
				spawnYardCar(plot, i, y.Id)
			end
		end
		refreshPads(plot)
		refreshSpotPads(plot, profile)
	else
		notify(player, "All showrooms are taken, sorry! Try another server.", RED)
	end
	syncAttributes(player)

	-- offline earnings
	if profile.LastOnline > 0 and profile.IncomeRate > 0 then
		local away = math.min(os.time() - profile.LastOnline, Config.OfflineMaxSeconds)
		local earned = math.floor(away * profile.IncomeRate * Config.OfflineRate)
		if earned >= 1 then
			addCash(player, earned)
			task.delay(3, function()
				if player.Parent == Players then
					OfflineEvent:FireClient(player, earned)
				end
			end)
		end
	end
	if plot then
		scheduleNext(player)
	end

	player.CharacterAdded:Connect(function(character)
		setupCharacter(player, character)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
end

local function collectSave(player)
	local profile = DataService.Get(player)
	local plot = playerPlot[player]
	if not profile or not plot then
		return
	end
	local s = state[plot.Index]
	profile.Display = {}
	for spot, entry in pairs(s.Spots) do
		table.insert(profile.Display, { Id = entry.Id, Engine = entry.Engine, Spot = spot })
	end
	profile.Yard = {}
	-- cars in the wash bay or on the lift go back to the yard
	if s.Lift then
		table.insert(profile.Yard, { Kind = "Car", Id = s.Lift.Id })
	end
	if s.Wash then
		table.insert(profile.Yard, { Kind = "Car", Id = s.Wash.Id })
	end
	for i = 1, #plot.YardSlots do
		local y = s.Yard[i]
		if y and #profile.Yard < Config.YardCapacity then
			if y.Kind == "Container" then
				table.insert(profile.Yard, { Kind = "Container", Level = y.Level })
			else
				table.insert(profile.Yard, { Kind = "Car", Id = y.Id })
			end
		end
	end
	profile.LastOnline = os.time()
end

local function clearPlot(plot)
	local s = state[plot.Index]
	for _, entry in pairs(s.Spots) do
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	for _, entry in pairs(s.Yard) do
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	if s.Wash then
		for _, b in ipairs(s.Wash.Blobs) do
			b.Part:Destroy()
		end
		s.Wash.Model:Destroy()
	end
	if s.Lift and s.Lift.Model then
		s.Lift.Model:Destroy()
	end
	state[plot.Index] = { Spots = {}, Yard = {}, Wash = nil, Lift = nil, NPCs = s.NPCs }
	plot.BuildShowroom(1)
	plot.SetSign("FOR SALE")
	plot.SetWashTier(1)
	plot.WashLabel.Text = "WASH SPOT"
	plot.LiftLabel.Text = "TIRE SHOP"
end

local function onPlayerRemoving(player)
	collectSave(player)
	DataService.Save(player)
	local plot = playerPlot[player]
	if plot then
		clearPlot(plot)
		plotOwner[plot.Index] = nil
		playerPlot[player] = nil
		refreshPads(plot)
		refreshSpotPads(plot, nil)
	end
	lastScrub[player] = nil
	DataService.Release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(onPlayerRemoving)

GoHomeEvent.OnServerEvent:Connect(function(player)
	local plot = playerPlot[player]
	if plot and player.Character then
		player.Character:PivotTo(plot.SpawnCFrame)
	end
end)

game:BindToClose(function()
	local running = 0
	for _, player in ipairs(Players:GetPlayers()) do
		running = running + 1
		task.spawn(function()
			collectSave(player)
			DataService.Save(player)
			running = running - 1
		end)
	end
	local waited = 0
	while running > 0 and waited < 25 do
		waited = waited + task.wait(0.5)
	end
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			collectSave(player)
			task.spawn(DataService.Save, player)
		end
	end
end)

print("[D2D] Server ready!")

---------------------------------------------------------------------
-- Studio-only QA hook (never exists in a live server):
--   game.ServerStorage.D2DDebug:Invoke("showroom", 3)  /  ("cash", 1e9)
---------------------------------------------------------------------
if game:GetService("RunService"):IsStudio() then
	local debugFn = Instance.new("BindableFunction")
	debugFn.Name = "D2DDebug"
	debugFn.OnInvoke = function(cmd, value)
		for player, plot in pairs(playerPlot) do
			local profile = DataService.Get(player)
			if profile then
				if cmd == "showroom" then
					profile.ShowroomLevel = math.clamp(value, 1, Config.MaxShowroomLevel)
					applyShowroom(plot, player, profile)
				elseif cmd == "cash" then
					setCash(player, value)
				end
			end
		end
		return true
	end
	debugFn.Parent = game:GetService("ServerStorage")
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder: builds the world and the 6 player plots when the server starts.
-- Plots face each other across a boulevard. Each plot: a showroom that grows with its level
-- (level 1 is a small garage), a large yard beside it with the upgrade stations, the parking lot
-- for containers, the wash spot (more gear appears as the car wash is upgraded) and the tire shop.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Props"))
local Icons = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Icons"))
local LightingPresets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("LightingPresets"))

local MapBuilder = {}

local FLOOR_Y = 1
local rng = Random.new(2026)

-- palette
local PLASTER = Color3.fromRGB(212, 209, 200)
local PLASTER_SHADE = Color3.fromRGB(214, 210, 200)
local NAVY = Color3.fromRGB(34, 44, 64)
local STONE = Color3.fromRGB(150, 150, 155)
local TILE = Color3.fromRGB(172, 178, 190)
local GROUT = Color3.fromRGB(120, 128, 146)
local WOOD = Color3.fromRGB(232, 200, 150)
local GLASS = Color3.fromRGB(150, 190, 215)
local LAMP = Color3.fromRGB(255, 250, 238)
local ASPHALT = Color3.fromRGB(78, 79, 82)
local CONCRETE = Color3.fromRGB(160, 158, 154)
local LEAF = { Color3.fromRGB(70, 110, 52), Color3.fromRGB(82, 122, 58), Color3.fromRGB(62, 98, 46), Color3.fromRGB(90, 128, 62) }
local GOLD = Color3.fromRGB(255, 205, 80)

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Shape" then
			p[k] = v
		end
	end
	-- clean, smooth look everywhere (no grainy tiled textures), like Clean a Painting
	if p.Material ~= Enum.Material.Glass and p.Material ~= Enum.Material.Neon then
		if p.Material == Enum.Material.Metal or p.Material == Enum.Material.DiamondPlate or p.Material == Enum.Material.CorrodedMetal then
			p.Reflectance = 0
		end
		p.Material = Enum.Material.SmoothPlastic
	end
	p.Parent = parent
	return p
end

-- solid building piece
local function box(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props, parent)
end

-- decoration: no collisions, no raycasts, never blocks the camera
local function deco(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false, CanTouch = false }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props, parent)
end

-- upright cylinder
local function column(parent, name, height, diameter, cf, color, material, solid)
	local p = part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CanCollide = solid or false,
		CanQuery = solid or false,
	}, parent)
	p.Size = Vector3.new(height, diameter, diameter)
	return p
end

local function ball(parent, name, d, cf, color, material)
	local p = part({ Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false }, parent)
	p.Size = Vector3.new(d, d, d)
	return p
end

local function addStroke(l, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2.5
	s.Color = Color3.fromRGB(20, 20, 30)
	s.Parent = l
end

-- floating text sized in studs, only visible up close
local function label(adornee, text, color, offsetY, width, maxDist)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new((width or 220) / 36, 0, 1.4, 0)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = maxDist or 34
	gui.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Text = text
	addStroke(l, 2)
	l.Parent = gui
	gui.Parent = adornee
	return l
end

local function surfaceText(p, face, text, color, pps, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps or 30
	gui.LightInfluence = 0.2
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Font = font or Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Text = text
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.Parent = l
	l.Parent = gui
	gui.Parent = p
	return l
end

local function light(parent, range, brightness, color)
	local l = Instance.new("PointLight")
	l.Color = color or Color3.fromRGB(255, 244, 225)
	l.Range = range or 28
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = parent
	return l
end

---------------------------------------------------------------------
-- Building parts
---------------------------------------------------------------------

-- A window: glass with a navy frame and mullions. `cf` is the window center, facing -Z.
local function window(parent, cf, width, height, cols, rows, glassTransparency, glassColor)
	deco(parent, "Glass", Vector3.new(width, height, 0.2), cf, glassColor or GLASS, Enum.Material.Glass, { Transparency = glassTransparency or 0.4, Reflectance = 0.2 })
	local t = 0.45
	deco(parent, "Frame", Vector3.new(width + t, t, 0.5), cf * CFrame.new(0, height / 2, 0), NAVY)
	deco(parent, "Frame", Vector3.new(width + t, t, 0.5), cf * CFrame.new(0, -height / 2, 0), NAVY)
	deco(parent, "Frame", Vector3.new(t, height + t, 0.5), cf * CFrame.new(-width / 2, 0, 0), NAVY)
	deco(parent, "Frame", Vector3.new(t, height + t, 0.5), cf * CFrame.new(width / 2, 0, 0), NAVY)
	for c = 1, cols - 1 do
		deco(parent, "Mullion", Vector3.new(0.22, height, 0.35), cf * CFrame.new(-width / 2 + c * width / cols, 0, 0), NAVY)
	end
	for r = 1, rows - 1 do
		deco(parent, "Mullion", Vector3.new(width, 0.22, 0.35), cf * CFrame.new(0, -height / 2 + r * height / rows, 0), NAVY)
	end
	-- stone sill under the window
	deco(parent, "Sill", Vector3.new(width + 1, 0.35, 1.1), cf * CFrame.new(0, -height / 2 - 0.4, -0.3), PLASTER_SHADE)
end

local function lowPolyTree(parent, pos, scale)
	scale = scale or 1
	local name = Props.Pick({ "Tree2" }, rng)
	if name and Props.Place(name, parent, CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), { Height = 17 * scale }) then
		return
	end
	local trunkColor = Color3.fromRGB(120, 78, 52)
	local h = 7 * scale
	local lean = rng:NextNumber(-0.12, 0.12)
	deco(parent, "Trunk", Vector3.new(1.1 * scale, h, 1.1 * scale), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(lean, rng:NextNumber(0, 6), 0), trunkColor)
	deco(parent, "Branch", Vector3.new(0.7 * scale, 3 * scale, 0.7 * scale), CFrame.new(pos + Vector3.new(0.8 * scale, h * 0.75, 0)) * CFrame.Angles(0, 0, math.rad(-35)), trunkColor)
	local top = pos + Vector3.new(0, h + 1.2 * scale, 0)
	local pieces = {
		{ Vector3.new(0, 0, 0), 6.2 },
		{ Vector3.new(2.3, -0.8, 0.8), 4.2 },
		{ Vector3.new(-2.1, -0.6, -0.9), 4.4 },
		{ Vector3.new(0.4, 2, -0.4), 4 },
		{ Vector3.new(-0.6, -0.4, 2.2), 3.6 },
	}
	for _, pc in ipairs(pieces) do
		local s = pc[2] * scale
		local color = LEAF[rng:NextInteger(1, #LEAF)]
		deco(parent, "Leaves", Vector3.new(s, s * 0.85, s), CFrame.new(top + pc[1] * scale) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5)), color)
	end
end

local function cypress(parent, pos, height)
	height = height or 6
	local green = Color3.fromRGB(58, 92, 46)
	column(parent, "Cypress", height, 2.2, CFrame.new(pos + Vector3.new(0, height / 2 + 0.6, 0)), green, Enum.Material.LeafyGrass)
	ball(parent, "CypressTop", 2.2, CFrame.new(pos + Vector3.new(0, height + 0.6, 0)), green, Enum.Material.LeafyGrass)
	ball(parent, "CypressBottom", 2.2, CFrame.new(pos + Vector3.new(0, 0.6 + 1.1, 0)), green, Enum.Material.LeafyGrass)
end

local function planter(parent, cf, length, withCypress)
	box(parent, "Planter", Vector3.new(length, 1.6, 2.4), cf * CFrame.new(0, 0.8, 0), NAVY)
	deco(parent, "Soil", Vector3.new(length - 0.4, 0.1, 2), cf * CFrame.new(0, 1.62, 0), Color3.fromRGB(80, 60, 45))
	local n = math.max(1, math.floor(length / 2.6))
	for i = 1, n do
		local x = -length / 2 + (i - 0.5) * length / n
		if withCypress and (i == 1 or i == n) then
			cypress(parent, (cf * CFrame.new(x, 1, 0)).Position, 5)
		elseif not Props.Place("NoSuchBush", parent, cf * CFrame.new(x, 1.6, 0) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), { Width = 2.6 }) then
			ball(parent, "Shrub", 2.4, cf * CFrame.new(x, 2.2, 0), LEAF[rng:NextInteger(1, #LEAF)], Enum.Material.LeafyGrass)
		end
	end
end

local function streetLamp(parent, pos, facing)
	if Props.Place("StreetLamp", parent, CFrame.new(pos) * CFrame.Angles(0, facing > 0 and math.pi or 0, 0), { Height = 14, Solid = true }) then
		return
	end
	column(parent, "LampPole", 13, 0.5, CFrame.new(pos + Vector3.new(0, 6.5, 0)), NAVY, Enum.Material.Metal, true)
	deco(parent, "LampArm", Vector3.new(0.35, 0.35, 2.6), CFrame.new(pos + Vector3.new(0, 12.9, facing * 1.2)), NAVY, Enum.Material.Metal)
	local head = deco(parent, "LampHead", Vector3.new(1.3, 0.5, 1.8), CFrame.new(pos + Vector3.new(0, 12.7, facing * 2.4)), NAVY, Enum.Material.Metal)
	deco(parent, "LampBulb", Vector3.new(1.1, 0.1, 1.5), head.CFrame * CFrame.new(0, -0.28, 0), LAMP, Enum.Material.Neon)
end

local function bench(parent, cf)
	deco(parent, "BenchSeat", Vector3.new(6, 0.4, 1.8), cf * CFrame.new(0, 1.6, 0), WOOD, Enum.Material.Wood)
	deco(parent, "BenchBack", Vector3.new(6, 1.4, 0.3), cf * CFrame.new(0, 2.6, 0.8) * CFrame.Angles(math.rad(-10), 0, 0), WOOD, Enum.Material.Wood)
	for _, x in ipairs({ -2.6, 2.6 }) do
		deco(parent, "BenchLeg", Vector3.new(0.3, 1.5, 1.8), cf * CFrame.new(x, 0.75, 0), NAVY, Enum.Material.Metal)
	end
end

local function cardboardBox(parent, cf, s)
	deco(parent, "Box", Vector3.new(s, s * 0.8, s), cf, Color3.fromRGB(196, 150, 100), Enum.Material.Cardboard)
	deco(parent, "Tape", Vector3.new(0.3, s * 0.81, s * 1.01), cf, Color3.fromRGB(225, 200, 150))
end

local function truck(parent, cf, color)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	box(parent, "TruckCab", Vector3.new(8, 6.5, 6.5), at(0, 4.6, -11.5), color, nil, { Reflectance = 0.1 })
	deco(parent, "TruckRoof", Vector3.new(7.6, 1.2, 4), at(0, 8.4, -11), color)
	deco(parent, "TruckWindow", Vector3.new(7, 2.4, 0.2), at(0, 6.4, -14.8), Color3.fromRGB(40, 55, 80), Enum.Material.Glass, { Reflectance = 0.3 })
	deco(parent, "TruckGrille", Vector3.new(6, 2.2, 0.2), at(0, 2.8, -14.8), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
	deco(parent, "TruckBumper", Vector3.new(8.2, 0.9, 0.6), at(0, 1.5, -14.9), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	for _, x in ipairs({ -3, 3 }) do
		deco(parent, "TruckLight", Vector3.new(1.3, 0.8, 0.2), at(x, 2.9, -14.9), Color3.fromRGB(255, 250, 225), Enum.Material.Neon)
	end
	box(parent, "TruckBed", Vector3.new(8, 1, 18), at(0, 2, 2), Color3.fromRGB(60, 60, 66), Enum.Material.DiamondPlate)
	for _, z in ipairs({ -11.5, -2, 6.5 }) do
		for _, x in ipairs({ -3.7, 3.7 }) do
			local w = part({ Name = "TruckWheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 3, 3), CFrame = at(x, 1.5, z), Color = Color3.fromRGB(25, 25, 28), Material = Enum.Material.Rubber, CanCollide = false }, parent)
			w.Size = Vector3.new(1.2, 3, 3)
		end
	end
	local c = box(parent, "TruckContainer", Vector3.new(7.6, 7, 16), at(0, 6, 2.5), Color3.fromRGB(232, 236, 244), Enum.Material.SmoothPlastic)
	surfaceText(c, Enum.NormalId.Left, "D2D LOGISTICS", Color3.fromRGB(40, 60, 100), 20)
	surfaceText(c, Enum.NormalId.Right, "D2D LOGISTICS", Color3.fromRGB(40, 60, 100), 20)
end

---------------------------------------------------------------------
-- Light and sky
---------------------------------------------------------------------
local function buildLighting()
	LightingPresets.Apply(LightingPresets.Default)
end

---------------------------------------------------------------------
-- Layout
--   A wide boulevard runs along X at z = 0 with a planted median.
--   3 plots on the north side and 3 on the south side face each other across it.
--   Plot-local frame: origin at the plot's front edge (by the sidewalk), +Z goes away from the road.
--   Showroom in front (grows toward the road), container lot behind it, truck backed into the lot.
---------------------------------------------------------------------
local ROAD_HALF = 18 -- road from z -18 to 18
local SIDEWALK = 8
local PLOT_FRONT = ROAD_HALF + SIDEWALK -- plot front edge at |z| = 26
local PLOT_DEPTH = 206
local NORTH_X = { -180, 30, 240 }

local function plotFrame(index)
	if index <= 3 then
		return CFrame.new(NORTH_X[index], 0, PLOT_FRONT)
	end
	-- south side: turned around and shifted so the showrooms sit exactly opposite each other
	return CFrame.new(NORTH_X[index - 3], 0, -PLOT_FRONT) * CFrame.Angles(0, math.pi, 0)
end

---------------------------------------------------------------------
-- Terrain: grass ground, terraced blue cliffs around the town
---------------------------------------------------------------------
local function buildTerrain(map)
	-- smooth flat ground and clean terraced cliffs built from parts (terrain textures look grainy)
	local terrain = workspace.Terrain
	terrain:Clear()
	local GRASS = Color3.fromRGB(104, 178, 74)
	box(map, "Ground", Vector3.new(1800, 2, 1400), CFrame.new(0, -1, 0), GRASS)
	-- rolling green hills with tree lines around the town, so the sky stays open to the horizon
	local HILLS = { Color3.fromRGB(98, 172, 70), Color3.fromRGB(110, 182, 78), Color3.fromRGB(88, 160, 66), Color3.fromRGB(120, 188, 86) }
	local TREES = { Color3.fromRGB(56, 128, 58), Color3.fromRGB(66, 140, 62), Color3.fromRGB(48, 116, 54), Color3.fromRGB(78, 150, 66) }
	local function blob(name, size, cf, color)
		local p = deco(map, name, size, cf, color)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		return p
	end
	local function hill(x, z, rx, rz, h)
		blob("Hill", Vector3.new(rx * 2, h * 2, rz * 2), CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0), HILLS[rng:NextInteger(1, #HILLS)])
		-- a scatter of round trees on the hillside
		local count = math.floor(rx * rz / 380)
		for _ = 1, count do
			local u, v = rng:NextNumber(-0.85, 0.85), rng:NextNumber(-0.85, 0.85)
			local k = 1 - u * u - v * v
			if k > 0.05 then
				local y = h * math.sqrt(k)
				local sz = rng:NextNumber(7, 12)
				local pos = Vector3.new(x + u * rx, y, z + v * rz)
				deco(map, "HillTrunk", Vector3.new(1.2, sz * 0.6, 1.2), CFrame.new(pos + Vector3.new(0, sz * 0.25, 0)), Color3.fromRGB(110, 76, 52))
				blob("HillTree", Vector3.new(sz, sz * 1.15, sz), CFrame.new(pos + Vector3.new(0, sz * 0.75, 0)), TREES[rng:NextInteger(1, #TREES)])
			end
		end
	end
	-- behind the back service roads (north and south)
	for _, sz in ipairs({ -1, 1 }) do
		for x = -680, 680, 70 do
			hill(x + rng:NextNumber(-20, 20), sz * rng:NextNumber(310, 335), rng:NextNumber(45, 70), rng:NextNumber(28, 40), rng:NextNumber(10, 18))
			hill(x + 35 + rng:NextNumber(-20, 20), sz * rng:NextNumber(395, 440), rng:NextNumber(60, 90), rng:NextNumber(40, 60), rng:NextNumber(22, 36))
			hill(x + rng:NextNumber(-30, 30), sz * rng:NextNumber(500, 545), rng:NextNumber(80, 120), rng:NextNumber(50, 70), rng:NextNumber(35, 55))
		end
	end
	-- at both ends of the boulevard (east and west)
	for _, sx in ipairs({ -1, 1 }) do
		for z = -300, 300, 60 do
			if math.abs(z) > 30 then
				hill(sx * rng:NextNumber(430, 460), z + rng:NextNumber(-15, 15), rng:NextNumber(30, 45), rng:NextNumber(40, 60), rng:NextNumber(10, 18))
			end
			hill(sx * rng:NextNumber(530, 580), z + 30 + rng:NextNumber(-15, 15), rng:NextNumber(50, 80), rng:NextNumber(50, 70), rng:NextNumber(24, 40))
			hill(sx * rng:NextNumber(640, 690), z + rng:NextNumber(-20, 20), rng:NextNumber(70, 100), rng:NextNumber(60, 80), rng:NextNumber(35, 55))
		end
	end
end

---------------------------------------------------------------------
-- Boulevard, sidewalks, back service roads, scenery
---------------------------------------------------------------------
local function buildWorld(map)
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	buildTerrain(map)
	local LEN = 760
	-- two carriageways with a planted median
	for _, sz in ipairs({ -1, 1 }) do
		box(map, "Road", Vector3.new(LEN, 0.4, 14), CFrame.new(0, 0.2, sz * 10), ASPHALT, Enum.Material.Asphalt)
		for x = -LEN / 2 + 6, LEN / 2 - 6, 16 do
			deco(map, "LaneLine", Vector3.new(7, 0.05, 0.45), CFrame.new(x, 0.42, sz * 10), Color3.fromRGB(245, 245, 245))
		end
		deco(map, "EdgeLine", Vector3.new(LEN, 0.05, 0.35), CFrame.new(0, 0.42, sz * 16.6), Color3.fromRGB(245, 245, 245))
		box(map, "Curb", Vector3.new(LEN, 0.8, 0.8), CFrame.new(0, 0.4, sz * (ROAD_HALF - 0.4)), Color3.fromRGB(205, 205, 210), Enum.Material.Concrete)
		box(map, "Sidewalk", Vector3.new(LEN, 0.6, SIDEWALK), CFrame.new(0, 0.3, sz * (ROAD_HALF + SIDEWALK / 2)), CONCRETE, Enum.Material.Concrete)
		-- back service road behind the yards
		local backZ = sz * (PLOT_FRONT + PLOT_DEPTH + 10)
		box(map, "ServiceRoad", Vector3.new(LEN, 0.4, 16), CFrame.new(0, 0.2, backZ), ASPHALT, Enum.Material.Asphalt)
		for x = -LEN / 2 + 6, LEN / 2 - 6, 16 do
			deco(map, "LaneLine", Vector3.new(7, 0.05, 0.45), CFrame.new(x, 0.42, backZ), Color3.fromRGB(245, 210, 70))
		end
		-- street lamps and trees along the sidewalk
		for x = -LEN / 2 + 40, LEN / 2 - 40, 90 do
			streetLamp(map, Vector3.new(x, 0.6, sz * (ROAD_HALF + 1.5)), -sz)
		end
	end
	-- median: grass strip with trees, shrubs and lamps
	box(map, "Median", Vector3.new(LEN, 0.7, 6), CFrame.new(0, 0.35, 0), Color3.fromRGB(205, 205, 210), Enum.Material.Concrete)
	deco(map, "MedianGrass", Vector3.new(LEN - 1, 0.1, 5), CFrame.new(0, 0.75, 0), Color3.fromRGB(96, 170, 68), Enum.Material.Grass)
	for x = -LEN / 2 + 30, LEN / 2 - 30, 70 do
		lowPolyTree(map, Vector3.new(x, 0.7, 0), 0.8)
	end
	-- crosswalks between facing plots
	for _, x in ipairs(NORTH_X) do
		for s = -5, 5, 2 do
			deco(map, "Crosswalk", Vector3.new(1.2, 0.05, 32), CFrame.new(x + s, 0.43, 0), Color3.fromRGB(245, 245, 245))
		end
	end
	-- trees between the plots and on the edges
	for _, sz in ipairs({ -1, 1 }) do
		for x = -370, 370, 40 do
			lowPolyTree(map, Vector3.new(x + rng:NextNumber(-6, 6), 0, sz * (PLOT_FRONT + PLOT_DEPTH + 32 + rng:NextNumber(0, 12))), rng:NextNumber(1, 1.4))
		end
	end
	-- invisible walls around the play area
	for _, w in ipairs({
		{ Vector3.new(4, 120, 640), Vector3.new(-385, 60, 0) },
		{ Vector3.new(4, 120, 640), Vector3.new(385, 60, 0) },
		{ Vector3.new(780, 120, 4), Vector3.new(0, 60, -270) },
		{ Vector3.new(780, 120, 4), Vector3.new(0, 60, 270) },
	}) do
		box(map, "Boundary", w[1], CFrame.new(w[2]), Color3.new(1, 1, 1), nil, { Transparency = 1, CanQuery = false })
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.5, 22)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = map
end

---------------------------------------------------------------------
-- One plot
---------------------------------------------------------------------
local function buildPlot(index, parent)
	local plotCF = plotFrame(index)
	local m = Instance.new("Model")
	m.Name = "Plot" .. index
	m.Parent = parent
	local function at(x, y, z)
		return plotCF * CFrame.new(x, y, z)
	end
	local function v(x, y, z)
		return at(x, y, z).Position
	end
	local plot = { Index = index, Model = m, Frame = plotCF }

	-- Layout (plot-local): road side at z = 0. The showroom's back wall is fixed at ZB and it grows
	-- toward the road. Through an open doorway in the back wall you walk straight into the
	-- container lot; the delivery truck is backed into the far end of the lot.
	local ZB = 124
	local LOT_Z0, LOT_Z1, LOT_HALF = ZB + 2, PLOT_DEPTH - 2, 62

	-- a plain path from the sidewalk to the showroom
	deco(m, "Walk", Vector3.new(12, 0.2, ZB), at(0, 0.1, ZB / 2), CONCRETE)

	--=========================== SHOWROOM (rebuilt per level) ===========================
	local showroomModel = nil
	local signText = "FOR SALE"
	local signLabels = {}
	local function applySign()
		for _, l in ipairs(signLabels) do
			if l.Parent then
				l.Text = signText
			end
		end
	end
	function plot.SetSign(text)
		signText = text
		applySign()
	end

	function plot.BuildShowroom(level)
		level = math.clamp(level or 1, 1, Config.MaxShowroomLevel)
		if showroomModel then
			showroomModel:Destroy()
		end
		table.clear(signLabels)
		local sm = Instance.new("Model")
		sm.Name = "Showroom"
		sm.Parent = m
		showroomModel = sm
		local perSide = 2 * level
		local W = 42 + 8 * (level - 1)
		local D = 24 + 10 * perSide
		local H = level == 1 and 13 or (16 + 2 * (level - 2))
		local garage = level == 1
		local Z0 = ZB - D
		local function s(x, y, z)
			return at(x, y, Z0 + z)
		end
		-- every showroom level has its own style: street garage -> workshop -> dealership -> luxury -> future
		local THEMES = {
			{ Name = "street", Wall = Color3.fromRGB(150, 92, 74), Floor = Color3.fromRGB(92, 94, 100), Trim = Color3.fromRGB(46, 48, 56), Ceiling = Color3.fromRGB(70, 72, 80), Light = Color3.fromRGB(255, 214, 150), Front = Color3.fromRGB(150, 92, 74) },
			{ Name = "workshop", Wall = Color3.fromRGB(196, 198, 202), Floor = Color3.fromRGB(110, 120, 134), Trim = Color3.fromRGB(40, 90, 170), Ceiling = Color3.fromRGB(200, 202, 208), Light = LAMP, Front = Color3.fromRGB(196, 198, 202) },
			{ Name = "dealer", Wall = PLASTER, Floor = TILE, Trim = NAVY, Ceiling = Color3.fromRGB(226, 226, 230), Light = LAMP, Front = PLASTER },
			{ Name = "luxury", Wall = Color3.fromRGB(46, 44, 50), Floor = Color3.fromRGB(30, 30, 36), Trim = Color3.fromRGB(212, 170, 80), Ceiling = Color3.fromRGB(40, 38, 44), Light = Color3.fromRGB(255, 226, 170), Front = Color3.fromRGB(46, 44, 50) },
			{ Name = "future", Wall = Color3.fromRGB(232, 236, 244), Floor = Color3.fromRGB(196, 202, 214), Trim = Color3.fromRGB(40, 220, 255), Ceiling = Color3.fromRGB(240, 244, 250), Light = Color3.fromRGB(190, 245, 255), Front = Color3.fromRGB(232, 236, 244) },
		}
		local theme = THEMES[level]
		-- the lot behind follows the same style
		local LOT = { Color3.fromRGB(64, 64, 68), Color3.fromRGB(80, 84, 92), ASPHALT, Color3.fromRGB(44, 44, 50), Color3.fromRGB(176, 184, 198) }
		if plot.LotPart then
			plot.LotPart.Color = LOT[level]
			for _, f in ipairs(plot.FenceParts) do
				f.Color = theme.Name == "street" and Color3.fromRGB(70, 78, 96) or theme.Trim
				f.Material = theme.Name == "future" and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
		end
		local wallColor = theme.Wall
		local trim = theme.Trim

		-- floor, walls, roof
		box(sm, "Floor", Vector3.new(W, FLOOR_Y, D), s(0, FLOOR_Y / 2, D / 2), theme.Floor, nil, { Reflectance = theme.Name == "luxury" and 0.12 or 0 })
		for _, side in ipairs({ -1, 1 }) do
			box(sm, "Wall", Vector3.new(1.2, H, D), s(side * W / 2, FLOOR_Y + H / 2, D / 2), wallColor)
		end
		box(sm, "Roof", Vector3.new(W + 1.6, 1, D + 1.6), s(0, FLOOR_Y + H + 0.5, D / 2), Color3.fromRGB(84, 88, 98))
		deco(sm, "Ceiling", Vector3.new(W - 1.2, 0.4, D - 1.2), s(0, FLOOR_Y + H - 0.2, D / 2), theme.Ceiling)

		-- back wall with a wide open doorway into the lot
		local backDoor = 18
		local bw = (W - backDoor) / 2
		for _, side in ipairs({ -1, 1 }) do
			box(sm, "BackWall", Vector3.new(bw, H, 1.2), s(side * (backDoor / 2 + bw / 2), FLOOR_Y + H / 2, D), wallColor)
		end
		box(sm, "BackHeader", Vector3.new(backDoor, H - 11, 1.2), s(0, FLOOR_Y + 11 + (H - 11) / 2, D), wallColor)
		local lotSign = box(sm, "LotSign", Vector3.new(14, 1.6, 0.4), s(0, FLOOR_Y + 11.9, D - 0.9), trim)
		surfaceText(lotSign, Enum.NormalId.Front, "CONTAINER LOT", Color3.new(1, 1, 1), 24)

		-- front: a wide door with the sign above it
		local doorW = garage and 20 or 16
		local doorH = garage and 10 or 11
		local sideW = (W - doorW) / 2
		for _, side in ipairs({ -1, 1 }) do
			if garage then
				box(sm, "Front", Vector3.new(sideW, H, 1.2), s(side * (doorW / 2 + sideW / 2), FLOOR_Y + H / 2, 0), wallColor)
			else
				box(sm, "FrontPier", Vector3.new(1.6, H, 1.6), s(side * (W / 2 - 0.2), FLOOR_Y + H / 2, 0), theme.Front)
				box(sm, "DoorPier", Vector3.new(1.6, H, 1.6), s(side * (doorW / 2 + 0.8), FLOOR_Y + H / 2, 0), theme.Front)
				window(sm, s(side * (doorW / 2 + sideW / 2), FLOOR_Y + 0.5 + (H - 4) / 2, 0), sideW - 3, H - 4, 2, 1, 0.6)
			end
		end
		box(sm, "Header", Vector3.new(doorW, H - doorH, 1.2), s(0, FLOOR_Y + doorH + (H - doorH) / 2, 0), theme.Front)
		if not garage then
			box(sm, "SignBand", Vector3.new(W + 1, 3, 1.4), s(0, FLOOR_Y + H - 1.5, 0), theme.Front)
		end
		local signBoard = box(sm, "SignBoard", Vector3.new(math.min(W - 8, 34), 2.6, 0.4), s(0, FLOOR_Y + (garage and doorH + 1.5 or H - 1.5), -0.9), trim)
		table.insert(signLabels, surfaceText(signBoard, Enum.NormalId.Front, signText, GOLD, 26))

		-- a few soft ceiling lights
		local k = 0
		for z = 10, D - 8, 16 do
			k = k + 1
			local l = deco(sm, "CeilingLight", Vector3.new(6, 0.12, 2), s(0, FLOOR_Y + H - 0.45, z), theme.Light, Enum.Material.Neon)
			if k % 2 == 1 then
				light(l, 28, 0.35, theme.Light)
			end
		end

		-- style details for each level
		local function decal(id, size, cf, face)
			local panelPart = deco(sm, "Art", size, cf, Color3.new(1, 1, 1), nil, { Transparency = 1 })
			local d = Instance.new("Decal")
			d.Texture = "rbxassetid://" .. id
			d.Face = face
			d.Parent = panelPart
			return panelPart
		end
		local GRAFFITI = { "94240820734263", "131777455527155", "70627886445938" }
		if theme.Name == "street" then
			-- spray-painted walls inside and out, bare warm bulbs
			for i, side in ipairs({ -1, 1 }) do
				for k2, z in ipairs({ D * 0.3, D * 0.7 }) do
					local id = GRAFFITI[(i + k2) % #GRAFFITI + 1]
					decal(id, Vector3.new(0.1, 6, 10.5), s(side * (W / 2 - 0.7), FLOOR_Y + 5.5, z), side < 0 and Enum.NormalId.Right or Enum.NormalId.Left)
				end
			end
			local sw = (W - doorW) / 2
			decal(GRAFFITI[1], Vector3.new(sw - 2, 5.5, 0.1), s(-(doorW / 2 + sw / 2), FLOOR_Y + 5, -0.7), Enum.NormalId.Front)
			decal(GRAFFITI[3], Vector3.new(math.min(sw - 2, 6), 6, 0.1), s(doorW / 2 + sw / 2, FLOOR_Y + 5, -0.7), Enum.NormalId.Front)
			decal(GRAFFITI[2], Vector3.new(14, 7.5, 0.1), s(-W / 2 - 0.7, FLOOR_Y + 5, D * 0.5) * CFrame.Angles(0, math.rad(90), 0), Enum.NormalId.Front)
		elseif theme.Name == "workshop" then
			-- yellow safety lines and a blue stripe along the walls
			for _, side in ipairs({ -1, 1 }) do
				deco(sm, "SafetyLine", Vector3.new(0.5, 0.04, D - 4), s(side * (W / 2 - 4), FLOOR_Y + 0.02, D / 2), Color3.fromRGB(250, 200, 40))
				deco(sm, "WallStripe", Vector3.new(0.2, 1.2, D - 2), s(side * (W / 2 - 0.65), FLOOR_Y + 4, D / 2), trim)
			end
		elseif theme.Name == "luxury" then
			-- gold trim lines, warm light
			for _, side in ipairs({ -1, 1 }) do
				deco(sm, "GoldTrim", Vector3.new(0.2, 0.3, D - 2), s(side * (W / 2 - 0.65), FLOOR_Y + H - 2, D / 2), trim, Enum.Material.Neon)
				deco(sm, "GoldBase", Vector3.new(0.3, 0.5, D - 2), s(side * (W / 2 - 0.7), FLOOR_Y + 0.25, D / 2), trim)
			end
			deco(sm, "Carpet", Vector3.new(8, 0.05, D - 6), s(0, FLOOR_Y + 0.03, D / 2), Color3.fromRGB(120, 24, 36))
		elseif theme.Name == "future" then
			-- glowing cyan lines on the floor edges and ceiling, floor grid
			for _, side in ipairs({ -1, 1 }) do
				deco(sm, "NeonEdge", Vector3.new(0.3, 0.06, D - 2), s(side * (W / 2 - 1.2), FLOOR_Y + 0.03, D / 2), trim, Enum.Material.Neon)
				deco(sm, "NeonCeil", Vector3.new(0.3, 0.2, D - 2), s(side * (W / 2 - 1.2), FLOOR_Y + H - 0.5, D / 2), trim, Enum.Material.Neon)
			end
			for z = 12, D - 6, 12 do
				deco(sm, "GridLine", Vector3.new(W - 4, 0.04, 0.12), s(0, FLOOR_Y + 0.02, z), Color3.fromRGB(150, 230, 255), Enum.Material.Neon)
			end
		end

		-- display spots along the left and right walls, angled toward the aisle (no floor platforms)
		local spots = {}
		for i = 1, perSide do
			for _, side in ipairs({ -1, 1 }) do
				local x = side * (W / 2 - 9)
				local z = 12 + (i - 1) * 10
				local dir = Vector3.new(-side, 0, -0.6)
				local yaw = math.atan2(-dir.X, -dir.Z)
				local cf = s(x, FLOOR_Y + 0.02, z) * CFrame.Angles(0, yaw, 0)
				table.insert(spots, { CFrame = cf, Front = s(side * 4, FLOOR_Y, z - 2) })
			end
		end
		plot.Spots = spots
		plot.DoorOutside = s(0, FLOOR_Y + 2.5, -10).Position
		plot.DoorInside = s(0, FLOOR_Y + 2.5, 6).Position
		plot.SpawnCFrame = CFrame.lookAt(v(0, 3, Z0 - 8), v(0, 3, Z0 + 10))
		applySign()
		return spots
	end

	--=========================== CONTAINER LOT (behind the showroom) ===========================
	local lotD = LOT_Z1 - LOT_Z0
	plot.LotPart = box(m, "Lot", Vector3.new(LOT_HALF * 2, 0.4, lotD), at(0, 0.2, (LOT_Z0 + LOT_Z1) / 2), ASPHALT)
	plot.FenceParts = {}
	-- low fence on the sides; the back stays open where the truck backs in
	local function fenceRun(from, to)
		local dir = to - from
		local len = dir.Magnitude
		local mid = (from + to) / 2
		local cf = CFrame.lookAt(mid, mid + dir.Unit)
		for _, y in ipairs({ 1.6, 3.2 }) do
			table.insert(plot.FenceParts, box(m, "FenceRail", Vector3.new(0.3, 0.5, len), cf * CFrame.new(0, y - mid.Y, 0), Color3.fromRGB(70, 78, 96)))
		end
		local posts = math.max(1, math.floor(len / 12))
		for i = 0, posts do
			table.insert(plot.FenceParts, deco(m, "FencePost", Vector3.new(0.5, 4, 0.5), cf * CFrame.new(0, 2 - mid.Y, -len / 2 + i * len / posts), Color3.fromRGB(70, 78, 96)))
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		fenceRun(v(sx * LOT_HALF, 0, LOT_Z0), v(sx * LOT_HALF, 0, LOT_Z1))
		fenceRun(v(sx * LOT_HALF, 0, LOT_Z1), v(sx * 14, 0, LOT_Z1))
	end
	-- container slots: a tidy grid in front of the truck
	local yardSlots = {}
	for _, z in ipairs({ 150, 162, 174, 186 }) do
		for _, x in ipairs({ -25, -15, -5, 5, 15, 25 }) do
			table.insert(yardSlots, at(x, 0.4, z))
		end
	end
	-- the delivery truck, backed in with its open rear toward the lot
	local TRUCK_Z = LOT_Z1 + 6
	truck(m, at(0, 0, TRUCK_Z) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(236, 239, 245))
	plot.TruckDrop = at(0, 7, TRUCK_Z - 11.5)

	--=========================== WASH SPOT (left side of the lot) ===========================
	local WX, WZ = -48, 176
	local washCF = at(WX, 0.42, WZ)
	local washPad = box(m, "WashPad", Vector3.new(14, 0.1, 20), at(WX, 0.42, WZ), Color3.fromRGB(96, 104, 118), nil, { CanCollide = false })
	local washTiers = {}
	local function tier(n)
		local t = Instance.new("Model")
		t.Name = "WashTier" .. n
		washTiers[n] = t
		return t
	end
	do -- 1: bucket and sponge
		local t = tier(1)
		column(t, "Bucket", 1.6, 1.6, at(WX + 8.5, 1.2, WZ - 6), Color3.fromRGB(60, 130, 220), nil, true)
		deco(t, "Water", Vector3.new(0.05, 1.4, 1.4), at(WX + 8.5, 2, WZ - 6) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(160, 210, 255), Enum.Material.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.2 })
		deco(t, "Sponge", Vector3.new(1, 0.6, 0.7), at(WX + 7.4, 0.75, WZ - 6.3), Color3.fromRGB(255, 220, 60))
	end
	do -- 2: garden hose reel
		local t = tier(2)
		box(t, "ReelStand", Vector3.new(0.4, 3, 2.4), at(WX - 8.5, 1.9, WZ - 7), Color3.fromRGB(40, 140, 60))
		local reel = part({ Name = "Reel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 2.6, 2.6), CFrame = at(WX - 8.2, 2.6, WZ - 7), Color = Color3.fromRGB(60, 170, 70), CanCollide = false, CanQuery = false }, t)
		reel.Size = Vector3.new(0.9, 2.6, 2.6)
	end
	do -- 3: pressure washer cart
		local t = tier(3)
		box(t, "Washer", Vector3.new(2.4, 2.2, 3.2), at(WX + 8.6, 1.6, WZ + 6), Color3.fromRGB(250, 200, 40))
		deco(t, "WasherTop", Vector3.new(2.5, 0.3, 3.3), at(WX + 8.6, 2.8, WZ + 6), Color3.fromRGB(40, 40, 45))
	end
	do -- 4: foam cannon on a stand and blue tiles
		local t = tier(4)
		deco(t, "BlueTiles", Vector3.new(14, 0.08, 20), at(WX, 0.5, WZ), Color3.fromRGB(110, 175, 230))
		box(t, "FoamStand", Vector3.new(0.5, 6, 0.5), at(WX - 8.6, 3.4, WZ + 6), Color3.fromRGB(220, 220, 228), Enum.Material.Metal)
		deco(t, "FoamCannon", Vector3.new(0.9, 0.9, 2.6), at(WX - 8.1, 6.3, WZ + 5.2) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(240, 90, 160))
	end
	do -- 5: covered wash bay
		local t = tier(5)
		for _, x in ipairs({ -7.6, 7.6 }) do
			for _, z in ipairs({ -9.6, 9.6 }) do
				box(t, "BayPost", Vector3.new(0.9, 11, 0.9), at(WX + x, 5.9, WZ + z), Color3.fromRGB(240, 242, 246), Enum.Material.Metal)
			end
		end
		deco(t, "BayRoof", Vector3.new(17, 0.8, 21.6), at(WX, 11.6, WZ), Color3.fromRGB(60, 130, 220))
		local sign = deco(t, "BaySign", Vector3.new(10, 2, 0.3), at(WX, 13, WZ - 10.4), Color3.fromRGB(30, 80, 160))
		surfaceText(sign, Enum.NormalId.Front, "CAR WASH", Color3.new(1, 1, 1), 24)
	end
	do -- 6: automatic car wash brushes
		local t = tier(6)
		for _, x in ipairs({ -6.4, 6.4 }) do
			local b = part({ Name = "Brush", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 2.4, 2.4), CFrame = at(WX + x, 4.8, WZ - 3) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 120, 235), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, t)
			b.Size = Vector3.new(8, 2.4, 2.4)
		end
		deco(t, "TopBrush", Vector3.new(12, 2, 2), at(WX, 9.6, WZ + 3), Color3.fromRGB(60, 120, 235), Enum.Material.Fabric)
	end
	function plot.SetWashTier(level)
		for n, t in ipairs(washTiers) do
			t.Parent = (n <= level) and m or nil
		end
	end
	plot.SetWashTier(1)
	local washLabel = label(washPad, "WASH SPOT", Color3.fromRGB(150, 220, 255), 9, 240)
	washLabel.Parent.Enabled = false

	--=========================== TIRE SHOP (right side of the lot, open toward the middle) ===========================
	local TX, TZ = 47, 176
	local tW, tD, tH = 26, 22, 12
	local tireBase = at(TX, 0, TZ) * CFrame.Angles(0, math.pi / 2, 0)
	local function t(x, y, z)
		return tireBase * CFrame.new(x, y, z)
	end
	box(m, "TireFloor", Vector3.new(tW, FLOOR_Y, tD), t(0, FLOOR_Y / 2, 0), Color3.fromRGB(140, 142, 148))
	for _, side in ipairs({ -1, 1 }) do
		box(m, "TireWall", Vector3.new(1, tH, tD), t(side * tW / 2, FLOOR_Y + tH / 2, 0), Color3.fromRGB(190, 72, 62))
	end
	box(m, "TireBack", Vector3.new(tW, tH, 1), t(0, FLOOR_Y + tH / 2, tD / 2), Color3.fromRGB(190, 72, 62))
	box(m, "TireRoof", Vector3.new(tW + 2, 0.8, tD + 2), t(0, FLOOR_Y + tH + 0.4, 0), Color3.fromRGB(70, 74, 84))
	local shopSign = box(m, "TireSign", Vector3.new(14, 2.6, 0.4), t(0, FLOOR_Y + tH - 1.2, -tD / 2 - 0.3), NAVY)
	surfaceText(shopSign, Enum.NormalId.Front, "TIRE SHOP", GOLD, 26)
	local lightPart = deco(m, "ShopLight", Vector3.new(8, 0.3, 1), t(0, FLOOR_Y + tH - 0.5, 0), LAMP, Enum.Material.Neon)
	light(lightPart, 24, 0.5)
	local lift = box(m, "TireLift", Vector3.new(12, 0.12, 18), t(0, FLOOR_Y + 0.06, 0), Color3.fromRGB(120, 124, 132), nil, { CanCollide = false })
	for _, x in ipairs({ -6.6, 6.6 }) do
		box(m, "LiftPost", Vector3.new(1.2, 10, 1.4), t(x, FLOOR_Y + 5, 0), Color3.fromRGB(250, 195, 40))
	end
	deco(m, "LiftTop", Vector3.new(14.4, 0.8, 1.2), t(0, FLOOR_Y + 10.2, 0), Color3.fromRGB(250, 195, 40))
	local liftLabel = label(lift, "TIRE SHOP", Color3.fromRGB(255, 215, 100), 10, 240)
	liftLabel.Parent.Enabled = false

	--=========================== UPGRADE STATIONS (a row just behind the showroom) ===========================
	local function icon(kind, at0)
		local mdl = Instance.new("Model")
		mdl.Name = "StationIcon"
		-- the painted icon artwork floating over the pad
		local imageId = Icons.Images[({ Showroom = "Showroom", Truck = "Truck", Wash = "Sponge", Engine = "Tire" })[kind] or ""]
		if imageId and imageId ~= "" then
			local anchor = deco(mdl, "IconAnchor", Vector3.new(0.2, 0.2, 0.2), at0, Color3.new(1, 1, 1), nil, { Transparency = 1 })
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.new(4.6, 0, 4.6, 0)
			bb.LightInfluence = 0
			bb.MaxDistance = 140
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.Size = UDim2.new(1, 0, 1, 0)
			img.Image = "rbxassetid://" .. imageId
			img.Parent = bb
			bb.Parent = anchor
			mdl.PrimaryPart = anchor
			mdl.Parent = m
			CollectionService:AddTag(mdl, "StationIcon")
			return mdl
		end
		local function ip(size, off, color, mat, shape)
			local q = deco(mdl, "IconPart", size, at0 * off, color, mat or Enum.Material.SmoothPlastic)
			if shape then
				q.Shape = shape
				q.Size = size
			end
			return q
		end
		if kind == "Showroom" then
			ip(Vector3.new(3, 1.6, 2), CFrame.new(0, 0, 0), Color3.fromRGB(240, 225, 190))
			for x = -1.1, 1.1, 0.73 do
				ip(Vector3.new(0.35, 1.5, 0.35), CFrame.new(x, 0, -1.1), Color3.fromRGB(250, 245, 230))
			end
			ip(Vector3.new(3.4, 0.35, 2.6), CFrame.new(0, 0.95, -0.15), Color3.fromRGB(200, 160, 90))
			local roof = Instance.new("WedgePart")
			roof.Anchored, roof.CanCollide, roof.CanQuery = true, false, false
			roof.Size = Vector3.new(3.4, 0.9, 1.3)
			roof.Color = Color3.fromRGB(200, 160, 90)
			roof.CFrame = at0 * CFrame.new(0, 1.55, -0.8)
			roof.Parent = mdl
			ip(Vector3.new(3.6, 0.3, 2.8), CFrame.new(0, -0.95, -0.2), Color3.fromRGB(220, 205, 170))
		elseif kind == "Wash" then
			ip(Vector3.new(2.8, 1.5, 1.9), CFrame.new(0, 0, 0), Color3.fromRGB(255, 220, 60))
			for _, h in ipairs({ { -0.7, 0.3 }, { 0.5, -0.2 }, { 0.9, 0.4 }, { -0.2, -0.3 } }) do
				ip(Vector3.new(0.12, 0.45, 0.45), CFrame.new(h[1], h[2], -0.96) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(220, 170, 30), nil, Enum.PartType.Cylinder)
			end
			for _, b in ipairs({ { -1.3, 1, 0.5 }, { 1.2, 1.1, 0.4 }, { 0, 1.3, 0.6 } }) do
				ip(Vector3.new(b[3], b[3], b[3]), CFrame.new(b[1], b[2], 0), Color3.fromRGB(220, 240, 255), Enum.Material.Glass, Enum.PartType.Ball)
			end
		elseif kind == "Engine" then
			ip(Vector3.new(2.6, 1.4, 1.6), CFrame.new(0, -0.1, 0), Color3.fromRGB(205, 60, 50), Enum.Material.Metal)
			for x = -0.9, 0.9, 0.6 do
				ip(Vector3.new(0.45, 0.8, 0.45), CFrame.new(x, 0.9, 0), Color3.fromRGB(200, 200, 210), Enum.Material.Metal)
			end
			for k, c in ipairs({ { 0.9, 0.9 }, { 1.35, 0.55 }, { 0.95, 0.35 } }) do
				ip(Vector3.new(0.6, 0.6, 0.6), CFrame.new(c[1], c[2] + 0.4, -0.9), Color3.fromRGB(60, 190, 70), nil, Enum.PartType.Ball)
				if k == 1 then
					ip(Vector3.new(0.12, 0.6, 0.12), CFrame.new(1.05, 0.3, -0.9), Color3.fromRGB(40, 140, 50))
				end
			end
		elseif kind == "Truck" then
			ip(Vector3.new(1.9, 1.7, 2.6), CFrame.new(0, 0.2, 0.5), Color3.fromRGB(235, 240, 248))
			ip(Vector3.new(1.8, 1.2, 1), CFrame.new(0, -0.05, -1.3), Color3.fromRGB(110, 170, 240))
			ip(Vector3.new(1.4, 0.5, 0.05), CFrame.new(0, 0.2, -1.82), Color3.fromRGB(40, 60, 90), Enum.Material.Glass)
			for _, w in ipairs({ { -0.95, -1.2 }, { 0.95, -1.2 }, { -0.95, 1.1 }, { 0.95, 1.1 } }) do
				ip(Vector3.new(0.3, 0.75, 0.75), CFrame.new(w[1], -0.7, w[2]), Color3.fromRGB(30, 30, 32), nil, Enum.PartType.Cylinder)
			end
		end
		mdl.Parent = m
		CollectionService:AddTag(mdl, "StationIcon")
		return mdl
	end
	local function pad(name, x, z, y, kind, facing)
		y = y or FLOOR_Y
		local base = at(x, y, z) * CFrame.Angles(0, facing or 0, 0)
		box(m, name .. "Plinth", Vector3.new(6.6, 0.5, 6.6), base * CFrame.new(0, 0.25, 0), Color3.fromRGB(176, 184, 196), Enum.Material.Concrete, { CanCollide = false })
		local p = box(m, name, Vector3.new(5.6, 0.18, 5.6), base * CFrame.new(0, 0.55, 0), Color3.fromRGB(90, 215, 130), Enum.Material.Neon, { CanCollide = false, Transparency = 0.55 })
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(150, 255, 190)
		glow.Range = 9
		glow.Brightness = 0.4
		glow.Parent = p
		local ic = icon(kind, base * CFrame.new(0, 4.4, 0))
		-- the name above the icon and the level under it
		local anchor = deco(m, name .. "Anchor", Vector3.new(0.2, 0.2, 0.2), base * CFrame.new(0, 4.4, 0), Color3.new(1, 1, 1), nil, { Transparency = 1 })
		local title = label(anchor, name, Color3.new(1, 1, 1), 2.6, 140, 45)
		title.Parent.Size = UDim2.new(3.9, 0, 0.95, 0)
		local lv = label(anchor, "Level 1", Color3.fromRGB(255, 225, 120), -2.2, 120, 30)
		lv.Parent.Size = UDim2.new(3.3, 0, 0.7, 0)
		-- price plate on the floor, angled up toward the player
		local plate = box(m, name .. "Price", Vector3.new(5.2, 0.35, 1.8), base * CFrame.new(0, 0.35, -4.9) * CFrame.Angles(math.rad(-14), 0, 0), Color3.fromRGB(60, 200, 80), nil, { CanCollide = false })
		local priceGui = Instance.new("SurfaceGui")
		priceGui.Face = Enum.NormalId.Top
		priceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		priceGui.PixelsPerStud = 40
		priceGui.LightInfluence = 0
		local priceText = Instance.new("TextLabel")
		priceText.BackgroundTransparency = 1
		priceText.Size = UDim2.new(1, 0, 1, 0)
		priceText.Font = Enum.Font.FredokaOne
		priceText.TextScaled = true
		priceText.TextColor3 = Color3.new(1, 1, 1)
		priceText.Rotation = 180
		priceText.Text = "$0"
		addStroke(priceText, 3)
		priceText.Parent = priceGui
		priceGui.Parent = plate
		return { Part = p, Label = lv, Title = title, Plate = plate, Price = priceText, Icon = ic }
	end
	local pads = {
		Showroom = pad("Showroom Size", -46, 138, 0.4, "Showroom"),
		Truck = pad("Truck Tier", -32, 138, 0.4, "Truck"),
		Wash = pad("Car Wash", 32, 138, 0.4, "Wash"),
		Engine = pad("Tire Luck", 46, 138, 0.4, "Engine"),
	}

	plot.WashCFrame = washCF
	plot.LiftCFrame = t(0, FLOOR_Y + 1.4, 0)
	plot.WashLabel = washLabel
	plot.LiftLabel = liftLabel
	plot.YardSlots = yardSlots
	plot.Pads = pads
	plot.BuildShowroom(1)
	return plot
end

function MapBuilder.Build()
	buildLighting()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	buildWorld(map)
	local plots = {}
	for i = 1, Config.MaxPlots do
		plots[i] = buildPlot(i, map)
	end
	return { Folder = map, Plots = plots }
end

return MapBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000014"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000013"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000012"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- D2D client: HUD, delivery timer, wash view (scrubbing), tire view, Index and messages.
-- UI style: cream panels with brown borders, chunky colored buttons, icon buttons on the left.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local Juice = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Juice"))
local Icons = require(Shared:WaitForChild("Icons"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local NotifyEvent = remotes:WaitForChild("Notify")
local ScrubEvent = remotes:WaitForChild("Scrub")
local RevealEvent = remotes:WaitForChild("Reveal")
local OpenEngineEvent = remotes:WaitForChild("OpenEngine")
local GoHomeEvent = remotes:WaitForChild("GoHome")
local EngineAction = remotes:WaitForChild("EngineAction")
local ClaimToken = remotes:WaitForChild("ClaimToken")
local YardAction = remotes:WaitForChild("YardAction")
local OfflineEvent = remotes:WaitForChild("Offline")

---------------------------------------------------------------------
-- Theme
---------------------------------------------------------------------
local CREAM = Color3.fromRGB(255, 244, 222)
local CREAM_DARK = Color3.fromRGB(246, 226, 190)
local BROWN = Color3.fromRGB(128, 82, 46)
local TEXT_DARK = Color3.fromRGB(92, 58, 32)
local GREEN_TEXT = Color3.fromRGB(40, 150, 60)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(25, 20, 18)
local GOLD = Color3.fromRGB(255, 205, 60)
local BTN = {
	Green = Color3.fromRGB(90, 200, 90),
	Orange = Color3.fromRGB(255, 150, 50),
	Red = Color3.fromRGB(240, 85, 75),
	Blue = Color3.fromRGB(80, 160, 255),
	Yellow = Color3.fromRGB(255, 205, 60),
	Cream = CREAM_DARK,
}

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = p
end
local function stroke(p, color, t)
	local s = Instance.new("UIStroke")
	s.Color = color or BLACK
	s.Thickness = t or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end
local function textStroke(l, t)
	local s = Instance.new("UIStroke")
	s.Color = BLACK
	s.Thickness = t or 2
	s.Parent = l
	return s
end
local function shine(p, amount)
	local g = Instance.new("UIGradient")
	local a = amount or 0.2
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1 - a, 1 - a, 1 - a))
	g.Rotation = 90
	g.Parent = p
	return g
end
-- outlined white text (for text over the 3D world)
local function text(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = WHITE
	l.TextScaled = true
	textStroke(l, props.StrokeThickness or 2)
	props.StrokeThickness = nil
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end
-- flat dark-brown text (for text on cream panels)
local function inkText(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = TEXT_DARK
	l.TextScaled = true
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function playSound(id, volume)
	if id == "" then
		return
	end
	local snd = Instance.new("Sound")
	snd.SoundId = id
	snd.Volume = volume or 0.5
	snd.Parent = SoundService
	SoundService:PlayLocalSound(snd)
	task.delay(3, function()
		snd:Destroy()
	end)
end
-- sound ids: fill these with sounds from the Creator Store (Toolbox > Audio) that the game may use
local SOUND_CLICK, SOUND_PING, SOUND_SWOOSH = "", "", ""

local function juicy(b)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local function to(v)
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = v }):Play()
	end
	b.MouseEnter:Connect(function()
		to(1.06)
	end)
	b.MouseLeave:Connect(function()
		to(1)
	end)
	b.MouseButton1Down:Connect(function()
		to(0.92)
	end)
	b.MouseButton1Up:Connect(function()
		to(1.06)
	end)
	b.Activated:Connect(function()
		playSound(SOUND_CLICK, 0.4)
	end)
end

-- Painted UI kit (generated art, 9-sliced so it stretches to any size without blurring corners)
local UI_ART = {
	Green = { Id = "rbxassetid://112756175701104", W = 749, H = 298 },
	Blue = { Id = "rbxassetid://131173130754843", W = 755, H = 305 },
	Red = { Id = "rbxassetid://139684477436323", W = 759, H = 291 },
	Gold = { Id = "rbxassetid://119845650258438", W = 759, H = 328 },
	Panel = { Id = "rbxassetid://119283926119895", W = 748, H = 738 },
	Bar = { Id = "rbxassetid://130594728260397", W = 750, H = 149 },
	Close = "rbxassetid://105507747717488",
}
local function artFor(color)
	if color == BTN.Green then
		return UI_ART.Green
	elseif color == BTN.Blue then
		return UI_ART.Blue
	elseif color == BTN.Red then
		return UI_ART.Red
	elseif color == BTN.Yellow or color == BTN.Orange then
		return UI_ART.Gold
	end
	return nil
end
-- a pill image sliced so its round caps keep their shape at any button size
local function slicedPill(parent, art)
	local img = Instance.new("ImageLabel")
	img.Name = "Art"
	img.BackgroundTransparency = 1
	img.Size = UDim2.new(1, 0, 1, 0)
	img.Image = art.Id
	img.ScaleType = Enum.ScaleType.Slice
	local cap = math.floor(art.H / 2)
	img.SliceCenter = Rect.new(cap, math.floor(art.H * 0.3), art.W - cap, math.floor(art.H * 0.7))
	local function fit()
		local h = img.AbsoluteSize.Y
		if h > 0 then
			-- caps are half the image height; scale them to half the button height
			img.SliceScale = math.max(0.05, h / art.H)
		end
	end
	img:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	img.Parent = parent
	return img
end

-- Glossy push button: painted pill art, white outlined text, presses down when clicked.
-- Setting button.Text / TextColor3 later still works.
local function button(parent, props, color)
	color = color or BTN.Green
	local art = artFor(color)
	local isClose = props.Text == "X"
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.TextTransparency = 1
	b.Text = ""
	local face
	if isClose then
		face = Instance.new("ImageLabel")
		face.Name = "Face"
		face.BackgroundTransparency = 1
		face.Image = UI_ART.Close
		face.ScaleType = Enum.ScaleType.Fit
		face.Size = UDim2.new(1, 0, 1, 0)
	elseif art then
		face = Instance.new("Frame")
		face.Name = "Face"
		face.BackgroundTransparency = 1
		face.Size = UDim2.new(1, 0, 1, 0)
		slicedPill(face, art)
	else
		-- plain colours (cream etc.) keep the drawn style
		b.BackgroundTransparency = 0
		b.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.38)
		corner(b, 14)
		stroke(b, BLACK, 3)
		face = Instance.new("Frame")
		face.Name = "Face"
		face.BorderSizePixel = 0
		face.Size = UDim2.new(1, 0, 1, -6)
		face.BackgroundColor3 = WHITE
		corner(face, 13)
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Color = ColorSequence.new(color:Lerp(WHITE, 0.22), color)
		g.Parent = face
	end
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 14, 0.2, 0)
	label.Size = UDim2.new(1, -28, 0.56, 0)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WHITE
	label.ZIndex = 3
	label.Visible = not isClose
	textStroke(label, 2.5)
	label.Parent = face
	face.Parent = b
	for k, v in pairs(props) do
		if k == "Text" then
			label.Text = v
		elseif k == "TextColor3" then
			label.TextColor3 = v
		else
			b[k] = v
		end
	end
	b:GetPropertyChangedSignal("Text"):Connect(function()
		label.Text = b.Text
	end)
	b:GetPropertyChangedSignal("TextColor3"):Connect(function()
		label.TextColor3 = b.TextColor3
	end)
	local pressScale = Instance.new("UIScale")
	pressScale.Parent = face
	b.MouseButton1Down:Connect(function()
		TweenService:Create(pressScale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	local function release()
		TweenService:Create(pressScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	juicy(b)
	b.Parent = parent
	return b
end

-- the little white key badge ("E", "Q") on a button
local function keyBadge(b, key)
	local k = Instance.new("TextLabel")
	k.AnchorPoint = Vector2.new(0, 0.5)
	k.Position = UDim2.new(0, -2, 0.5, 0)
	k.Size = UDim2.new(0, 34, 0, 34)
	k.BackgroundColor3 = WHITE
	k.Font = Enum.Font.FredokaOne
	k.TextScaled = true
	k.TextColor3 = BLACK
	k.Text = key
	k.ZIndex = 5
	corner(k, 8)
	stroke(k, BLACK, 2)
	k.Parent = b
	return k
end

-- cream "paper" panel: the painted panel art, 9-sliced so the thick rounded frame keeps its shape
local function panel(parent, props)
	local f = Instance.new("ImageLabel")
	f.BackgroundTransparency = 1
	f.Image = UI_ART.Panel.Id
	f.ScaleType = Enum.ScaleType.Slice
	f.SliceCenter = Rect.new(110, 110, UI_ART.Panel.W - 110, UI_ART.Panel.H - 110)
	f.SliceScale = 0.32
	for k, v in pairs(props) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

