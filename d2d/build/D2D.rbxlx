	</Item></Item><Item class="ServerScriptService" referent="RBX0000000C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: loads and saves each player's progress.
-- Saving in Studio needs Game Settings > Security > "Enable Studio Access to API Services".

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local store
local ok, err = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not ok then
	warn("[D2D] Saving is off: " .. tostring(err))
end

local profiles = {}

local function default()
	return {
		Cash = 0,
		Tokens = 0,
		ShowroomLevel = 1,
		TruckLevel = 1,
		ToolLevel = 1,
		EngineLuck = 0,
		Display = {}, -- { {Id=, Engine=, Spot=} }
		Discovered = {}, -- [carId] = true
		Claimed = {}, -- [carId] = true
		Completed = {}, -- [containerIndex as string] = true
		Yard = {}, -- { {Kind="Container", Level=} or {Kind="Car", Id=} }
		DeliveriesDone = 0,
		LastOnline = 0,
		IncomeRate = 0,
	}
end

local function num(v, lo, hi, fallback)
	if type(v) ~= "number" or v ~= v then
		return fallback
	end
	return math.clamp(math.floor(v), lo, hi)
end

local function sanitize(data)
	local p = default()
	if type(data) ~= "table" then
		return p
	end
	if type(data.Cash) == "number" and data.Cash == data.Cash then
		p.Cash = math.max(0, data.Cash)
	end
	p.Tokens = num(data.Tokens, 0, 1e6, 0)
	p.ShowroomLevel = num(data.ShowroomLevel, 1, Config.MaxShowroomLevel, 1)
	p.TruckLevel = num(data.TruckLevel, 1, Config.MaxTruckLevel, 1)
	p.ToolLevel = num(data.ToolLevel, 1, #Config.WashTools, 1)
	p.EngineLuck = num(data.EngineLuck, 0, Config.MaxEngineLuck, 0)
	p.DeliveriesDone = num(data.DeliveriesDone, 0, 1e9, 0)
	p.LastOnline = type(data.LastOnline) == "number" and data.LastOnline or 0
	p.IncomeRate = type(data.IncomeRate) == "number" and math.max(0, data.IncomeRate) or 0
	local maxSpots = p.ShowroomLevel * Config.SpotsPerLevel
	if type(data.Display) == "table" then
		local used = {}
		for _, d in ipairs(data.Display) do
			if type(d) == "table" and Config.CarsById[d.Id] and type(d.Spot) == "number" then
				local spot = math.floor(d.Spot)
				if spot >= 1 and spot <= maxSpots and not used[spot] then
					used[spot] = true
					table.insert(p.Display, { Id = d.Id, Engine = num(d.Engine, 1, #Config.Engines, 1), Spot = spot })
				end
			end
		end
	end
	for _, key in ipairs({ "Discovered", "Claimed" }) do
		if type(data[key]) == "table" then
			for id, v in pairs(data[key]) do
				if v and Config.CarsById[id] then
					p[key][id] = true
				end
			end
		end
	end
	if type(data.Completed) == "table" then
		for k, v in pairs(data.Completed) do
			if v and tonumber(k) then
				p.Completed[tostring(k)] = true
			end
		end
	end
	if type(data.Yard) == "table" then
		for _, y in ipairs(data.Yard) do
			if #p.Yard >= Config.YardCapacity then
				break
			end
			if type(y) == "table" then
				if y.Kind == "Container" and type(y.Level) == "number" and Config.Containers[y.Level] then
					table.insert(p.Yard, { Kind = "Container", Level = y.Level })
				elseif y.Kind == "Car" and Config.CarsById[y.Id] then
					table.insert(p.Yard, { Kind = "Car", Id = y.Id })
				end
			end
		end
	end
	return p
end

function DataService.Load(player)
	local data
	if store then
		local success, result = pcall(function()
			return store:GetAsync("player_" .. player.UserId)
		end)
		if success then
			data = result
		else
			warn("[D2D] Load failed for " .. player.Name .. ": " .. tostring(result))
		end
	end
	local profile = sanitize(data)
	profiles[player] = profile
	return profile
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	local success, result = pcall(function()
		store:SetAsync("player_" .. player.UserId, profile)
	end)
	if not success then
		warn("[D2D] Save failed for " .. player.Name .. ": " .. tostring(result))
	end
end

function DataService.Release(player)
	profiles[player] = nil
end

return DataService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000009"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- D2D (Dust to Dealership) - main server script.
-- Truck delivers containers -> open -> wash to 100% -> roll an engine -> display -> NPC customers pay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))

local rng = Random.new()

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className, name)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyEvent = remote("RemoteEvent", "Notify")
local ScrubEvent = remote("RemoteEvent", "Scrub")
local RevealEvent = remote("RemoteEvent", "Reveal")
local OpenEngineEvent = remote("RemoteEvent", "OpenEngine")
local GoHomeEvent = remote("RemoteEvent", "GoHome")
local EngineAction = remote("RemoteFunction", "EngineAction")
local ClaimToken = remote("RemoteFunction", "ClaimToken")

local GOLD = Color3.fromRGB(255, 220, 80)
local RED = Color3.fromRGB(255, 110, 110)
local GREEN = Color3.fromRGB(120, 255, 150)

local function notify(player, text, color)
	NotifyEvent:FireClient(player, text, color or Color3.new(1, 1, 1))
end
local function notifyAll(text, color)
	NotifyEvent:FireAllClients(text, color or Color3.new(1, 1, 1))
end
local function now()
	return workspace:GetServerTimeNow()
end

---------------------------------------------------------------------
-- Map and state
---------------------------------------------------------------------
local map = MapBuilder.Build()
local carsFolder = Instance.new("Folder")
carsFolder.Name = "Cars"
carsFolder.Parent = map.Folder
local dirtFolder = Instance.new("Folder")
dirtFolder.Name = "Dirt"
dirtFolder.Parent = map.Folder
local npcFolder = Instance.new("Folder")
npcFolder.Name = "NPCs"
npcFolder.Parent = map.Folder

local plotOwner = {} -- [plotIndex] = player
local playerPlot = {} -- [player] = plot
local state = {} -- [plotIndex] = { Spots, Yard, Wash, Lift, NPCs }
local lastScrub = {}

for i = 1, #map.Plots do
	state[i] = { Spots = {}, Yard = {}, Wash = nil, Lift = nil, NPCs = 0 }
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function getRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function rarityOf(carId)
	return Config.Rarities[Config.CarsById[carId].Rarity]
end

local function setCash(player, amount)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	profile.Cash = math.max(0, amount)
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Cash") then
		ls.Cash.Value = profile.Cash
	end
end
local function addCash(player, amount)
	local profile = DataService.Get(player)
	if profile then
		setCash(player, profile.Cash + amount)
	end
end

local function completedCount(profile)
	local n = 0
	for _ in pairs(profile.Completed) do
		n = n + 1
	end
	return n
end

local function syncAttributes(player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	player:SetAttribute("Tokens", profile.Tokens)
	player:SetAttribute("ShowroomLevel", profile.ShowroomLevel)
	player:SetAttribute("TruckLevel", profile.TruckLevel)
	player:SetAttribute("ToolLevel", profile.ToolLevel)
	player:SetAttribute("EngineLuck", profile.EngineLuck)
	player:SetAttribute("Completed", completedCount(profile))
	local d, c = {}, {}
	for id in pairs(profile.Discovered) do
		table.insert(d, id)
	end
	for id in pairs(profile.Claimed) do
		table.insert(c, id)
	end
	player:SetAttribute("Discovered", table.concat(d, ","))
	player:SetAttribute("Claimed", table.concat(c, ","))
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Cars") then
		ls.Cars.Value = #d
	end
end

local function addLabel(adornee, title, subtitle, color, offsetY)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.new(0, 260, 0, 58)
	gui.StudsOffset = Vector3.new(0, offsetY or 6, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, 0, 0.55, 0)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.2
	t.Text = title
	t.Parent = gui
	local s = Instance.new("TextLabel")
	s.BackgroundTransparency = 1
	s.Position = UDim2.new(0, 0, 0.55, 0)
	s.Size = UDim2.new(1, 0, 0.45, 0)
	s.Font = Enum.Font.GothamBold
	s.TextScaled = true
	s.TextColor3 = Color3.new(1, 1, 1)
	s.TextStrokeTransparency = 0.3
	s.Text = subtitle or ""
	s.Parent = gui
	gui.Parent = adornee
	return gui, t, s
end

local function addPrompt(parentPart, action, object, hold, owner, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	if owner then
		prompt:SetAttribute("OwnerUserId", owner.UserId)
		CollectionService:AddTag(prompt, "OwnerPrompt")
	end
	prompt.Triggered:Connect(callback)
	prompt.Parent = parentPart
	return prompt
end

local function carTitle(carId)
	return Config.CarsById[carId].Name
end

local function carSubtitle(carId, engineIndex)
	local r = rarityOf(carId)
	local s = string.upper(r.Name) .. " · " .. Config.GetOddsText(carId)
	if engineIndex then
		s = s .. " · $" .. Config.FormatNumber(Config.GetCarIncome(carId, engineIndex)) .. "/s"
	end
	return s
end

---------------------------------------------------------------------
-- Showroom spots
---------------------------------------------------------------------
local function maxSpots(profile)
	return profile.ShowroomLevel * Config.SpotsPerLevel
end

local function refreshSpotPads(plot, profile)
	local open = profile and maxSpots(profile) or 0
	for i, spot in ipairs(plot.Spots) do
		local unlocked = i <= open
		spot.Pad.Transparency = unlocked and 0 or 1
		for _, trim in ipairs(spot.Trims or {}) do
			trim.Transparency = unlocked and 0 or 0.75
		end
	end
end

local sellSpot -- forward declaration

local function showSpot(plot, spotIndex, entry)
	local owner = plotOwner[plot.Index]
	if entry.Model then
		entry.Model:Destroy()
	end
	local model = CarBuilder.BuildCar(entry.Id, { Engine = entry.Engine })
	model:PivotTo(plot.Spots[spotIndex].CFrame)
	addLabel(model.PrimaryPart, carTitle(entry.Id), carSubtitle(entry.Id, entry.Engine), rarityOf(entry.Id).Color, 7)
	local value = Config.GetCarIncome(entry.Id, entry.Engine) * Config.SellSeconds
	addPrompt(model:FindFirstChild("Body"), "Sell $" .. Config.FormatNumber(value), carTitle(entry.Id), 1, owner, function(player)
		sellSpot(player, plot, spotIndex, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
end

local function freeSpot(plot, profile)
	for i = 1, maxSpots(profile) do
		if not state[plot.Index].Spots[i] then
			return i
		end
	end
	return nil
end

sellSpot = function(player, plot, spotIndex, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Spots[spotIndex] ~= entry then
		return
	end
	state[plot.Index].Spots[spotIndex] = nil
	if entry.Model then
		entry.Model:Destroy()
	end
	local value = Config.GetCarIncome(entry.Id, entry.Engine) * Config.SellSeconds
	addCash(player, value)
	notify(player, "Sold " .. carTitle(entry.Id) .. " for $" .. Config.FormatNumber(value), GOLD)
end

---------------------------------------------------------------------
-- Discovery and the Index
---------------------------------------------------------------------
local function discover(player, carId)
	local profile = DataService.Get(player)
	local isNew = not profile.Discovered[carId]
	profile.Discovered[carId] = true
	if isNew then
		local car = Config.CarsById[carId]
		local key = tostring(car.Container)
		if not profile.Completed[key] then
			local all = true
			for _, id in ipairs(Config.Containers[car.Container].CarIds) do
				if not profile.Discovered[id] then
					all = false
					break
				end
			end
			if all then
				profile.Completed[key] = true
				profile.Tokens = profile.Tokens + Config.TokensPerCompletion
				notify(player, "Container " .. car.Container .. " COMPLETE! +5% income and +" .. Config.TokensPerCompletion .. " tokens", GOLD)
			end
		end
	end
	syncAttributes(player)
	return isNew
end

ClaimToken.OnServerInvoke = function(player, carId)
	local profile = DataService.Get(player)
	if not profile or type(carId) ~= "string" or not profile.Discovered[carId] or profile.Claimed[carId] then
		return false
	end
	profile.Claimed[carId] = true
	profile.Tokens = profile.Tokens + 1
	syncAttributes(player)
	return true
end

---------------------------------------------------------------------
-- Yard: containers and opened cars
---------------------------------------------------------------------
local spawnYardCar -- forward declaration
local sendToWash -- forward declaration

local function freeYardSlot(plot)
	for i = 1, #plot.YardSlots do
		if not state[plot.Index].Yard[i] then
			return i
		end
	end
	return nil
end

local function yardCount(plot)
	local n = 0
	for i = 1, #plot.YardSlots do
		if state[plot.Index].Yard[i] then
			n = n + 1
		end
	end
	return n
end

local function openContainer(player, plot, slot, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Yard[slot] ~= entry then
		return
	end
	entry.Model:Destroy()
	state[plot.Index].Yard[slot] = nil
	local carId = Config.RollCar(entry.Level, rng)
	local isNew = discover(player, carId)
	spawnYardCar(plot, slot, carId)
	RevealEvent:FireClient(player, carId, isNew)
	local car = Config.CarsById[carId]
	if car.Rarity >= 6 then
		notifyAll(player.DisplayName .. " found a " .. string.upper(rarityOf(carId).Name) .. " car: " .. car.Name .. "!", rarityOf(carId).Color)
	end
end

local function spawnContainer(plot, slot, level, drop)
	local owner = plotOwner[plot.Index]
	local entry = { Kind = "Container", Level = level }
	local model = CarBuilder.BuildContainer(level)
	local target = plot.YardSlots[slot]
	model:PivotTo(drop and (target + Vector3.new(0, 40, 0)) or target)
	addLabel(model.PrimaryPart, "CONTAINER " .. level, Config.Containers[level].Name, Config.Containers[level].Color:Lerp(Color3.new(1, 1, 1), 0.4), 9)
	addPrompt(model:FindFirstChild("Box"), "Open", "Container " .. level, 0.6, owner, function(player)
		openContainer(player, plot, slot, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
	state[plot.Index].Yard[slot] = entry
	if drop then
		local value = Instance.new("CFrameValue")
		value.Value = model:GetPivot()
		value.Changed:Connect(function(cf)
			if model.Parent then
				model:PivotTo(cf)
			end
		end)
		local tween = TweenService:Create(value, TweenInfo.new(1.2, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Value = target })
		tween:Play()
		tween.Completed:Connect(function()
			value:Destroy()
		end)
	end
end

spawnYardCar = function(plot, slot, carId)
	local owner = plotOwner[plot.Index]
	local entry = { Kind = "Car", Id = carId }
	local model = CarBuilder.BuildCar(carId)
	model:PivotTo(plot.YardSlots[slot])
	-- a dusty look until it's washed
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			p.Color = p.Color:Lerp(Config.Containers[Config.CarsById[carId].Container].Dirt, 0.6)
		end
	end
	addLabel(model.PrimaryPart, carTitle(carId) .. " (dirty)", carSubtitle(carId), rarityOf(carId).Color, 7)
	addPrompt(model:FindFirstChild("Body"), "Send to Wash Bay", carTitle(carId), 0.3, owner, function(player)
		sendToWash(player, plot, slot, entry)
	end)
	model.Parent = carsFolder
	entry.Model = model
	state[plot.Index].Yard[slot] = entry
end

---------------------------------------------------------------------
-- Wash bay
---------------------------------------------------------------------
local moveToLift -- forward declaration

local function dirtHealth(containerLevel)
	return math.min(4, math.ceil(containerLevel / 3))
end

local function setWashProgress(plot, value)
	local owner = plotOwner[plot.Index]
	if owner then
		owner:SetAttribute("WashProgress", value)
	end
	if value then
		plot.WashLabel.Text = "WASHING  " .. math.floor(value * 100) .. "%"
	else
		plot.WashLabel.Text = "WASH BAY"
	end
end

local function finishWash(plot)
	local wash = state[plot.Index].Wash
	if not wash or wash.Done then
		return
	end
	wash.Done = true
	for _, b in ipairs(wash.Blobs) do
		b.Part:Destroy()
	end
	wash.Blobs = {}
	setWashProgress(plot, nil)
	plot.WashLabel.Text = "SPARKLING CLEAN!"
	local owner = plotOwner[plot.Index]
	if owner then
		notify(owner, "Sparkling clean! " .. carTitle(wash.Id) .. " is ready for an engine.", GREEN)
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.Parent = wash.Model:FindFirstChild("Body")
	if not state[plot.Index].Lift then
		task.delay(1.2, function()
			moveToLift(plot)
		end)
	else
		addPrompt(wash.Model:FindFirstChild("Body"), "Move to Engine Lift", carTitle(wash.Id), 0, owner, function(player)
			if plotOwner[plot.Index] == player then
				if state[plot.Index].Lift then
					notify(player, "The engine lift is busy. Finish that car first!", RED)
				else
					moveToLift(plot)
				end
			end
		end)
	end
end

local function startWash(plot, carId)
	local car = Config.CarsById[carId]
	local model = CarBuilder.BuildCar(carId)
	model:PivotTo(plot.WashCFrame)
	model.Parent = carsFolder
	local health = dirtHealth(car.Container)
	local dirtColor = Config.Containers[car.Container].Dirt
	local boxCF, size = model:GetBoundingBox()
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local blobs = {}
	-- only the visible parts of the car catch dirt
	local visible = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.9 then
			table.insert(visible, d)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = visible
	local taken = {}
	local function blob(fromLocal, dirLocal)
		local origin = boxCF:PointToWorldSpace(fromLocal)
		local dir = boxCF:VectorToWorldSpace(dirLocal)
		local hit = workspace:Raycast(origin, dir, params)
		if not hit then
			return
		end
		local pos = hit.Position
		local key = math.floor(pos.X / 1.2) .. "," .. math.floor(pos.Y / 1.2) .. "," .. math.floor(pos.Z / 1.2)
		if taken[key] then
			return
		end
		taken[key] = true
		-- a flat mud splat lying on the paint
		local s = rng:NextNumber(1.3, 2.1)
		local p = Instance.new("Part")
		p.Name = "Dirt"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.18, s, s)
		p.CFrame = CFrame.lookAt(pos + hit.Normal * 0.06, pos + hit.Normal * 2) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(rng:NextNumber(0, 6.28), 0, 0)
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Sand
		p.Color = dirtColor:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.2))
		p.Parent = dirtFolder
		table.insert(blobs, { Part = p, Health = health, StartSize = s })
	end
	-- shoot rays at the car from above and from all four sides; dirt sticks where they land
	local spacing = 1.25
	local reach = 2 * math.max(hx, hy, hz) + 4
	for x = -hx + 0.6, hx - 0.6, spacing do
		for z = -hz + 0.6, hz - 0.6, spacing do
			blob(Vector3.new(x + rng:NextNumber(-0.4, 0.4), hy + 2, z + rng:NextNumber(-0.4, 0.4)), Vector3.new(0, -reach, 0))
		end
	end
	for y = -hy + 0.8, hy - 0.4, spacing do
		for z = -hz + 0.6, hz - 0.6, spacing do
			blob(Vector3.new(hx + 2, y, z), Vector3.new(-reach, 0, 0))
			blob(Vector3.new(-hx - 2, y, z), Vector3.new(reach, 0, 0))
		end
		for x = -hx + 0.6, hx - 0.6, spacing do
			blob(Vector3.new(x, y, hz + 2), Vector3.new(0, 0, -reach))
			blob(Vector3.new(x, y, -hz - 2), Vector3.new(0, 0, reach))
		end
	end
	local wash = {
		Id = carId,
		Model = model,
		Blobs = blobs,
		Total = #blobs * health,
		Remaining = #blobs * health,
		Health = health,
		Done = false,
	}
	state[plot.Index].Wash = wash
	setWashProgress(plot, 0)

	-- the Automatic Car Wash cleans by itself
	local owner = plotOwner[plot.Index]
	local profile = owner and DataService.Get(owner)
	if profile and Config.WashTools[profile.ToolLevel].Auto then
		task.spawn(function()
			local steps = 40
			for i = 1, steps do
				task.wait(8 / steps)
				if state[plot.Index].Wash ~= wash or wash.Done then
					return
				end
				local removeCount = math.ceil(#wash.Blobs / (steps - i + 1))
				for _ = 1, removeCount do
					local b = table.remove(wash.Blobs)
					if b then
						b.Part:Destroy()
					end
				end
				setWashProgress(plot, i / steps)
			end
			finishWash(plot)
		end)
	end
end

sendToWash = function(player, plot, slot, entry)
	if plotOwner[plot.Index] ~= player or state[plot.Index].Yard[slot] ~= entry then
		return
	end
	if state[plot.Index].Wash then
		notify(player, "The wash bay is busy. Finish washing the current car first!", RED)
		return
	end
	state[plot.Index].Yard[slot] = nil
	entry.Model:Destroy()
	startWash(plot, entry.Id)
	-- bring the player to the wash bay so they can start scrubbing right away
	local char = player.Character
	if char then
		local stand = plot.WashCFrame.Position + Vector3.new(10.5, 3, 0)
		char:PivotTo(CFrame.lookAt(stand, Vector3.new(plot.WashCFrame.X, stand.Y, plot.WashCFrame.Z)))
	end
	notify(player, "Hold the mouse (or your finger) over the dirt to scrub it off!", Color3.fromRGB(150, 220, 255))
end

ScrubEvent.OnServerEvent:Connect(function(player, hitPosition)
	if typeof(hitPosition) ~= "Vector3" then
		return
	end
	local t = os.clock()
	if lastScrub[player] and t - lastScrub[player] < Config.ScrubInterval * 0.6 then
		return
	end
	lastScrub[player] = t
	local plot = playerPlot[player]
	local wash = plot and state[plot.Index].Wash
	local profile = DataService.Get(player)
	if not wash or wash.Done or not profile then
		return
	end
	local root = getRoot(player)
	local center = plot.WashCFrame.Position
	if not root or (root.Position - center).Magnitude > 40 or (hitPosition - center).Magnitude > 22 then
		return
	end
	local tool = Config.WashTools[profile.ToolLevel]
	for i = #wash.Blobs, 1, -1 do
		local b = wash.Blobs[i]
		if (b.Part.Position - hitPosition).Magnitude <= tool.Radius + b.Part.Size.X / 2 then
			local dmg = math.min(tool.Power, b.Health)
			b.Health = b.Health - dmg
			wash.Remaining = wash.Remaining - dmg
			if b.Health <= 0 then
				b.Part:Destroy()
				table.remove(wash.Blobs, i)
			else
				local sz = b.StartSize * (0.5 + 0.5 * b.Health / wash.Health)
				b.Part.Size = Vector3.new(0.18, sz, sz)
			end
		end
	end
	local progress = 1 - wash.Remaining / math.max(1, wash.Total)
	setWashProgress(plot, progress)
	if #wash.Blobs == 0 or progress >= 0.94 then
		finishWash(plot)
	end
end)

---------------------------------------------------------------------
-- Engine lift
---------------------------------------------------------------------
local function rebuildLift(plot)
	local lift = state[plot.Index].Lift
	if not lift then
		return
	end
	if lift.Model then
		lift.Model:Destroy()
	end
	local owner = plotOwner[plot.Index]
	local model = CarBuilder.BuildCar(lift.Id, { Engine = lift.Engine })
	model:PivotTo(plot.LiftCFrame)
	addLabel(model.PrimaryPart, carTitle(lift.Id), carSubtitle(lift.Id, lift.Engine), rarityOf(lift.Id).Color, 8)
	addPrompt(model:FindFirstChild("Body"), "Choose Engine", carTitle(lift.Id), 0, owner, function(player)
		if plotOwner[plot.Index] == player and state[plot.Index].Lift == lift then
			OpenEngineEvent:FireClient(player, lift.Id, lift.Engine)
		end
	end)
	model.Parent = carsFolder
	lift.Model = model
end

moveToLift = function(plot)
	local wash = state[plot.Index].Wash
	if not wash or not wash.Done or state[plot.Index].Lift then
		return
	end
	wash.Model:Destroy()
	state[plot.Index].Wash = nil
	plot.WashLabel.Text = "WASH BAY"
	state[plot.Index].Lift = { Id = wash.Id, Engine = nil }
	rebuildLift(plot)
	plot.LiftLabel.Text = "ENGINE LIFT"
	local owner = plotOwner[plot.Index]
	if owner then
		OpenEngineEvent:FireClient(owner, wash.Id, nil)
	end
end

local function rollEngine(profile, lucky)
	local weights = Config.GetEngineWeights(profile.EngineLuck, lucky)
	return Config.WeightedIndex(weights, rng)
end

EngineAction.OnServerInvoke = function(player, action)
	local plot = playerPlot[player]
	local profile = DataService.Get(player)
	local lift = plot and state[plot.Index].Lift
	if not profile or not lift then
		return { Ok = false, Message = "There's no car on the engine lift." }
	end
	if action == "Roll" or action == "Lucky" then
		if action == "Lucky" then
			if profile.Tokens < 1 then
				return { Ok = false, Message = "You need 1 token. Collect tokens in the Index!" }
			end
			profile.Tokens = profile.Tokens - 1
			syncAttributes(player)
		end
		lift.Engine = rollEngine(profile, action == "Lucky")
		rebuildLift(plot)
		local engine = Config.Engines[lift.Engine]
		if lift.Engine >= 6 then
			notifyAll(player.DisplayName .. " rolled a " .. engine.Name .. "!", engine.Color)
		end
		return { Ok = true, Engine = lift.Engine, Income = Config.GetCarIncome(lift.Id, lift.Engine) }
	elseif action == "Done" then
		if not lift.Engine then
			return { Ok = false, Message = "Roll an engine first!" }
		end
		local spot = freeSpot(plot, profile)
		if not spot then
			return { Ok = false, Message = "Your showroom is full! Sell a car or upgrade the showroom." }
		end
		lift.Model:Destroy()
		state[plot.Index].Lift = nil
		local entry = { Id = lift.Id, Engine = lift.Engine }
		state[plot.Index].Spots[spot] = entry
		showSpot(plot, spot, entry)
		notify(player, carTitle(lift.Id) .. " is on display! Customers are on the way.", GREEN)
		if state[plot.Index].Wash and state[plot.Index].Wash.Done then
			task.delay(0.5, function()
				moveToLift(plot)
			end)
		end
		return { Ok = true, Done = true }
	elseif action == "Sell" then
		local value = Config.GetCarIncome(lift.Id, lift.Engine or 1) * Config.SellSeconds
		lift.Model:Destroy()
		state[plot.Index].Lift = nil
		addCash(player, value)
		notify(player, "Sold " .. carTitle(lift.Id) .. " for $" .. Config.FormatNumber(value), GOLD)
		if state[plot.Index].Wash and state[plot.Index].Wash.Done then
			task.delay(0.5, function()
				moveToLift(plot)
			end)
		end
		return { Ok = true, Done = true }
	end
	return { Ok = false }
end

---------------------------------------------------------------------
-- Upgrade pads
---------------------------------------------------------------------
local function refreshPads(plot)
	local owner = plotOwner[plot.Index]
	local profile = owner and DataService.Get(owner)
	local pads = plot.Pads
	if not profile then
		pads.Showroom.Label.Text = "Showroom"
		pads.Truck.Label.Text = "Truck"
		pads.Wash.Label.Text = "Wash Tools"
		pads.Engine.Label.Text = "Engine Luck"
		return
	end
	if profile.ShowroomLevel >= Config.MaxShowroomLevel then
		pads.Showroom.Label.Text = "Showroom MAX"
	else
		pads.Showroom.Label.Text = "Showroom Lv " .. (profile.ShowroomLevel + 1) .. " · $" .. Config.FormatNumber(Config.GetShowroomCost(profile.ShowroomLevel + 1))
	end
	if profile.TruckLevel >= Config.MaxTruckLevel then
		pads.Truck.Label.Text = "Truck MAX"
	else
		local nextLevel = profile.TruckLevel + 1
		if nextLevel > Config.MaxTruckForShowroom[profile.ShowroomLevel] then
			pads.Truck.Label.Text = "Truck Lv " .. nextLevel .. " · needs bigger showroom"
		else
			pads.Truck.Label.Text = "Truck Lv " .. nextLevel .. " (" .. nextLevel .. " containers) · $" .. Config.FormatNumber(Config.TruckCosts[nextLevel])
		end
	end
	if profile.ToolLevel >= #Config.WashTools then
		pads.Wash.Label.Text = Config.WashTools[profile.ToolLevel].Name .. " (MAX)"
	else
		local t = Config.WashTools[profile.ToolLevel + 1]
		pads.Wash.Label.Text = t.Name .. " · $" .. Config.FormatNumber(t.Cost)
	end
	if profile.EngineLuck >= Config.MaxEngineLuck then
		pads.Engine.Label.Text = "Engine Luck MAX"
	else
		pads.Engine.Label.Text = "Engine Luck Lv " .. (profile.EngineLuck + 1) .. " · $" .. Config.FormatNumber(Config.GetEngineLuckCost(profile.EngineLuck))
	end
end

local function tryBuy(player, cost, apply)
	local profile = DataService.Get(player)
	if profile.Cash < cost then
		notify(player, "You need $" .. Config.FormatNumber(cost) .. ".", RED)
		return
	end
	setCash(player, profile.Cash - cost)
	apply(profile)
	syncAttributes(player)
	local plot = playerPlot[player]
	if plot then
		refreshPads(plot)
		refreshSpotPads(plot, profile)
	end
end

for _, plot in ipairs(map.Plots) do
	local function padPrompt(padKey, handler)
		addPrompt(plot.Pads[padKey].Part, "Upgrade", "", 0.4, nil, function(player)
			if playerPlot[player] ~= plot then
				notify(player, "That's someone else's upgrade pad.", RED)
				return
			end
			handler(player, DataService.Get(player))
		end)
	end
	padPrompt("Showroom", function(player, profile)
		if profile.ShowroomLevel >= Config.MaxShowroomLevel then
			return notify(player, "Your showroom is maxed!", GOLD)
		end
		tryBuy(player, Config.GetShowroomCost(profile.ShowroomLevel + 1), function(p)
			p.ShowroomLevel = p.ShowroomLevel + 1
			notify(player, "Showroom level " .. p.ShowroomLevel .. "! " .. maxSpots(p) .. " display spots, container " .. p.ShowroomLevel .. " unlocked.", GREEN)
		end)
	end)
	padPrompt("Truck", function(player, profile)
		local nextLevel = profile.TruckLevel + 1
		if nextLevel > Config.MaxTruckLevel then
			return notify(player, "Your truck is maxed!", GOLD)
		end
		if nextLevel > Config.MaxTruckForShowroom[profile.ShowroomLevel] then
			return notify(player, "Upgrade your showroom first to unlock a bigger truck.", RED)
		end
		tryBuy(player, Config.TruckCosts[nextLevel], function(p)
			p.TruckLevel = nextLevel
			notify(player, "Truck level " .. nextLevel .. "! " .. nextLevel .. " containers per delivery.", GREEN)
		end)
	end)
	padPrompt("Wash", function(player, profile)
		if profile.ToolLevel >= #Config.WashTools then
			return notify(player, "You have the best wash tool!", GOLD)
		end
		local t = Config.WashTools[profile.ToolLevel + 1]
		tryBuy(player, t.Cost, function(p)
			p.ToolLevel = p.ToolLevel + 1
			notify(player, "New tool: " .. t.Name .. "!", GREEN)
		end)
	end)
	padPrompt("Engine", function(player, profile)
		if profile.EngineLuck >= Config.MaxEngineLuck then
			return notify(player, "Engine Luck is maxed!", GOLD)
		end
		tryBuy(player, Config.GetEngineLuckCost(profile.EngineLuck), function(p)
			p.EngineLuck = p.EngineLuck + 1
			notify(player, "Engine Luck level " .. p.EngineLuck .. "! Better engines are more likely.", GREEN)
		end)
	end)
	refreshPads(plot)
	refreshSpotPads(plot, nil)
end

---------------------------------------------------------------------
-- Truck deliveries
---------------------------------------------------------------------
local function scheduleNext(player)
	local profile = DataService.Get(player)
	local delay = Config.FirstDeliveries[profile.DeliveriesDone + 1] or Config.DeliveryInterval
	player:SetAttribute("NextDelivery", now() + delay)
end

local function rollContainerLevel(profile)
	local highest = math.min(profile.ShowroomLevel, #Config.Containers)
	local r = rng:NextNumber()
	if r < 0.5 or highest == 1 then
		return highest
	elseif r < 0.8 then
		return math.max(1, highest - 1)
	end
	return rng:NextInteger(1, highest)
end

local function deliver(player)
	local plot = playerPlot[player]
	local profile = DataService.Get(player)
	if not plot or not profile then
		return
	end
	local delivered = 0
	for _ = 1, profile.TruckLevel do
		local slot = freeYardSlot(plot)
		if not slot then
			break
		end
		spawnContainer(plot, slot, rollContainerLevel(profile), true)
		delivered = delivered + 1
	end
	if delivered > 0 then
		profile.DeliveriesDone = profile.DeliveriesDone + 1
		notify(player, "TRUCK HERE! " .. delivered .. " container" .. (delivered > 1 and "s" or "") .. " dropped in your backyard.", GOLD)
	end
	scheduleNext(player)
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local t = now()
		for player, plot in pairs(playerPlot) do
			local nextAt = player:GetAttribute("NextDelivery")
			if nextAt and t >= nextAt then
				if freeYardSlot(plot) then
					player:SetAttribute("YardFull", false)
					deliver(player)
				else
					player:SetAttribute("YardFull", true)
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Income (every second) and NPC customers
---------------------------------------------------------------------
local function plotIncome(plot, profile)
	local total = 0
	for _, entry in pairs(state[plot.Index].Spots) do
		total = total + Config.GetCarIncome(entry.Id, entry.Engine)
	end
	return total * (1 + Config.CompletionBonus * completedCount(profile))
end

task.spawn(function()
	while true do
		task.wait(1)
		for player, plot in pairs(playerPlot) do
			local profile = DataService.Get(player)
			if profile then
				local income = plotIncome(plot, profile)
				profile.IncomeRate = income
				player:SetAttribute("IncomeRate", income)
				if income > 0 then
					addCash(player, income)
				end
			end
		end
	end
end)

local function buildNPC()
	local model = Instance.new("Model")
	model.Name = "Customer"
	local shirt = Color3.fromHSV(rng:NextNumber(), 0.6, 0.9)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(2, 2, 1)
	body.Color = shirt
	body.Anchored = true
	body.CanCollide = false
	body.Parent = model
	local function attach(name, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Size = size
		p.Color = color
		p.CFrame = body.CFrame * CFrame.new(offset)
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		p.Parent = model
		return p
	end
	local skins = { Color3.fromRGB(255, 214, 170), Color3.fromRGB(235, 180, 130), Color3.fromRGB(190, 130, 90), Color3.fromRGB(120, 80, 55) }
	local skin = skins[rng:NextInteger(1, #skins)]
	local pants = Color3.fromHSV(rng:NextNumber(), 0.4, rng:NextNumber(0.25, 0.5))
	local hair = Color3.fromHSV(rng:NextNumber(0.02, 0.12), 0.6, rng:NextNumber(0.15, 0.6))
	body.Material = Enum.Material.SmoothPlastic
	attach("Head", Vector3.new(1.5, 1.5, 1.5), Vector3.new(0, 1.8, 0), skin, Enum.PartType.Ball)
	attach("Hair", Vector3.new(1.6, 0.6, 1.6), Vector3.new(0, 2.35, 0.1), hair)
	for _, x in ipairs({ -0.3, 0.3 }) do
		attach("Eye", Vector3.new(0.18, 0.28, 0.1), Vector3.new(x, 1.9, -0.72), Color3.fromRGB(20, 20, 25))
		attach("Arm", Vector3.new(0.6, 1.9, 0.6), Vector3.new(x > 0 and 1.3 or -1.3, -0.05, 0), shirt:Lerp(skin, 0.15))
		attach("Hand", Vector3.new(0.55, 0.45, 0.55), Vector3.new(x > 0 and 1.3 or -1.3, -1.15, 0), skin)
		attach("Leg", Vector3.new(0.9, 1.8, 0.95), Vector3.new(x > 0 and 0.5 or -0.5, -1.9, 0), pants)
		attach("Shoe", Vector3.new(0.95, 0.35, 1.2), Vector3.new(x > 0 and 0.5 or -0.5, -2.85, -0.1), Color3.fromRGB(240, 240, 240))
	end
	model.PrimaryPart = body
	return model, body
end

-- Real Roblox characters as customers (R15 rig with random skin and clothes colors).
-- Falls back to the simple block customer if the rig can't be made.
local WALK_ANIM = "rbxassetid://507777826" -- Roblox's default R15 walk
local IDLE_ANIM = "rbxassetid://507766388" -- Roblox's default R15 idle
local function buildRigNPC()
	local desc = Instance.new("HumanoidDescription")
	local skins = { Color3.fromRGB(255, 214, 170), Color3.fromRGB(234, 184, 146), Color3.fromRGB(196, 140, 100), Color3.fromRGB(124, 84, 60) }
	local skin = skins[rng:NextInteger(1, #skins)]
	local shirt = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.35, 0.7), rng:NextNumber(0.6, 0.95))
	local pants = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.2, 0.5), rng:NextNumber(0.2, 0.45))
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = "Customer"
	local root = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	root.Anchored = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	model.PrimaryPart = root
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local tracks = {}
	for name, id in pairs({ Walk = WALK_ANIM, Idle = IDLE_ANIM }) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok then
			track.Looped = true
			tracks[name] = track
		end
	end
	model:SetAttribute("Rig", true)
	local height = hum.HipHeight + root.Size.Y / 2
	return model, root, tracks, height
end

local function walk(body, target, speed)
	local from = body.Position
	local dist = (target - from).Magnitude
	if dist < 0.1 then
		return
	end
	local look = Vector3.new(target.X, from.Y, target.Z)
	if (look - from).Magnitude > 0.1 then
		body.CFrame = CFrame.lookAt(from, look)
	end
	local tween = TweenService:Create(body, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(target, target + (target - from).Unit) })
	tween:Play()
	tween.Completed:Wait()
end

local function runCustomer(plot)
	local spots = {}
	for i, entry in pairs(state[plot.Index].Spots) do
		table.insert(spots, { Index = i, Entry = entry })
	end
	if #spots == 0 then
		return
	end
	local pick = spots[rng:NextInteger(1, #spots)]
	local model, body, tracks, height
	local ok0 = pcall(function()
		model, body, tracks, height = buildRigNPC()
	end)
	if not ok0 or not model then
		model, body = buildNPC()
		tracks, height = {}, 2.95
	end
	local y = 1 + height
	local function play(name)
		for n, t in pairs(tracks) do
			if n == name then
				if not t.IsPlaying then
					t:Play(0.2)
				end
			else
				t:Stop(0.2)
			end
		end
	end
	body.CFrame = CFrame.new(plot.DoorOutside.X + rng:NextNumber(-4, 4), y, plot.DoorOutside.Z)
	model.Parent = npcFolder
	state[plot.Index].NPCs = state[plot.Index].NPCs + 1
	local ok = pcall(function()
		local inside = Vector3.new(plot.DoorInside.X, y, plot.DoorInside.Z)
		local front = plot.Spots[pick.Index].Front.Position
		play("Walk")
		walk(body, inside, 9)
		walk(body, Vector3.new(front.X + rng:NextNumber(-2, 2), y, front.Z), 9)
		play("Idle")
		-- admire the car and pay
		local entry = state[plot.Index].Spots[pick.Index]
		if entry then
			local amount = Config.GetCarIncome(entry.Id, entry.Engine) * 3
			local gui, t = addLabel(body, "+$" .. Config.FormatNumber(amount), "Wow!", GREEN, 3)
			t.TextColor3 = GREEN
			task.wait(2.5)
			gui:Destroy()
		else
			task.wait(1)
		end
		play("Walk")
		walk(body, inside, 9)
		walk(body, Vector3.new(plot.DoorOutside.X + rng:NextNumber(-6, 6), y, plot.DoorOutside.Z), 9)
	end)
	if not ok then
		warn("[D2D] customer walk failed")
	end
	model:Destroy()
	state[plot.Index].NPCs = state[plot.Index].NPCs - 1
end

task.spawn(function()
	while true do
		task.wait(3)
		for player, plot in pairs(playerPlot) do
			local profile = DataService.Get(player)
			if profile then
				local limit = math.min(1 + math.floor(profile.ShowroomLevel / 2), 6)
				if state[plot.Index].NPCs < limit and next(state[plot.Index].Spots) then
					task.spawn(runCustomer, plot)
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Players joining and leaving
---------------------------------------------------------------------
local function setupCharacter(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	task.wait()
	local plot = playerPlot[player]
	if plot then
		character:PivotTo(plot.SpawnCFrame)
	end
end

local function onPlayerAdded(player)
	local profile = DataService.Load(player)
	if player.Parent ~= Players then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Value = profile.Cash
	cash.Parent = ls
	local cars = Instance.new("IntValue")
	cars.Name = "Cars"
	cars.Parent = ls
	ls.Parent = player

	local plot
	for i, p in ipairs(map.Plots) do
		if not plotOwner[i] then
			plot = p
			break
		end
	end
	if plot then
		plotOwner[plot.Index] = player
		playerPlot[player] = plot
		player:SetAttribute("PlotIndex", plot.Index)
		plot.SignLabel.Text = string.upper(player.DisplayName) .. "'S SHOWROOM"
		for _, d in ipairs(profile.Display) do
			local entry = { Id = d.Id, Engine = d.Engine }
			state[plot.Index].Spots[d.Spot] = entry
			showSpot(plot, d.Spot, entry)
		end
		for i, y in ipairs(profile.Yard) do
			if y.Kind == "Container" then
				spawnContainer(plot, i, y.Level, false)
			else
				spawnYardCar(plot, i, y.Id)
			end
		end
		refreshPads(plot)
		refreshSpotPads(plot, profile)
	else
		notify(player, "All showrooms are taken, sorry! Try another server.", RED)
	end
	syncAttributes(player)

	-- offline earnings
	if profile.LastOnline > 0 and profile.IncomeRate > 0 then
		local away = math.min(os.time() - profile.LastOnline, Config.OfflineMaxSeconds)
		local earned = math.floor(away * profile.IncomeRate * Config.OfflineRate)
		if earned >= 1 then
			addCash(player, earned)
			task.delay(4, function()
				if player.Parent == Players then
					notify(player, "Welcome back! Your showroom earned $" .. Config.FormatNumber(earned) .. " while you were away.", GOLD)
				end
			end)
		end
	end
	if plot then
		scheduleNext(player)
	end

	player.CharacterAdded:Connect(function(character)
		setupCharacter(player, character)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
end

local function collectSave(player)
	local profile = DataService.Get(player)
	local plot = playerPlot[player]
	if not profile or not plot then
		return
	end
	local s = state[plot.Index]
	profile.Display = {}
	for spot, entry in pairs(s.Spots) do
		table.insert(profile.Display, { Id = entry.Id, Engine = entry.Engine, Spot = spot })
	end
	profile.Yard = {}
	-- cars in the wash bay or on the lift go back to the yard
	if s.Lift then
		table.insert(profile.Yard, { Kind = "Car", Id = s.Lift.Id })
	end
	if s.Wash then
		table.insert(profile.Yard, { Kind = "Car", Id = s.Wash.Id })
	end
	for i = 1, #plot.YardSlots do
		local y = s.Yard[i]
		if y and #profile.Yard < Config.YardCapacity then
			if y.Kind == "Container" then
				table.insert(profile.Yard, { Kind = "Container", Level = y.Level })
			else
				table.insert(profile.Yard, { Kind = "Car", Id = y.Id })
			end
		end
	end
	profile.LastOnline = os.time()
end

local function clearPlot(plot)
	local s = state[plot.Index]
	for _, entry in pairs(s.Spots) do
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	for _, entry in pairs(s.Yard) do
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	if s.Wash then
		for _, b in ipairs(s.Wash.Blobs) do
			b.Part:Destroy()
		end
		s.Wash.Model:Destroy()
	end
	if s.Lift and s.Lift.Model then
		s.Lift.Model:Destroy()
	end
	state[plot.Index] = { Spots = {}, Yard = {}, Wash = nil, Lift = nil, NPCs = s.NPCs }
	plot.SignLabel.Text = "FOR SALE"
	plot.WashLabel.Text = "WASH BAY"
	plot.LiftLabel.Text = "ENGINE LIFT"
end

local function onPlayerRemoving(player)
	collectSave(player)
	DataService.Save(player)
	local plot = playerPlot[player]
	if plot then
		clearPlot(plot)
		plotOwner[plot.Index] = nil
		playerPlot[player] = nil
		refreshPads(plot)
		refreshSpotPads(plot, nil)
	end
	lastScrub[player] = nil
	DataService.Release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(onPlayerRemoving)

GoHomeEvent.OnServerEvent:Connect(function(player)
	local plot = playerPlot[player]
	if plot and player.Character then
		player.Character:PivotTo(plot.SpawnCFrame)
	end
end)

game:BindToClose(function()
	local running = 0
	for _, player in ipairs(Players:GetPlayers()) do
		running = running + 1
		task.spawn(function()
			collectSave(player)
			DataService.Save(player)
			running = running - 1
		end)
	end
	local waited = 0
	while running > 0 and waited < 25 do
		waited = waited + task.wait(0.5)
	end
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			collectSave(player)
			task.spawn(DataService.Save, player)
		end
	end
end)

print("[D2D] Server ready!")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder: builds the world and the 6 player plots when the server starts.
-- Style: clean realistic-cartoon town (white plaster buildings, navy trim, black-framed windows,
-- wood ceilings with recessed lights, low-poly trees, terraced cliffs).
-- Each plot, front to back: showroom (by the street) -> workshop (wash bay, engine lift) -> backyard lot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local PLOT_SPACING = 110
local FLOOR_Y = 1
local rng = Random.new(2026)

-- palette
local PLASTER = Color3.fromRGB(236, 233, 224)
local PLASTER_SHADE = Color3.fromRGB(214, 210, 200)
local NAVY = Color3.fromRGB(34, 44, 64)
local STONE = Color3.fromRGB(150, 150, 155)
local TILE = Color3.fromRGB(188, 193, 202)
local GROUT = Color3.fromRGB(140, 146, 158)
local WOOD = Color3.fromRGB(205, 165, 115)
local GLASS = Color3.fromRGB(150, 190, 215)
local LAMP = Color3.fromRGB(255, 250, 238)
local ASPHALT = Color3.fromRGB(96, 98, 104)
local CONCRETE = Color3.fromRGB(196, 196, 200)
local LEAF = { Color3.fromRGB(86, 150, 62), Color3.fromRGB(104, 168, 70), Color3.fromRGB(74, 134, 58), Color3.fromRGB(120, 176, 78) }
local GOLD = Color3.fromRGB(255, 205, 80)

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Shape" then
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- solid building piece
local function box(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props, parent)
end

-- decoration: no collisions, no raycasts, never blocks the camera
local function deco(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false, CanTouch = false }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props, parent)
end

-- upright cylinder
local function column(parent, name, height, diameter, cf, color, material, solid)
	local p = part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CanCollide = solid or false,
		CanQuery = solid or false,
	}, parent)
	p.Size = Vector3.new(height, diameter, diameter)
	return p
end

local function ball(parent, name, d, cf, color, material)
	local p = part({ Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false }, parent)
	p.Size = Vector3.new(d, d, d)
	return p
end

local function addStroke(l, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2.5
	s.Color = Color3.fromRGB(20, 20, 30)
	s.Parent = l
end

local function label(adornee, text, color, offsetY, width, maxDist)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, width or 220, 0, 48)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = maxDist or 90
	gui.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Text = text
	addStroke(l, 2.5)
	l.Parent = gui
	gui.Parent = adornee
	return l
end

local function surfaceText(p, face, text, color, pps, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps or 30
	gui.LightInfluence = 0.2
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Font = font or Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Text = text
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.Parent = l
	l.Parent = gui
	gui.Parent = p
	return l
end

local function light(parent, range, brightness, color)
	local l = Instance.new("PointLight")
	l.Color = color or Color3.fromRGB(255, 244, 225)
	l.Range = range or 28
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = parent
	return l
end

---------------------------------------------------------------------
-- Building parts
---------------------------------------------------------------------

-- A window: glass with a navy frame and mullions. `cf` is the window center, facing -Z.
local function window(parent, cf, width, height, cols, rows, glassTransparency, glassColor)
	deco(parent, "Glass", Vector3.new(width, height, 0.2), cf, glassColor or GLASS, Enum.Material.Glass, { Transparency = glassTransparency or 0.4, Reflectance = 0.2 })
	local t = 0.45
	deco(parent, "Frame", Vector3.new(width + t, t, 0.5), cf * CFrame.new(0, height / 2, 0), NAVY)
	deco(parent, "Frame", Vector3.new(width + t, t, 0.5), cf * CFrame.new(0, -height / 2, 0), NAVY)
	deco(parent, "Frame", Vector3.new(t, height + t, 0.5), cf * CFrame.new(-width / 2, 0, 0), NAVY)
	deco(parent, "Frame", Vector3.new(t, height + t, 0.5), cf * CFrame.new(width / 2, 0, 0), NAVY)
	for c = 1, cols - 1 do
		deco(parent, "Mullion", Vector3.new(0.22, height, 0.35), cf * CFrame.new(-width / 2 + c * width / cols, 0, 0), NAVY)
	end
	for r = 1, rows - 1 do
		deco(parent, "Mullion", Vector3.new(width, 0.22, 0.35), cf * CFrame.new(0, -height / 2 + r * height / rows, 0), NAVY)
	end
	-- stone sill under the window
	deco(parent, "Sill", Vector3.new(width + 1, 0.35, 1.1), cf * CFrame.new(0, -height / 2 - 0.4, -0.3), PLASTER_SHADE)
end

local function lowPolyTree(parent, pos, scale)
	scale = scale or 1
	local trunkColor = Color3.fromRGB(120, 78, 52)
	local h = 7 * scale
	local lean = rng:NextNumber(-0.12, 0.12)
	deco(parent, "Trunk", Vector3.new(1.1 * scale, h, 1.1 * scale), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(lean, rng:NextNumber(0, 6), 0), trunkColor)
	deco(parent, "Branch", Vector3.new(0.7 * scale, 3 * scale, 0.7 * scale), CFrame.new(pos + Vector3.new(0.8 * scale, h * 0.75, 0)) * CFrame.Angles(0, 0, math.rad(-35)), trunkColor)
	local top = pos + Vector3.new(0, h + 1.2 * scale, 0)
	local pieces = {
		{ Vector3.new(0, 0, 0), 6.2 },
		{ Vector3.new(2.3, -0.8, 0.8), 4.2 },
		{ Vector3.new(-2.1, -0.6, -0.9), 4.4 },
		{ Vector3.new(0.4, 2, -0.4), 4 },
		{ Vector3.new(-0.6, -0.4, 2.2), 3.6 },
	}
	for _, pc in ipairs(pieces) do
		local s = pc[2] * scale
		local color = LEAF[rng:NextInteger(1, #LEAF)]
		deco(parent, "Leaves", Vector3.new(s, s * 0.85, s), CFrame.new(top + pc[1] * scale) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5)), color)
	end
end

local function cypress(parent, pos, height)
	height = height or 6
	local green = Color3.fromRGB(80, 140, 70)
	column(parent, "Cypress", height, 2.2, CFrame.new(pos + Vector3.new(0, height / 2 + 0.6, 0)), green, Enum.Material.Grass)
	ball(parent, "CypressTop", 2.2, CFrame.new(pos + Vector3.new(0, height + 0.6, 0)), green, Enum.Material.Grass)
	ball(parent, "CypressBottom", 2.2, CFrame.new(pos + Vector3.new(0, 0.6 + 1.1, 0)), green, Enum.Material.Grass)
end

local function planter(parent, cf, length, withCypress)
	box(parent, "Planter", Vector3.new(length, 1.6, 2.4), cf * CFrame.new(0, 0.8, 0), NAVY)
	deco(parent, "Soil", Vector3.new(length - 0.4, 0.1, 2), cf * CFrame.new(0, 1.62, 0), Color3.fromRGB(80, 60, 45))
	local n = math.max(1, math.floor(length / 2.6))
	for i = 1, n do
		local x = -length / 2 + (i - 0.5) * length / n
		if withCypress and (i == 1 or i == n) then
			cypress(parent, (cf * CFrame.new(x, 1, 0)).Position, 5)
		else
			ball(parent, "Shrub", 2.4, cf * CFrame.new(x, 2.2, 0), LEAF[rng:NextInteger(1, #LEAF)], Enum.Material.Grass)
		end
	end
end

local function streetLamp(parent, pos, facing)
	column(parent, "LampPole", 13, 0.5, CFrame.new(pos + Vector3.new(0, 6.5, 0)), NAVY, Enum.Material.Metal, true)
	deco(parent, "LampArm", Vector3.new(0.35, 0.35, 2.6), CFrame.new(pos + Vector3.new(0, 12.9, facing * 1.2)), NAVY, Enum.Material.Metal)
	local head = deco(parent, "LampHead", Vector3.new(1.3, 0.5, 1.8), CFrame.new(pos + Vector3.new(0, 12.7, facing * 2.4)), NAVY, Enum.Material.Metal)
	deco(parent, "LampBulb", Vector3.new(1.1, 0.1, 1.5), head.CFrame * CFrame.new(0, -0.28, 0), LAMP, Enum.Material.Neon)
end

local function bench(parent, cf)
	deco(parent, "BenchSeat", Vector3.new(6, 0.4, 1.8), cf * CFrame.new(0, 1.6, 0), WOOD, Enum.Material.Wood)
	deco(parent, "BenchBack", Vector3.new(6, 1.4, 0.3), cf * CFrame.new(0, 2.6, 0.8) * CFrame.Angles(math.rad(-10), 0, 0), WOOD, Enum.Material.Wood)
	for _, x in ipairs({ -2.6, 2.6 }) do
		deco(parent, "BenchLeg", Vector3.new(0.3, 1.5, 1.8), cf * CFrame.new(x, 0.75, 0), NAVY, Enum.Material.Metal)
	end
end

local function cardboardBox(parent, cf, s)
	deco(parent, "Box", Vector3.new(s, s * 0.8, s), cf, Color3.fromRGB(196, 150, 100), Enum.Material.Cardboard)
	deco(parent, "Tape", Vector3.new(0.3, s * 0.81, s * 1.01), cf, Color3.fromRGB(225, 200, 150))
end

local function truck(parent, cf, color)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	box(parent, "TruckCab", Vector3.new(8, 6.5, 6.5), at(0, 4.6, -11.5), color, nil, { Reflectance = 0.1 })
	deco(parent, "TruckRoof", Vector3.new(7.6, 1.2, 4), at(0, 8.4, -11), color)
	deco(parent, "TruckWindow", Vector3.new(7, 2.4, 0.2), at(0, 6.4, -14.8), Color3.fromRGB(40, 55, 80), Enum.Material.Glass, { Reflectance = 0.3 })
	deco(parent, "TruckGrille", Vector3.new(6, 2.2, 0.2), at(0, 2.8, -14.8), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
	deco(parent, "TruckBumper", Vector3.new(8.2, 0.9, 0.6), at(0, 1.5, -14.9), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	for _, x in ipairs({ -3, 3 }) do
		deco(parent, "TruckLight", Vector3.new(1.3, 0.8, 0.2), at(x, 2.9, -14.9), Color3.fromRGB(255, 250, 225), Enum.Material.Neon)
	end
	box(parent, "TruckBed", Vector3.new(8, 1, 18), at(0, 2, 2), Color3.fromRGB(60, 60, 66), Enum.Material.DiamondPlate)
	for _, z in ipairs({ -11.5, -2, 6.5 }) do
		for _, x in ipairs({ -3.7, 3.7 }) do
			local w = part({ Name = "TruckWheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 3, 3), CFrame = at(x, 1.5, z), Color = Color3.fromRGB(25, 25, 28), Material = Enum.Material.Rubber, CanCollide = false }, parent)
			w.Size = Vector3.new(1.2, 3, 3)
		end
	end
	local c = box(parent, "TruckContainer", Vector3.new(7.6, 7, 16), at(0, 6, 2.5), Color3.fromRGB(200, 120, 50), Enum.Material.DiamondPlate)
	surfaceText(c, Enum.NormalId.Left, "D2D LOGISTICS", Color3.new(1, 1, 1), 20)
	surfaceText(c, Enum.NormalId.Right, "D2D LOGISTICS", Color3.new(1, 1, 1), 20)
end

---------------------------------------------------------------------
-- Light and sky
---------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 13.6
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 112, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 152, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ExposureCompensation = 0
	Lighting.ShadowSoftness = 0.2
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") then
			c:Destroy()
		end
	end
	local a = Instance.new("Atmosphere")
	a.Density = 0.22
	a.Offset = 0.15
	a.Color = Color3.fromRGB(205, 225, 255)
	a.Decay = Color3.fromRGB(140, 165, 210)
	a.Glare = 0.1
	a.Haze = 0.6
	a.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 20
	bloom.Threshold = 2.5
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.1
	cc.Contrast = 0.06
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.04
	rays.Spread = 0.5
	rays.Parent = Lighting
end

---------------------------------------------------------------------
-- Terrain: grass ground and terraced blue-grey cliffs all around
---------------------------------------------------------------------
local function buildTerrain()
	local terrain = workspace.Terrain
	terrain:Clear()
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(106, 170, 76))
	terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(96, 160, 70))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(118, 128, 152))
	terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(110, 120, 145))
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(120, 100, 75))
	pcall(function()
		terrain.Decoration = true -- little grass blades
	end)
	-- the ground: terrain surfaces sit about 2 studs above a filled block, so fill to y = -2 to get ground at y = 0
	terrain:FillBlock(CFrame.new(0, -6, 0), Vector3.new(1600, 8, 1200), Enum.Material.Grass)

	-- terraces: each step is rock with a grass top
	local function step(center, size)
		terrain:FillBlock(CFrame.new(center), size, Enum.Material.Rock)
		local top = center + Vector3.new(0, size.Y / 2 + 2, 0)
		terrain:FillBlock(CFrame.new(top), Vector3.new(size.X, 4, size.Z), Enum.Material.Grass)
	end
	-- behind the yards
	step(Vector3.new(0, 10, 150), Vector3.new(1200, 20, 40))
	step(Vector3.new(0, 22, 185), Vector3.new(1200, 44, 40))
	step(Vector3.new(0, 34, 230), Vector3.new(1300, 68, 60))
	-- across the road
	step(Vector3.new(0, 8, -175), Vector3.new(1200, 16, 30))
	step(Vector3.new(0, 18, -205), Vector3.new(1200, 36, 40))
	step(Vector3.new(0, 30, -250), Vector3.new(1300, 60, 60))
	-- left and right ends
	for _, sx in ipairs({ -1, 1 }) do
		step(Vector3.new(sx * 440, 10, -20), Vector3.new(40, 20, 420))
		step(Vector3.new(sx * 475, 24, -20), Vector3.new(40, 48, 460))
		step(Vector3.new(sx * 520, 36, -20), Vector3.new(60, 72, 520))
	end

	-- clouds
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

---------------------------------------------------------------------
-- Street and scenery
---------------------------------------------------------------------
local function buildWorld(map)
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	buildTerrain()
	box(map, "Road", Vector3.new(840, 0.4, 26), CFrame.new(0, 0.2, -108), ASPHALT, Enum.Material.Asphalt)
	for x = -410, 410, 16 do
		deco(map, "RoadLine", Vector3.new(7, 0.05, 0.5), CFrame.new(x, 0.42, -108), Color3.fromRGB(250, 250, 250))
	end
	for _, z in ipairs({ -95.4, -120.6 }) do
		deco(map, "EdgeLine", Vector3.new(840, 0.05, 0.4), CFrame.new(0, 0.42, z), Color3.fromRGB(250, 250, 250))
	end
	box(map, "Sidewalk", Vector3.new(840, 0.8, 8), CFrame.new(0, 0.4, -91.5), CONCRETE, Enum.Material.Concrete)
	box(map, "FarSidewalk", Vector3.new(840, 0.8, 8), CFrame.new(0, 0.4, -125), CONCRETE, Enum.Material.Concrete)
	for x = -416, 416, 8 do
		deco(map, "SidewalkJoint", Vector3.new(0.15, 0.05, 8), CFrame.new(x, 0.81, -91.5), GROUT)
		deco(map, "SidewalkJoint", Vector3.new(0.15, 0.05, 8), CFrame.new(x, 0.81, -125), GROUT)
	end
	for i = 1, Config.MaxPlots - 1 do
		local x = -((Config.MaxPlots - 1) * PLOT_SPACING) / 2 + (i - 0.5) * PLOT_SPACING
		for s = -6, 6, 2 do
			deco(map, "Crosswalk", Vector3.new(1.2, 0.05, 18), CFrame.new(x + s, 0.42, -108), Color3.fromRGB(250, 250, 250))
		end
	end
	for x = -385, 385, 55 do
		streetLamp(map, Vector3.new(x, 0.8, -95), -1)
		streetLamp(map, Vector3.new(x + 27, 0.8, -121.5), 1)
	end
	-- trees along the far sidewalk and behind the yards
	for x = -400, 400, 16 do
		lowPolyTree(map, Vector3.new(x + rng:NextNumber(-3, 3), 0, -137 - rng:NextNumber(0, 10)), rng:NextNumber(0.9, 1.25))
	end
	for x = -400, 400, 14 do
		lowPolyTree(map, Vector3.new(x + rng:NextNumber(-3, 3), 0, 104 + rng:NextNumber(0, 18)), rng:NextNumber(1, 1.4))
	end
	for _, sx in ipairs({ -1, 1 }) do
		for z = -90, 90, 14 do
			lowPolyTree(map, Vector3.new(sx * (395 + rng:NextNumber(0, 15)), 0, z), rng:NextNumber(1, 1.3))
		end
	end
	-- invisible walls around the play area
	for _, w in ipairs({
		{ Vector3.new(4, 80, 260), Vector3.new(-380, 40, -20) },
		{ Vector3.new(4, 80, 260), Vector3.new(380, 40, -20) },
		{ Vector3.new(760, 80, 4), Vector3.new(0, 40, -131) },
		{ Vector3.new(760, 80, 4), Vector3.new(0, 40, 100) },
	}) do
		box(map, "Boundary", w[1], CFrame.new(w[2]), Color3.new(1, 1, 1), nil, { Transparency = 1, CanQuery = false })
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.5, -100)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = map
end

---------------------------------------------------------------------
-- One plot
---------------------------------------------------------------------
local function buildPlot(index, parent)
	local cx = -((Config.MaxPlots - 1) * PLOT_SPACING) / 2 + (index - 1) * PLOT_SPACING
	local m = Instance.new("Model")
	m.Name = "Plot" .. index
	m.Parent = parent
	local function at(x, y, z)
		return CFrame.new(cx + x, y, z)
	end
	local function v(x, y, z)
		return Vector3.new(cx + x, y, z)
	end

	-- grass strip, hedge and trees between plots
	for _, side in ipairs(index == 1 and { -1, 1 } or { 1 }) do
		local hx = side * 55
		deco(m, "Hedge", Vector3.new(3, 3, 140), at(hx, 1.5, -12), Color3.fromRGB(78, 140, 62), Enum.Material.Grass)
		for z = -80, 64, 24 do
			lowPolyTree(m, v(hx + side * 5, 0, z + rng:NextNumber(-4, 4)), rng:NextNumber(0.9, 1.15))
		end
	end

	--=============== SHOWROOM (x -45..45, z -88..-8) ===============
	local TOP = 28 -- building height
	local CEIL = FLOOR_Y + 16 -- showroom ceiling
	box(m, "ShowroomFloor", Vector3.new(90, FLOOR_Y, 80), at(0, FLOOR_Y / 2, -48), TILE)
	-- floor tiles: grout lines every 8 studs and a darker border row
	for x = -40, 40, 8 do
		deco(m, "Grout", Vector3.new(0.18, 0.04, 80), at(x, FLOOR_Y + 0.02, -48), GROUT)
	end
	for z = -84, -12, 8 do
		deco(m, "Grout", Vector3.new(90, 0.04, 0.18), at(0, FLOOR_Y + 0.02, z), GROUT)
	end
	for _, z in ipairs({ -85, -11 }) do
		deco(m, "BorderTiles", Vector3.new(88, 0.03, 4), at(0, FLOOR_Y + 0.015, z), Color3.fromRGB(120, 128, 142))
	end

	-- outer walls: side walls, back wall with a doorway
	for _, x in ipairs({ -45, 45 }) do
		box(m, "Wall", Vector3.new(1.2, TOP - FLOOR_Y, 80), at(x, FLOOR_Y + (TOP - FLOOR_Y) / 2, -48), PLASTER, Enum.Material.Plaster)
		-- inside: pilasters every 16 studs and a navy baseboard
		local inward = x > 0 and -1 or 1
		for z = -80, -16, 16 do
			deco(m, "Pilaster", Vector3.new(1.4, 15.8, 2.2), at(x + inward * 0.9, FLOOR_Y + 7.9, z), PLASTER_SHADE, Enum.Material.Plaster)
		end
		deco(m, "Baseboard", Vector3.new(0.4, 0.8, 80), at(x + inward * 0.75, FLOOR_Y + 0.4, -48), NAVY)
		-- outside: a cornice band
		deco(m, "Cornice", Vector3.new(1.8, 1.2, 80.6), at(x, CEIL + 0.6, -48), PLASTER_SHADE, Enum.Material.Plaster)
	end
	for _, x in ipairs({ -26.5, 26.5 }) do
		box(m, "Wall", Vector3.new(37, TOP - FLOOR_Y, 1.2), at(x, FLOOR_Y + (TOP - FLOOR_Y) / 2, -8), PLASTER, Enum.Material.Plaster)
	end
	box(m, "Wall", Vector3.new(16, TOP - 13, 1.2), at(0, 13 + (TOP - 13) / 2, -8), PLASTER, Enum.Material.Plaster)
	-- doorway frame into the workshop
	for _, x in ipairs({ -8.3, 8.3 }) do
		deco(m, "DoorFrame", Vector3.new(0.7, 12, 1.6), at(x, FLOOR_Y + 6, -8), NAVY)
	end
	deco(m, "DoorFrame", Vector3.new(17.3, 0.7, 1.6), at(0, 13, -8), NAVY)
	local serviceSign = deco(m, "ServiceSign", Vector3.new(10, 1.8, 0.2), at(0, 14.6, -8.7), NAVY)
	surfaceText(serviceSign, Enum.NormalId.Front, "WORKSHOP", GOLD)

	-- the front facade: plinth, pilasters, big windows, cornices, parapet
	local FZ = -88
	box(m, "Plinth", Vector3.new(91, 1.2, 1.6), at(0, FLOOR_Y + 0.6, FZ), STONE, Enum.Material.Concrete)
	for _, x in ipairs({ -44.6, -27, -9, 9, 27, 44.6 }) do
		box(m, "Pilaster", Vector3.new(2.4, TOP - FLOOR_Y, 1.8), at(x, FLOOR_Y + (TOP - FLOOR_Y) / 2, FZ), PLASTER, Enum.Material.Plaster)
		deco(m, "PilasterCap", Vector3.new(3, 0.8, 2.3), at(x, CEIL - 0.4, FZ), PLASTER_SHADE, Enum.Material.Plaster)
	end
	local bays = { { -35.8, 15.2 }, { -18, 15.6 }, { 18, 15.6 }, { 35.8, 15.2 } }
	for _, b in ipairs(bays) do
		-- ground floor: tall shop window
		box(m, "Sill", Vector3.new(b[2], 1, 1.2), at(b[1], FLOOR_Y + 1.7, FZ), PLASTER, Enum.Material.Plaster)
		window(m, at(b[1], FLOOR_Y + 8.3, FZ), b[2] - 0.4, 12.2, 3, 2, 0.55)
		box(m, "Lintel", Vector3.new(b[2], CEIL - (FLOOR_Y + 14.4), 1.2), at(b[1], (CEIL + FLOOR_Y + 14.4) / 2, FZ), PLASTER, Enum.Material.Plaster)
		-- upper floor: smaller dark windows
		window(m, at(b[1], CEIL + 5.3, FZ), b[2] - 3, 6.4, 3, 1, 0.12, Color3.fromRGB(70, 95, 120))
	end
	-- infill walls on the upper floor between and around the windows
	box(m, "UpperWall", Vector3.new(90, TOP - CEIL, 1), at(0, CEIL + (TOP - CEIL) / 2, FZ + 0.7), PLASTER, Enum.Material.Plaster)
	-- cornices and parapet
	deco(m, "Cornice", Vector3.new(92, 1.4, 2.6), at(0, CEIL + 0.7, FZ - 0.2), PLASTER_SHADE, Enum.Material.Plaster)
	deco(m, "Cornice", Vector3.new(92.5, 1.2, 2.8), at(0, TOP - 0.6, FZ - 0.2), PLASTER_SHADE, Enum.Material.Plaster)
	box(m, "Roof", Vector3.new(91, 1, 81), at(0, TOP + 0.5, -48), Color3.fromRGB(70, 72, 80), Enum.Material.Concrete)
	for _, e in ipairs({ { 0, FZ, 92, 1.4 }, { 0, -8, 92, 1.4 }, { -45.3, -48, 1.4, 81 }, { 45.3, -48, 1.4, 81 } }) do
		deco(m, "RoofCap", Vector3.new(e[3], 0.9, e[4]), at(e[1], TOP + 1.3, e[2]), NAVY)
	end
	-- entrance: glass doors (open), transom, canopy with recessed lights
	window(m, at(0, FLOOR_Y + 13.3, FZ), 15.6, 2.4, 2, 1, 0.5)
	box(m, "EntranceLintel", Vector3.new(16, CEIL - (FLOOR_Y + 14.5), 1.2), at(0, (CEIL + FLOOR_Y + 14.5) / 2, FZ), PLASTER, Enum.Material.Plaster)
	for _, side in ipairs({ -1, 1 }) do
		local hinge = at(side * 7.9, FLOOR_Y + 6, FZ + 0.2)
		local leaf = hinge * CFrame.Angles(0, math.rad(side * 70), 0) * CFrame.new(-side * 3.9, 0, 0)
		deco(m, "DoorGlass", Vector3.new(7.6, 11.6, 0.2), leaf, GLASS, Enum.Material.Glass, { Transparency = 0.55, Reflectance = 0.2 })
		deco(m, "DoorFrame", Vector3.new(7.8, 0.4, 0.35), leaf * CFrame.new(0, 5.8, 0), NAVY)
		deco(m, "DoorFrame", Vector3.new(7.8, 0.4, 0.35), leaf * CFrame.new(0, -5.8, 0), NAVY)
		deco(m, "DoorHandle", Vector3.new(0.2, 3, 0.3), leaf * CFrame.new(side * 3.2, 0, -0.3), Color3.fromRGB(210, 210, 215), Enum.Material.Metal)
	end
	deco(m, "Canopy", Vector3.new(22, 1, 7.5), at(0, FLOOR_Y + 14.9, FZ - 3.6), NAVY)
	for _, x in ipairs({ -6, 0, 6 }) do
		local d = deco(m, "CanopyLight", Vector3.new(1.6, 0.1, 1.6), at(x, FLOOR_Y + 14.35, FZ - 4), LAMP, Enum.Material.Neon)
		if x == 0 then
			light(d, 16, 0.8)
		end
	end
	for _, x in ipairs({ -10.5, 10.5 }) do
		box(m, "CanopyPost", Vector3.new(0.8, 14.4, 0.8), at(x, FLOOR_Y + 7.2, FZ - 6.9), NAVY)
	end
	-- the name sign on the upper floor, in the middle bay
	local signBoard = box(m, "SignBoard", Vector3.new(16.6, 7.6, 0.6), at(0, CEIL + 5.3, FZ - 0.4), NAVY)
	deco(m, "SignTrim", Vector3.new(17.4, 8.4, 0.4), at(0, CEIL + 5.3, FZ - 0.25), GOLD, Enum.Material.Metal)
	local signLabel = surfaceText(signBoard, Enum.NormalId.Front, "FOR SALE", GOLD, 24)
	signBoard.CFrame = at(0, CEIL + 5.3, FZ - 0.5)
	-- front steps, planters, bollards
	box(m, "Step", Vector3.new(26, 0.4, 3), at(0, 0.9, FZ - 1.8), CONCRETE, Enum.Material.Concrete)
	for _, x in ipairs({ -35.8, -18, 18, 35.8 }) do
		planter(m, at(x, 0.8, FZ - 2.4), 12, true)
	end

	-- inside: wood ceiling with white coffer beams and recessed lights
	box(m, "Ceiling", Vector3.new(89, 1, 79), at(0, CEIL + 0.5, -48), WOOD, Enum.Material.WoodPlanks)
	for x = -40, 40, 16 do
		deco(m, "CofferBeam", Vector3.new(1.2, 1.2, 79), at(x, CEIL - 0.6, -48), PLASTER)
	end
	for z = -80, -16, 16 do
		deco(m, "CofferBeam", Vector3.new(89, 1.2, 1.2), at(0, CEIL - 0.6, z), PLASTER)
	end
	local lightIndex = 0
	for x = -32, 32, 16 do
		for z = -72, -24, 16 do
			lightIndex = lightIndex + 1
			local d = deco(m, "RecessedLight", Vector3.new(2.4, 0.1, 2.4), at(x, CEIL - 0.05, z), LAMP, Enum.Material.Neon)
			if lightIndex % 3 == 1 then
				light(d, 30, 0.4)
			end
		end
	end
	-- track lights along the walls
	for _, x in ipairs({ -40, 40 }) do
		deco(m, "Track", Vector3.new(0.4, 0.3, 70), at(x, CEIL - 0.2, -48), NAVY)
		for z = -78, -18, 10 do
			local spot = deco(m, "TrackSpot", Vector3.new(0.7, 1.1, 0.7), at(x, CEIL - 0.9, z) * CFrame.Angles(0, 0, math.rad(x > 0 and 25 or -25)), NAVY, Enum.Material.Metal)
			deco(m, "TrackBulb", Vector3.new(0.5, 0.1, 0.5), spot.CFrame * CFrame.new(0, -0.56, 0), LAMP, Enum.Material.Neon)
		end
	end
	-- reception desk, benches, plants
	box(m, "Desk", Vector3.new(9, 3.4, 2.6), at(30, FLOOR_Y + 1.7, -84.6), Color3.fromRGB(245, 245, 245))
	deco(m, "DeskTop", Vector3.new(9.4, 0.3, 3), at(30, FLOOR_Y + 3.55, -84.6), WOOD, Enum.Material.Wood)
	deco(m, "Monitor", Vector3.new(2.4, 1.6, 0.2), at(30, FLOOR_Y + 4.6, -84.2), Color3.fromRGB(25, 25, 30))
	deco(m, "Screen", Vector3.new(2.1, 1.3, 0.05), at(30, FLOOR_Y + 4.6, -84.32), Color3.fromRGB(150, 205, 255), Enum.Material.Neon)
	local logo = deco(m, "DeskLogo", Vector3.new(5, 1.4, 0.1), at(30, FLOOR_Y + 1.9, -85.95), NAVY)
	surfaceText(logo, Enum.NormalId.Front, "D2D MOTORS", GOLD, 30)
	for _, p in ipairs({ { -42, -85 }, { 42, -11 }, { -42, -11 }, { 20, -85 } }) do
		local pot = v(p[1], FLOOR_Y, p[2])
		column(m, "Pot", 2, 2.4, CFrame.new(pot + Vector3.new(0, 1, 0)), NAVY, nil, true)
		cypress(m, pot + Vector3.new(0, 1.4, 0), 4)
	end

	-- display podiums: 8 columns x 5 rows, filled from the front row, center outward
	local spots = {}
	local cols = { -5, 5, -15, 15, -25, 25, -35, 35 }
	local rows = { -74, -60, -46, -32, -18 }
	for _, z in ipairs(rows) do
		for _, x in ipairs(cols) do
			local pad = box(m, "Spot", Vector3.new(8.4, 0.35, 12.8), at(x, FLOOR_Y + 0.18, z), Color3.fromRGB(246, 246, 248), nil, { CanCollide = false, Reflectance = 0.05 })
			local trims = {}
			for _, e in ipairs({ { 0, -6.45, 8.6, 0.2 }, { 0, 6.45, 8.6, 0.2 }, { -4.25, 0, 0.2, 13 }, { 4.25, 0, 0.2, 13 } }) do
				table.insert(trims, deco(m, "SpotTrim", Vector3.new(e[3], 0.38, e[4]), at(x + e[1], FLOOR_Y + 0.19, z + e[2]), NAVY))
			end
			table.insert(spots, { Pad = pad, Trims = trims, CFrame = at(x, FLOOR_Y + 0.36, z), Front = at(x, FLOOR_Y, z - 10) })
		end
	end

	--=============== WORKSHOP (x -45..45, z -8..28) ===============
	local WTOP = FLOOR_Y + 13
	box(m, "WorkshopFloor", Vector3.new(90, FLOOR_Y, 36), at(0, FLOOR_Y / 2, 10), Color3.fromRGB(190, 192, 196), Enum.Material.Concrete)
	for _, x in ipairs({ -45, 45 }) do
		local inward = x > 0 and -1 or 1
		-- wall with a long window strip
		box(m, "Wall", Vector3.new(1.2, 4, 36), at(x, FLOOR_Y + 2, 10), PLASTER_SHADE, Enum.Material.Plaster)
		box(m, "Wall", Vector3.new(1.2, WTOP - (FLOOR_Y + 11), 36), at(x, (WTOP + FLOOR_Y + 11) / 2, 10), PLASTER, Enum.Material.Plaster)
		for _, z in ipairs({ -6.5, 26.5 }) do
			box(m, "Wall", Vector3.new(1.2, 7, 3), at(x, FLOOR_Y + 7.5, z), PLASTER, Enum.Material.Plaster)
		end
		window(m, at(x, FLOOR_Y + 7.5, 10) * CFrame.Angles(0, math.rad(90), 0), 30, 7, 5, 1, 0.45)
		deco(m, "Wainscot", Vector3.new(0.3, 4, 36), at(x + inward * 0.75, FLOOR_Y + 2, 10), Color3.fromRGB(150, 156, 168))
	end
	-- back wall into the yard with a big garage door opening
	for _, x in ipairs({ -36, 36 }) do
		box(m, "Wall", Vector3.new(18, WTOP - FLOOR_Y, 1.2), at(x, FLOOR_Y + (WTOP - FLOOR_Y) / 2, 28), PLASTER, Enum.Material.Plaster)
	end
	box(m, "Wall", Vector3.new(54, 3, 1.2), at(0, WTOP - 1.5, 28), PLASTER, Enum.Material.Plaster)
	local roll = part({ Name = "RollDoor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(54, 2.2, 2.2), CFrame = at(0, WTOP - 3.6, 27), Color = Color3.fromRGB(150, 155, 165), Material = Enum.Material.Metal, CanCollide = false, CanQuery = false }, m)
	roll.Size = Vector3.new(54, 2.2, 2.2)
	for _, x in ipairs({ -27.3, 27.3 }) do
		deco(m, "DoorRail", Vector3.new(0.6, WTOP - FLOOR_Y - 3, 0.8), at(x, FLOOR_Y + (WTOP - FLOOR_Y - 3) / 2, 28.6), NAVY)
	end
	local yardSign = deco(m, "YardSign", Vector3.new(12, 1.8, 0.2), at(0, WTOP - 1.5, 28.7), NAVY)
	surfaceText(yardSign, Enum.NormalId.Back, "BACKYARD", GOLD)
	-- roof and wood ceiling with hanging tube lights
	box(m, "Roof", Vector3.new(91, 1, 37), at(0, WTOP + 0.5, 10), Color3.fromRGB(70, 72, 80), Enum.Material.Concrete)
	deco(m, "Ceiling", Vector3.new(89, 0.4, 35), at(0, WTOP - 0.2, 10), WOOD, Enum.Material.WoodPlanks)
	for _, e in ipairs({ { 0, 28.4, 92, 1.2 }, { -45.3, 10, 1.2, 37 }, { 45.3, 10, 1.2, 37 } }) do
		deco(m, "RoofCap", Vector3.new(e[3], 0.9, e[4]), at(e[1], WTOP + 1.3, e[2]), NAVY)
	end
	for _, x in ipairs({ -30, -15, 0, 15, 30 }) do
		for _, z in ipairs({ 2, 18 }) do
			local tube = deco(m, "TubeLight", Vector3.new(7, 0.35, 0.7), at(x, WTOP - 2.2, z), LAMP, Enum.Material.Neon)
			deco(m, "TubeHousing", Vector3.new(7.3, 0.3, 1), at(x, WTOP - 1.9, z), Color3.fromRGB(220, 222, 228), Enum.Material.Metal)
			for _, w in ipairs({ -3, 3 }) do
				deco(m, "Wire", Vector3.new(0.08, 1.8, 0.08), at(x + w, WTOP - 1, z), Color3.fromRGB(40, 40, 45))
			end
			if x % 30 == 0 then
				light(tube, 26, 0.7)
			end
		end
	end
	-- pegboard with tools, shelves with boxes, a workbench
	deco(m, "Pegboard", Vector3.new(0.3, 5, 12), at(-44.2, FLOOR_Y + 8, 20), Color3.fromRGB(60, 65, 75))
	for i = 0, 5 do
		local z = 15 + i * 2
		deco(m, "Tool", Vector3.new(0.2, 1.8 + (i % 3) * 0.4, 0.25), at(-43.95, FLOOR_Y + 8, z), Color3.fromRGB(205, 205, 210), Enum.Material.Metal)
		deco(m, "ToolGrip", Vector3.new(0.25, 0.8, 0.35), at(-43.9, FLOOR_Y + 7.1 - (i % 3) * 0.2, z), i % 2 == 0 and Color3.fromRGB(220, 60, 50) or Color3.fromRGB(240, 190, 40))
	end
	for _, z in ipairs({ 6, 13 }) do
		for _, y in ipairs({ 0.8, 3.4, 6 }) do
			deco(m, "Shelf", Vector3.new(2.4, 0.2, 6), at(43, FLOOR_Y + y, z), Color3.fromRGB(110, 115, 125), Enum.Material.Metal)
		end
		for _, dz in ipairs({ -3, 3 }) do
			deco(m, "ShelfPost", Vector3.new(0.25, 6.6, 0.25), at(42, FLOOR_Y + 3.3, z + dz), NAVY)
			deco(m, "ShelfPost", Vector3.new(0.25, 6.6, 0.25), at(44, FLOOR_Y + 3.3, z + dz), NAVY)
		end
		cardboardBox(m, at(43, FLOOR_Y + 1.7, z - 1.3), 1.8)
		cardboardBox(m, at(43, FLOOR_Y + 1.6, z + 1.4), 1.6)
		cardboardBox(m, at(43, FLOOR_Y + 4.2, z), 1.9)
		cardboardBox(m, at(43, FLOOR_Y + 6.8, z + 1.2), 1.5)
	end
	box(m, "Workbench", Vector3.new(10, 0.5, 3), at(-28, FLOOR_Y + 3.2, -5.5), WOOD, Enum.Material.Wood)
	for _, x in ipairs({ -32.5, -23.5 }) do
		deco(m, "BenchLeg", Vector3.new(0.5, 3, 2.6), at(x, FLOOR_Y + 1.5, -5.5), NAVY, Enum.Material.Metal)
	end
	deco(m, "Vise", Vector3.new(1, 0.8, 1), at(-31, FLOOR_Y + 3.85, -5.5), Color3.fromRGB(60, 90, 160), Enum.Material.Metal)
	cardboardBox(m, at(-25, FLOOR_Y + 4.1, -5.6), 1.4)
	box(m, "ToolCabinet", Vector3.new(2.2, 4.4, 5), at(42.8, FLOOR_Y + 2.2, -2.5), Color3.fromRGB(205, 45, 45), nil, { Reflectance = 0.08 })
	for i = 0, 3 do
		deco(m, "Drawer", Vector3.new(0.1, 0.12, 4.4), at(41.65, FLOOR_Y + 1 + i, -2.5), Color3.fromRGB(225, 225, 230), Enum.Material.Metal)
	end
	for i = 1, 4 do
		local t = part({ Name = "Tire", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 2.6, 2.6), CFrame = at(-42.4, FLOOR_Y + i - 0.5, 5) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(28, 28, 30), Material = Enum.Material.Rubber, CanCollide = true }, m)
		t.Size = Vector3.new(0.9, 2.6, 2.6)
	end

	-- wash bay: tiled floor, drain, wash gantry with brushes
	local wash = box(m, "WashBay", Vector3.new(14, 0.12, 22), at(-15, FLOOR_Y + 0.06, 10), Color3.fromRGB(150, 200, 230), nil, { CanCollide = false })
	for x = -6, 6, 2 do
		deco(m, "WashGrout", Vector3.new(0.12, 0.13, 22), at(-15 + x, FLOOR_Y + 0.07, 10), Color3.fromRGB(110, 160, 200))
	end
	for z = -10, 10, 2 do
		deco(m, "WashGrout", Vector3.new(14, 0.13, 0.12), at(-15, FLOOR_Y + 0.07, 10 + z), Color3.fromRGB(110, 160, 200))
	end
	deco(m, "Drain", Vector3.new(1.4, 0.14, 12), at(-15, FLOOR_Y + 0.08, 10), Color3.fromRGB(70, 75, 85), Enum.Material.DiamondPlate)
	for _, x in ipairs({ -7.4, 7.4 }) do
		box(m, "GantryPost", Vector3.new(1, 10, 1.4), at(-15 + x, FLOOR_Y + 5, -0.5), Color3.fromRGB(240, 242, 246), Enum.Material.Metal)
		local brush = part({ Name = "Brush", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 2, 2), CFrame = at(-15 + x * 0.86, FLOOR_Y + 3.8, 1.6) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 120, 230), Material = Enum.Material.Fabric, CanCollide = false, CanQuery = false }, m)
		brush.Size = Vector3.new(7, 2, 2)
	end
	deco(m, "GantryTop", Vector3.new(16, 1.6, 1.8), at(-15, FLOOR_Y + 10.6, -0.5), Color3.fromRGB(240, 242, 246), Enum.Material.Metal)
	deco(m, "GantryStripe", Vector3.new(16.1, 0.5, 1.85), at(-15, FLOOR_Y + 10.3, -0.5), Color3.fromRGB(60, 120, 230))
	local washSign = deco(m, "WashSign", Vector3.new(9, 1.4, 0.2), at(-15, FLOOR_Y + 10.6, 0.5), Color3.fromRGB(60, 120, 230))
	surfaceText(washSign, Enum.NormalId.Back, "CAR WASH", Color3.new(1, 1, 1))
	local washLabel = label(wash, "WASH BAY", Color3.fromRGB(150, 220, 255), 9, 240)

	-- engine lift: two yellow posts with arms
	local lift = box(m, "EngineLift", Vector3.new(14, 0.12, 22), at(15, FLOOR_Y + 0.06, 10), Color3.fromRGB(120, 124, 132), Enum.Material.DiamondPlate, { CanCollide = false })
	for _, x in ipairs({ -7.4, 7.4 }) do
		box(m, "LiftPost", Vector3.new(1.4, 11, 1.6), at(15 + x, FLOOR_Y + 5.5, 10), Color3.fromRGB(250, 195, 40))
		deco(m, "LiftBase", Vector3.new(2.6, 0.4, 2.6), at(15 + x, FLOOR_Y + 0.2, 10), NAVY)
		for _, z in ipairs({ 6.5, 13.5 }) do
			deco(m, "LiftArm", Vector3.new(4.4, 0.35, 0.6), at(15 + x * 0.72, FLOOR_Y + 1.25, z), Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		end
	end
	deco(m, "LiftTop", Vector3.new(16.2, 0.9, 1.4), at(15, FLOOR_Y + 11.3, 10), Color3.fromRGB(250, 195, 40))
	for _, z in ipairs({ -1, 21 }) do
		deco(m, "HazardLine", Vector3.new(14, 0.13, 0.5), at(15, FLOOR_Y + 0.07, z), Color3.fromRGB(250, 195, 40))
	end
	local liftLabel = label(lift, "ENGINE LIFT", Color3.fromRGB(255, 215, 100), 10, 240)

	--=============== BACKYARD LOT (z 28..70) ===============
	box(m, "Yard", Vector3.new(90, 0.4, 42), at(0, 0.2, 49), ASPHALT, Enum.Material.Asphalt)
	local yardSlots = {}
	for _, z in ipairs({ 40, 59 }) do
		for _, x in ipairs({ -28, -14, 0, 14, 28 }) do
			table.insert(yardSlots, at(x, 0.4, z))
		end
		for _, x in ipairs({ -35, -21, -7, 7, 21, 35 }) do
			deco(m, "LotLine", Vector3.new(0.35, 0.05, 15), at(x, 0.42, z), Color3.fromRGB(245, 245, 245))
		end
	end
	-- curb and modern slat fence
	for _, x in ipairs({ -45, 45 }) do
		box(m, "Curb", Vector3.new(1, 0.8, 42), at(x, 0.4, 49), CONCRETE, Enum.Material.Concrete)
	end
	local function fenceRun(from, to)
		local dir = (to - from)
		local len = dir.Magnitude
		local mid = (from + to) / 2
		local cf = CFrame.lookAt(mid, mid + dir.Unit)
		for _, y in ipairs({ 1.4, 2.6, 3.8, 5 }) do
			box(m, "FenceSlat", Vector3.new(0.3, 0.7, len), cf * CFrame.new(0, y - mid.Y, 0), Color3.fromRGB(55, 62, 78))
		end
		local posts = math.floor(len / 7)
		for i = 0, posts do
			deco(m, "FencePost", Vector3.new(0.5, 6, 0.5), cf * CFrame.new(0, 3 - mid.Y, -len / 2 + i * len / posts), NAVY, Enum.Material.Metal)
		end
	end
	fenceRun(v(-45, 0, 28.6), v(-45, 0, 70))
	fenceRun(v(45, 0, 28.6), v(45, 0, 70))
	fenceRun(v(-45, 0, 70), v(-12, 0, 70))
	fenceRun(v(12, 0, 70), v(45, 0, 70))
	for _, x in ipairs({ -12, 12 }) do
		box(m, "GatePost", Vector3.new(1.2, 7, 1.2), at(x, 3.5, 70), NAVY)
	end
	for _, x in ipairs({ -40, -20, 20, 40 }) do
		box(m, "Bollard", Vector3.new(0.8, 2.4, 0.8), at(x, 1.2, 30), Color3.fromRGB(250, 200, 40))
	end
	-- the delivery truck waiting behind the gate
	box(m, "Driveway", Vector3.new(22, 0.3, 30), at(0, 0.15, 85), ASPHALT, Enum.Material.Asphalt)
	truck(m, at(0, 0, 86) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(230, 70, 60))

	-- upgrade pads: like Clean a Painting, a soft glowing pad on the floor
	local function pad(name, x, z, color, y)
		y = y or FLOOR_Y + 0.08
		local p = box(m, name, Vector3.new(6, 0.16, 6), at(x, y, z), color, Enum.Material.Neon, { CanCollide = false, Transparency = 0.2 })
		deco(m, name .. "Edge", Vector3.new(6.6, 0.12, 6.6), at(x, y - 0.03, z), Color3.fromRGB(255, 255, 255))
		local l = label(p, name, Color3.new(1, 1, 1), 4.5, 260, 60)
		return { Part = p, Label = l }
	end
	local pads = {
		Showroom = pad("Showroom", -36, 0, Color3.fromRGB(120, 230, 150)),
		Wash = pad("Wash Tools", -36, 20, Color3.fromRGB(120, 200, 255)),
		Engine = pad("Engine Luck", 36, 20, Color3.fromRGB(255, 200, 90)),
		Truck = pad("Truck", 36, 34, Color3.fromRGB(255, 130, 120), 0.48),
	}

	return {
		Index = index,
		CenterX = cx,
		Model = m,
		Spots = spots,
		WashCFrame = at(-15, FLOOR_Y + 0.12, 10),
		LiftCFrame = at(15, FLOOR_Y + 1.4, 10),
		WashLabel = washLabel,
		LiftLabel = liftLabel,
		YardSlots = yardSlots,
		Pads = pads,
		SignLabel = signLabel,
		SpawnCFrame = CFrame.lookAt(Vector3.new(cx, 4, 31), Vector3.new(cx, 4, 60)),
		DoorOutside = Vector3.new(cx, FLOOR_Y + 2.5, -96),
		DoorInside = Vector3.new(cx, FLOOR_Y + 2.5, -84),
	}
end

function MapBuilder.Build()
	buildLighting()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	buildWorld(map)
	local plots = {}
	for i = 1, Config.MaxPlots do
		plots[i] = buildPlot(i, map)
	end
	return { Folder = map, Plots = plots }
end

return MapBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000F"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000E"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000D"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- D2D client: HUD, delivery timer, wash view (scrubbing), engine view, Index and messages.
-- UI style: cream panels with brown borders, chunky colored buttons, icon buttons on the left.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local NotifyEvent = remotes:WaitForChild("Notify")
local ScrubEvent = remotes:WaitForChild("Scrub")
local RevealEvent = remotes:WaitForChild("Reveal")
local OpenEngineEvent = remotes:WaitForChild("OpenEngine")
local GoHomeEvent = remotes:WaitForChild("GoHome")
local EngineAction = remotes:WaitForChild("EngineAction")
local ClaimToken = remotes:WaitForChild("ClaimToken")

---------------------------------------------------------------------
-- Theme
---------------------------------------------------------------------
local CREAM = Color3.fromRGB(255, 244, 222)
local CREAM_DARK = Color3.fromRGB(246, 226, 190)
local BROWN = Color3.fromRGB(128, 82, 46)
local TEXT_DARK = Color3.fromRGB(92, 58, 32)
local GREEN_TEXT = Color3.fromRGB(40, 150, 60)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(25, 20, 18)
local GOLD = Color3.fromRGB(255, 205, 60)
local BTN = {
	Green = Color3.fromRGB(90, 200, 90),
	Orange = Color3.fromRGB(255, 150, 50),
	Red = Color3.fromRGB(240, 85, 75),
	Blue = Color3.fromRGB(80, 160, 255),
	Yellow = Color3.fromRGB(255, 205, 60),
	Cream = CREAM_DARK,
}

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = p
end
local function stroke(p, color, t)
	local s = Instance.new("UIStroke")
	s.Color = color or BLACK
	s.Thickness = t or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end
local function textStroke(l, t)
	local s = Instance.new("UIStroke")
	s.Color = BLACK
	s.Thickness = t or 2
	s.Parent = l
	return s
end
local function shine(p, amount)
	local g = Instance.new("UIGradient")
	local a = amount or 0.2
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1 - a, 1 - a, 1 - a))
	g.Rotation = 90
	g.Parent = p
	return g
end
-- outlined white text (for text over the 3D world)
local function text(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = WHITE
	l.TextScaled = true
	textStroke(l, props.StrokeThickness or 2)
	props.StrokeThickness = nil
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end
-- flat dark-brown text (for text on cream panels)
local function inkText(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = TEXT_DARK
	l.TextScaled = true
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function playSound(id, volume)
	if id == "" then
		return
	end
	local snd = Instance.new("Sound")
	snd.SoundId = id
	snd.Volume = volume or 0.5
	snd.Parent = SoundService
	SoundService:PlayLocalSound(snd)
	task.delay(3, function()
		snd:Destroy()
	end)
end
-- sound ids: fill these with sounds from the Creator Store (Toolbox > Audio) that the game may use
local SOUND_CLICK, SOUND_PING, SOUND_SWOOSH = "", "", ""

local function juicy(b)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local function to(v)
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = v }):Play()
	end
	b.MouseEnter:Connect(function()
		to(1.06)
	end)
	b.MouseLeave:Connect(function()
		to(1)
	end)
	b.MouseButton1Down:Connect(function()
		to(0.92)
	end)
	b.MouseButton1Up:Connect(function()
		to(1.06)
	end)
	b.Activated:Connect(function()
		playSound(SOUND_CLICK, 0.4)
	end)
end

-- chunky colored button with a dark outline, like the big buttons in Clean a Painting
local function button(parent, props, color)
	local b = Instance.new("TextButton")
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = WHITE
	b.TextScaled = true
	b.AutoButtonColor = false
	b.BackgroundColor3 = color or BTN.Green
	textStroke(b, 2)
	for k, v in pairs(props) do
		b[k] = v
	end
	corner(b, 14)
	stroke(b, BLACK, 3)
	shine(b, 0.22)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.18, 0)
	pad.PaddingBottom = UDim.new(0.18, 0)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = b
	juicy(b)
	b.Parent = parent
	return b
end

-- the little white key badge ("E", "Q") on a button
local function keyBadge(b, key)
	local k = Instance.new("TextLabel")
	k.AnchorPoint = Vector2.new(0, 0.5)
	k.Position = UDim2.new(0, -2, 0.5, 0)
	k.Size = UDim2.new(0, 34, 0, 34)
	k.BackgroundColor3 = WHITE
	k.Font = Enum.Font.FredokaOne
	k.TextScaled = true
	k.TextColor3 = BLACK
	k.Text = key
	corner(k, 8)
	stroke(k, BLACK, 2)
	k.Parent = b
	return k
end

-- cream panel with a brown border
local function panel(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = CREAM
	f.BorderSizePixel = 0
	for k, v in pairs(props) do
		f[k] = v
	end
	corner(f, 18)
	stroke(f, BROWN, 5)
	f.Parent = parent
	return f
end

local gui = Instance.new("ScreenGui")
gui.Name = "D2D"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

---------------------------------------------------------------------
-- HUD: cash and tokens (top left), delivery timer (top center), icon buttons (left)
---------------------------------------------------------------------
local hud = Instance.new("Frame")
hud.BackgroundTransparency = 1
hud.Size = UDim2.new(1, 0, 1, 0)
